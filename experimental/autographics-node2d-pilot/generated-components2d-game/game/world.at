fn game_cue(c int) {
 r_ord = r_ord + 1
 if r_np == 0 {
  r_p0 = c
 } else {
  if r_np == 1 {
   r_p1 = c
  }
 }
 if r_np < 2 {
  r_np = r_np + 1
 }
}
fn game_events() {
 r_gate = 0
 if r_state != 0 {
  return
 }
 let e = ag_event_next()
 if e == 0 {
  return
 }
 let p = ag_event_pair()
 if p == 0 {
