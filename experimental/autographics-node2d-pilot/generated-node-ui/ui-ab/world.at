 panel_ui_text_0[((1*64)+4)]=0x9B
 panel_ui_text_0[((1*64)+5)]=0xB6
 panel_ui_text_len_0[1]=6
 panel_ui_text_0[((2*64)+0)]=0xE5
 panel_ui_text_0[((2*64)+1)]=0xBC
 panel_ui_text_0[((2*64)+2)]=0x80
 panel_ui_text_len_0[2]=3
}
fn panel_ui_refresh(i int) {
 if i==0 {
  panel_ui_refresh_0()
 }
}
fn panel_ui_click_toggle(i int) {
 panel_toggle(i)
 panel_ui_refresh(i)
}
fn panel_ui_click_reset(i int) {
 let j=panel_bind_meter_INC[i]
 counter_inc(j)
 counter_ui_refresh(j)
 panel_ui_refresh(i)
}
