fn counter_ui_text_len(i int, e int) int {
 if i==0 {
  return counter_ui_text_len_0[e]
 }
 if i==1 {
  return counter_ui_text_len_1[e]
 }
 if i==2 {
  return counter_ui_text_len_2[e]
 }
 return 0
}
fn counter_ui_text_at(i int, e int, j int) int {
 if i==0 {
  return counter_ui_text_0[((e*64)+j)]
 }
 if i==1 {
  return counter_ui_text_1[((e*64)+j)]
 }
 if i==2 {
  return counter_ui_text_2[((e*64)+j)]
 }
 return 0
}
fn main_ui_text_len(i int, e int) int {
 if i==0 {
  return main_ui_text_len_0[e]
 }
 return 0
}
fn main_ui_text_at(i int, e int, j int) int {
 if i==0 {
  return main_ui_text_0[((e*64)+j)]
 }
 return 0
}
fn panel_ui_text_len(i int, e int) int {
 if i==0 {
  return panel_ui_text_len_0[e]
 }
 return 0
}
fn panel_ui_text_at(i int, e int, j int) int {
 if i==0 {
  return panel_ui_text_0[((e*64)+j)]
 }
 return 0
}
fn app_start() {
 main_lifestart()
 main_ui_refresh(0)
 counter_ui_refresh(0)
 counter_ui_refresh(1)
 panel_ui_refresh(0)
 counter_ui_refresh(2)
}
fn app_update(dt float) {
 main_ui_refresh(0)
 counter_ui_refresh(0)
 counter_ui_refresh(1)
 panel_ui_refresh(0)
 counter_ui_refresh(2)
}
