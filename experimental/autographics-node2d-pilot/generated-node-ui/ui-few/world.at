}
fn main_ui_text_len(i int, e int) int {
 if i==0 {
  return main_ui_text_len_0[e]
 }
 return 0
}
fn main_ui_text_at(i int, e int, j int) int {
 if i==0 {
  return main_ui_text_0[((e*64)+j)]
 }
 return 0
}
fn app_start() {
 main_ui_refresh(0)
 few1_ui_refresh(0)
 few1_ui_refresh(1)
 few2_ui_refresh(0)
 few2_ui_refresh(1)
}
fn app_update(dt float) {
 few1_lifetick(0,dt)
 few1_lifetick(1,dt)
 main_ui_refresh(0)
 few1_ui_refresh(0)
 few1_ui_refresh(1)
 few2_ui_refresh(0)
 few2_ui_refresh(1)
}
