// PLAN-024 components-3d g03 chain (author source): the original G03/3d
// hierarchy obligation rebuilt through view-3d — explicit group3d chain
// root(0.5,0,0) -> child(0.5,1,0), leaves deep(0.8,0,0) under child and
// leaf(0,0,0) under root, so deep world = (1.8, 1.0, 0.0). Behavior null.
use resources: g02_glb

node Main {
    view-3d {
        group3d root3d {
            position: (0.5, 0.0, 0.0)
            cylinder3d leaf {
                position: (0.0, 0.0, 0.0)
            }
            group3d child3d {
                position: (0.5, 1.0, 0.0)
                cylinder3d deep {
                    position: (0.8, 0.0, 0.0)
                }
            }
        }
    }
}
