// PLAN-024 components-3d g03 v-parent variant: root group x +2 (0.5 -> 2.5),
// so deep world x = 3.8. Same tree as g03 otherwise.
use resources: g02_glb

node Main {
    view-3d {
        group3d root3d {
            position: (2.5, 0.0, 0.0)
            cylinder3d leaf {
                position: (0.0, 0.0, 0.0)
            }
            group3d child3d {
                position: (0.5, 1.0, 0.0)
                cylinder3d deep {
                    position: (0.8, 0.0, 0.0)
                }
            }
        }
    }
}
