// PLAN-034 g10-textures-frozen: the frozen-control variant of the G10
// textures entry. Identical declarations/scene; both Life.Tick handlers only
// advance a counter and never write translation/visibility, so every tick
// keeps the initial static pose. The oracle requires this source to render
// differently from main at tick1 (frozen control distinguished).
use resources: platform, coin, flag, uv_probe

node Coin {
    model {
        var cx = 0.0
        var t = 0
    }
    view-3d {
        model3d coin {
            model: resources.coin
            position: (.cx, 0.0, 0.0)
            scale: (4.0, 4.0, 4.0)
        }
    }
    on {
        Life.Tick(dt) -> {
            .t = .t + 1
        }
    }
}

node Flag {
    model {
        var t = 0
        var fv = 1
    }
    view-3d {
        model3d banner {
            model: resources.flag
            position: (6.0, 0.0, 0.0)
            scale: (3.0, 3.0, 3.0)
            visible: .fv
        }
    }
    on {
        Life.Tick(dt) -> {
            .t = .t + 1
        }
    }
}

node Main {
    view-3d {
        model3d ground {
            model: resources.platform
            position: (-6.0, 0.0, 0.0)
            scale: (2.0, 2.0, 2.0)
        }
        Coin coin { }
        Flag flag { }
        model3d uv {
            model: resources.uv_probe
            position: (-5.0, 4.0, -4.0)
            scale: (1.5, 1.5, 1.5)
        }
    }
}
