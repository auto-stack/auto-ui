// PLAN-017 g11-2d fixture: the collectible component. Mesh/material are typed
// resource ports (per-instance appearance); target is a typed actor port;
// on_collect is a typed event port. Enter phase routes to .Touched; the
// handler guards on the actor and forwards the bound payload (per instance)
// to the parent receiver.
node Coin(position_x: float, position_y: float, mesh: Mesh2D, material: Material2D, target: ActorRef2D, on_collect: msg) {
    msg { Touched(ActorRef2D) }
    view-2d {
        trigger2d body {
            position: (.position_x, .position_y)
            on_enter: .Touched
        }
    }
    on {
        .Touched(actor) -> {
            if actor == .target {
                emit .on_collect
            }
        }
    }
}
