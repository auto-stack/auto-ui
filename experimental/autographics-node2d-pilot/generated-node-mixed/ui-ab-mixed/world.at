 }
 return 0
}
fn counter_ui_text_at(i int, e int, j int) int {
 if i==0 {
  if e<2 {return counter_ui_text_0[((e*64)+j)]}else{return counter_ui_text_b_0[(((e-2)*64)+j)]}
 }
 if i==1 {
  if e<2 {return counter_ui_text_1[((e*64)+j)]}else{return counter_ui_text_b_1[(((e-2)*64)+j)]}
 }
 return 0
}
