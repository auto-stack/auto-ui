use resources: atlas_img, ground_mesh, ground_color
use oob_sprite: OobSprite

node Main {
    view-2d {
        OobSprite hero {
            img: resources.atlas_img
        }
        solid2d floor {
            position: (15.0, -1.0)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
        camera2d cam {
            target: refs.hero.actor
            bounds: (0.0, -4.0, 30.0, 12.0)
            view_size: (12.0, 8.0)
        }
    }
}
