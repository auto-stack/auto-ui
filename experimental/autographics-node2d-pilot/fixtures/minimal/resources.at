// PLAN-016 minimal pilot: named procedural resource symbols.
// `auto.graphics` is the research services namespace (contract S2/S5):
// items bind to fixed AG primitive constructors, not file modules.
use auto.graphics: mesh2d, material2d

let ground_mesh = mesh2d.quad(40.0, 1.0)
let player_mesh = mesh2d.quad(0.8, 1.0)
let coin_mesh = mesh2d.circle(0.6)
let hazard_mesh = mesh2d.quad(1.0, 0.6)
let ground_color = material2d.color(0.45, 0.45, 0.5, 1.0)
let player_color = material2d.color(0.9, 0.5, 0.25, 1.0)
let coin_color = material2d.color(0.95, 0.8, 0.2, 1.0)
let hazard_color = material2d.color(0.85, 0.2, 0.2, 1.0)
