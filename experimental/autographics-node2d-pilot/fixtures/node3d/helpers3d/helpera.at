// PLAN-024 same-name-helpers fixture (module A): bump adds 1.0 per tick.
fn bump(v float) float {
    return v + 1.0
}

node Alpha(rate: float) {
    model {
        var acc = 0.0
    }
    view-3d {
        cylinder3d leaf {
            position: (.acc, 0.0, 0.0)
        }
    }
    on {
        Life.Tick(dt) -> {
            .acc = bump(.acc + .rate * dt)
        }
    }
}
