// The Player: local movement state and the one physical character binding.
// Movement advances only through the explicit `.Move(dt)` msg from the root
// schedule (no Life.Tick here — root tick + child tick would double-advance);
// a move tick reports back through the bound `moved_report` root event so
// the root event ladder can pick its 1-or-3 read shape. This is the exact
// 028 movement block re-hosted on a named-reference component.
node Player(speed: float, moved_report: msg) {
    model {
    }
    msg { Move(float) }
    view-3d {
        cylinder3d body {
            position: (3.0, 1.0, -3.0)
            scale: (0.4, 0.5, 0.4)
        }
    }
    character3d { }
    on {
        Life.Start -> {
            refs.body.place(3.0, 0.5, -3.0)
        }
        .Move(dt) -> {
            let hr = input.held(Right)
            if hr != 0 {
                refs.body.move3d(hr * camera3d.right_x() * .speed * dt, 0.0, hr * camera3d.right_z() * .speed * dt)
                emit .moved_report
            }
        }
    }
}
