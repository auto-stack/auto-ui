// PLAN-030 bg11-main: the original G11/3d round re-authored on the
// components-3d-bindings profile. Eight stateful nodes exactly (root +
// Player + three same-def Coins + Hazard + Goal + VoidTrap), named
// slot/template/pair symbols and one static ActorRef3D per component, no
// numeric slot/pair/scene IDs in author code. The root Life.Tick is the
// explicit author schedule: Player msg first (movement reports .Moved back),
// then the frozen 1-or-3 event ladder dispatching named pairs to component
// msgs, then the no-event Saw patrol commit (hy advances every tick), then
// the accepted-restart gate on the root result. Same original values as
// 028 g11-main (speed 2.0, Saw base 2.4 rate 0.05, collect x=8/10/12, Saw
// x=9 sphere 0.5, Beacon x=16, VoidZone z=-8, camera distance 8 pitch 45).
use player: Player
use coin: Coin
use extra: Hazard, Goal, VoidTrap
use props: ShardA, ShardB, ShardC, Saw, Beacon, VoidZone

node Main {
    model {
        var bag = 0
        var result = 0
        var moved = 0
    }
    msg { Moved
          Collected
          Failed
          Won }
    view-3d {
        cylinder3d ground {
            position: (15.0, -1.1, -3.0)
            scale: (40.0, 1.0, 2.0)
            solid: true
        }
        Player hero {
            speed: 2.0
            moved_report: .Moved
        }
        Coin ca {
            slot: objects3d.item_x
            template: templates.ShardA
            pair: triggers.shard_a
            target: refs.hero
            on_collected: .Collected
            px: 8.0
            py: 1.0
            pz: -3.0
        }
        Coin cb {
            slot: objects3d.item_b
            template: templates.ShardB
            pair: triggers.shard_b
            target: refs.hero
            on_collected: .Collected
            px: 10.0
            py: 1.0
            pz: -3.0
        }
        Coin cc {
            slot: objects3d.item_c
            template: templates.ShardC
            pair: triggers.shard_c
            target: refs.hero
            on_collected: .Collected
            px: 12.0
            py: 1.0
            pz: -3.0
        }
        Hazard hz {
            slot: objects3d.saw
            template: templates.Saw
            pair: triggers.hazard
            target: refs.hero
            on_hit: .Failed
            base_y: 2.4
            dir0: 0.05
        }
        Goal gl {
            slot: objects3d.beacon
            template: templates.Beacon
            pair: triggers.goal
            target: refs.hero
            on_win: .Won
        }
        VoidTrap vz {
            slot: objects3d.voidz
            template: templates.VoidZone
            pair: triggers.voidp
            target: refs.hero
            on_hit: .Failed
        }
    }
    camera3d { distance: 8.0
              pitch: 45.0
              projection: perspective }
    objects3d { item_a, item_b, item_c, saw, beacon, voidz }
    triggers { shard_a, shard_b, shard_c, hazard, goal, voidp }
    on {
        Life.Tick(dt) -> {
            .moved = 0
            if .result == 0 { hero.Move(dt) }
            let n = event.next()
            if n == 1 {
                let p = event.pair()
                if p == triggers.shard_a { ca.Collect() }
                if p == triggers.shard_b { cb.Collect() }
                if p == triggers.shard_c { cc.Collect() }
                if p == triggers.hazard { hz.Hit() }
                if p == triggers.goal { gl.Reached(.bag) }
                if p == triggers.voidp { vz.Entered() }
                if .moved == 0 {
                    let n1 = event.next()
                    if n1 == 1 {
                        let p1 = event.pair()
                        if p1 == triggers.shard_a { ca.Collect() }
                        if p1 == triggers.shard_b { cb.Collect() }
                        if p1 == triggers.shard_c { cc.Collect() }
                        if p1 == triggers.hazard { hz.Hit() }
                        if p1 == triggers.goal { gl.Reached(.bag) }
                        if p1 == triggers.voidp { vz.Entered() }
                        let n2 = event.next()
                        if n2 == 1 {
                            let p2 = event.pair()
                            if p2 == triggers.shard_a { ca.Collect() }
                            if p2 == triggers.shard_b { cb.Collect() }
                            if p2 == triggers.shard_c { cc.Collect() }
                            if p2 == triggers.hazard { hz.Hit() }
                            if p2 == triggers.goal { gl.Reached(.bag) }
                            if p2 == triggers.voidp { vz.Entered() }
                        }
                    }
                }
            }
            if n == 0 { hz.Commit() }
            hz.Advance()
            if .result != 0 {
                if input.pressed(Restart) == 1 {
                    round.request()
                }
            }
        }
        .Moved -> {
            .moved = 1
        }
        .Collected -> {
            .bag = .bag + 1
        }
        .Failed -> {
            .result = 2
        }
        .Won -> {
            .result = 1
        }
    }
}
