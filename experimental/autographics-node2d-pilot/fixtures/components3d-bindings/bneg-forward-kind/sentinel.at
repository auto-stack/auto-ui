// The Run character is a stationary sentinel: bound so the triggers3d/1
// assembly is well-formed, never moved, owns no business state (028 sensor
// parity).
node Sentinel {
    view-3d {
        cylinder3d body {
            position: (0.0, 0.5, -4.0)
            scale: (0.4, 0.5, 0.4)
        }
    }
    character3d { }
}
