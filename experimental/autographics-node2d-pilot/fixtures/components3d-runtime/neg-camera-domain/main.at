// PLAN-027 neg: camera distance outside the frozen [4,12] domain (the API
// faults 27 at Run time; the compiler names it at the declaration).
use character: Character

node Main {
    camera3d {
        distance: 3.0
        pitch: 45.0
        projection: perspective
    }
    view-3d {
        Character hero {
        }
        cylinder3d ground {
            position: (0.0, -0.5, 0.0)
            scale: (10.0, 0.5, 12.0)
            solid: true
        }
    }
}
