// PLAN-027 components-3d-runtime Beeper: same-def pair with independent
// local phase state; each instance emits its own anonymous .Pinged payload
// at Life.Start (020 receiver-isolation face on the runtime profile).
node Beeper(p0: float) {
    model {
        var phase = .p0
    }
    msg {
        Pinged(float)
    }
    view-3d {
        cylinder3d dot {
            position: (.phase, 1.5, 2.0)
        }
    }
    on {
        Life.Start -> {
            emit .Pinged(.p0)
        }
    }
}
