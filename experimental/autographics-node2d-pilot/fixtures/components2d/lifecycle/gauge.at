// PLAN-020 T-05 lifecycle Gauge: probe Gauge plus a Start counter, a parity0
// param (per-instance stagger of the recompute side: one charged move per
// tick across the pair), and a Life.Start handler. ticks is the per-instance
// Tick counter (exact with dispatched ticks; render-only frames never move
// it). hide_at -1 in this chain (the hide-charge question is budget/'s).
node Gauge(phase0: float, speed: float, base_x: float, base_y: float, hide_at: int, parity0: int, geo: Mesh2D, tint: Material2D) {
    model {
        var phase = .phase0
        var ticks = 0
        var count = 0
        var draw_x = .base_x
        var show = 1
        var parity = .parity0
        var starts = 0
    }
    msg {
        Add(int)
    }
    view-2d {
        shape2d disc {
            mesh: .geo
            position: (.draw_x, .base_y)
            material: .tint
            visible: .show
        }
    }
    on {
        Life.Start -> {
            .starts = .starts + 1
        }
        Life.Tick(dt) -> {
            .ticks = .ticks + 1
            .phase = .phase + .speed * dt
            if .parity == 0 {
                .draw_x = .base_x + .phase * 2.0 + .count * 0.2
                .parity = 1
            } else {
                .parity = 0
            }
            if .ticks == .hide_at {
                .show = 0
            }
        }
        .Add(n) -> {
            .count = .count + n
        }
    }
}
