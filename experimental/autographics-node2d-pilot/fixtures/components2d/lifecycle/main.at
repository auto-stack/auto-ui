// PLAN-020 T-05 lifecycle fixture (V-04): the probe chain plus Start/Tick
// counters on the root AND every component instance (root model adds
// starts/ticks with r_ scalars; each def carries model counters with
// getters), and Life.Start handlers that run exactly once per Run. The
// panel's Start also emits meter.Add(5) so "Start ran exactly once" is
// GPU-observable through the gauge's count-driven position. Gauges are
// parity-staggered: one charged gauge write per tick, player walk tick 30
// (+1 extra on the single hide tick would still fit) — pool <= 32.
use resources: gauge_blue, gauge_green, char_orange, ground_color, ground_mesh, disc_mesh, dot_mesh
use panel: Panel
use player: Player

node Main {
    model {
        var vy = 999
        var starts = 0
        var ticks = 0
    }
    view-2d {
        Panel a {
            period: 10
            payload: 1
            phase0: 0.0
            speed: 1.0
            base_x: 4.0
            hide_at: -1
            parity0: 0
            geo: resources.disc_mesh
            tint: resources.gauge_blue
        }
        Panel b {
            period: 15
            payload: 1
            phase0: 5.0
            speed: 6.0
            base_x: -4.0
            hide_at: -1
            parity0: 1
            geo: resources.dot_mesh
            tint: resources.gauge_green
        }
        Player player {
            px: 2.0
            py: 1.0
            tint: resources.char_orange
        }
        solid2d ground {
            position: (6.0, -0.5)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
        camera2d cam {
            target: refs.player.actor
            bounds: (0.0, -4.0, 40.0, 12.0)
            view_size: (40.0, 12.0)
        }
    }
    on {
        Life.Start -> {
            .starts = .starts + 1
        }
        Life.Tick(dt) -> {
            .ticks = .ticks + 1
        }
    }
}
