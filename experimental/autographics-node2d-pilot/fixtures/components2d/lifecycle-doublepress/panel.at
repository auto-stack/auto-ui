// PLAN-020 T-05 lifecycle-doublepress Panel: identical to lifecycle/panel.at
// minus the Start-time emit (the double-press chain keeps its Start surface
// minimal; the consumable-edge observation is CPU-side through p1/p2).
use gauge: Gauge

node Panel(period: int, payload: int, phase0: float, speed: float, base_x: float, hide_at: int, parity0: int, geo: Mesh2D, tint: Material2D) {
    model {
        var acc = 0
    }
    view-2d {
        Gauge meter {
            phase0: .phase0
            speed: .speed
            base_x: .base_x
            base_y: 3.0
            hide_at: .hide_at
            parity0: .parity0
            geo: .geo
            tint: .tint
        }
    }
    on {
        Life.Tick(dt) -> {
            .acc = .acc + 1
            if .acc == .period {
                .acc = 0
                meter.Add(.payload)
            }
        }
    }
}
