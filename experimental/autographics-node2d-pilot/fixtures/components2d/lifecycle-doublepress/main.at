// PLAN-020 T-05 lifecycle-doublepress fixture (V-05): the lifecycle chain
// (staggered parity gauges, hide_at -1, counting panels) with the Player
// swapped for the double-pressed-read variant. Only delta vs lifecycle/:
// the player module (input.pressed(Jump) read twice per tick).
use resources: gauge_blue, gauge_green, char_orange, ground_color, ground_mesh, disc_mesh, dot_mesh
use panel: Panel
use playerdp: Player

node Main {
    model {
        var vy = 999
    }
    view-2d {
        Panel a {
            period: 10
            payload: 1
            phase0: 0.0
            speed: 1.0
            base_x: 4.0
            hide_at: -1
            parity0: 0
            geo: resources.disc_mesh
            tint: resources.gauge_blue
        }
        Panel b {
            period: 15
            payload: 1
            phase0: 5.0
            speed: 6.0
            base_x: -4.0
            hide_at: -1
            parity0: 1
            geo: resources.dot_mesh
            tint: resources.gauge_green
        }
        Player player {
            px: 2.0
            py: 1.0
            tint: resources.char_orange
        }
        solid2d ground {
            position: (6.0, -0.5)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
        camera2d cam {
            target: refs.player.actor
            bounds: (0.0, -4.0, 40.0, 12.0)
            view_size: (40.0, 12.0)
        }
    }
}
