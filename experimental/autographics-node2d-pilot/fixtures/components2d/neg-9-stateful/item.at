// PLAN-020 negative (envelope part): a stateful Item (model + Life.Tick);
// each instance counts toward the 8-instance envelope.
use resources: gauge_blue

node Item {
    model {
        var acc = 0
    }
    view-2d {
        shape2d dot {
            kind: circle
            position: (0.0, 0.0)
            size: (0.5, 0.5)
            material: resources.gauge_blue
        }
    }
    on {
        Life.Tick(dt) -> {
            .acc = .acc + 1
        }
    }
}
