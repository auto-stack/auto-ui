// PLAN-020 negative: parameters are READ-ONLY (AC-02/06). The handler
// assigns `.speed = 3.0` — `.speed` is a declared param, not a model field.
// Must fail lowering with the named read-only diagnostic (module/line/
// symbol); model-field assignment (.ticks/.phase/...) stays legal.
node Gauge(phase0: float, speed: float, base_x: float, base_y: float, hide_at: int, parity0: int, geo: Mesh2D, tint: Material2D) {
    model {
        var phase = .phase0
        var ticks = 0
        var count = 0
        var draw_x = .base_x
        var show = 1
        var parity = .parity0
    }
    msg {
        Add(int)
    }
    view-2d {
        shape2d disc {
            mesh: .geo
            position: (.draw_x, .base_y)
            material: .tint
            visible: .show
        }
    }
    on {
        Life.Tick(dt) -> {
            .speed = 3.0
            .ticks = .ticks + 1
            .phase = .phase + .speed * dt
            if .parity == 0 {
                .draw_x = .base_x + .phase * 2.0 + .count * 0.2
                .parity = 1
            } else {
                .parity = 0
            }
            if .ticks == .hide_at {
                .show = 0
            }
        }
        .Add(n) -> {
            .count = .count + n
        }
    }
}
