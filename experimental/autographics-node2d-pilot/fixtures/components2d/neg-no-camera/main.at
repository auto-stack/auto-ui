// PLAN-020 negative: the components profile REQUIRES exactly one declared
// camera2d (Objects2V1 entry freezes camera state; absent camera faults 27).
// The otherwise-valid probe chain without the camera2d element must fail
// lowering with the named camera diagnostic.
use resources: gauge_blue, gauge_green, char_orange, ground_color, ground_mesh, disc_mesh, dot_mesh
use panel: Panel
use player: Player

node Main {
    model {
        var vy = 999
    }
    view-2d {
        Panel a {
            period: 10
            payload: 1
            phase0: 0.0
            speed: 1.0
            base_x: 4.0
            hide_at: 61
            geo: resources.disc_mesh
            tint: resources.gauge_blue
        }
        Panel b {
            period: 15
            payload: 1
            phase0: 5.0
            speed: 6.0
            base_x: -4.0
            hide_at: -1
            geo: resources.dot_mesh
            tint: resources.gauge_green
        }
        Player player {
            px: 2.0
            py: 1.0
            tint: resources.char_orange
        }
        solid2d ground {
            position: (6.0, -0.5)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
    }
}
