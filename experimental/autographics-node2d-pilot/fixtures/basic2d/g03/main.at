// PLAN-019 basic2d g03 base entry: the original two-group hierarchy. root(20,10)
// > child(10,-5); leaf circle (0,0) d12 under root, deep quad (5,0) 10 under
// child. Deep leaf world = (35,5); v-parent moves root x +20 -> (55,5);
// v-hidden sets root visible=false -> descendants invisible via ancestor AND.
use resources: leaf_red, deep_blue

node Main {
    view-2d {
        group2d root_2d {
            position: (20.0, 10.0)
            group2d child_2d {
                position: (10.0, -5.0)
                shape2d deep_quad {
                    kind: quad
                    position: (5.0, 0.0)
                    size: (10.0, 10.0)
                    material: resources.deep_blue
                }
            }
            shape2d leaf_circle {
                kind: circle
                position: (0.0, 0.0)
                size: (12.0, 12.0)
                material: resources.leaf_red
            }
        }
    }
}
