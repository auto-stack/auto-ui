// PLAN-028 g11-main: the original G11/3d round re-authored on the
// components-3d-events profile. Ground/Character are scene rows, the six
// runtime objects are typed spawns into the named slot pool, and the six
// trigger pairs are typed binds (subject = the character body leaf). The
// camera-relative walk, the 1-or-3 event ladder (one event on move ticks,
// up to three on idle ticks), the event-tick patrol-position skip and the
// accepted-restart request are all author Auto, exactly as in the original
// program (speed 2.0, Saw baseline 2.4 rate 0.05, collect x=8/10/12, Saw
// x=9 sphere 0.5, Beacon x=16, VoidZone z=-8, camera distance 8 pitch 45).
use character: Character
use props: ShardA, ShardB, ShardC, Saw, Beacon, VoidZone

node Main {
    view-3d {
        cylinder3d ground {
            position: (15.0, -1.1, -3.0)
            scale: (40.0, 1.0, 2.0)
        }
        Character hero { }
    }
    camera3d { distance: 8.0
              pitch: 45.0
              projection: perspective }
    objects3d { corner, tangent }
    triggers { corner_aabb, corner_sphere, tangent_sphere }
}
