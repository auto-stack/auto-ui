use resources: marker_mesh, marker_color
use resources: atlas_img

node Main {
    view-2d {
        shape2d spawn_template {
            position: (-30.0, -40.0)
            size: (0.8, 1.0)
            image: resources.marker_color
            frame: 0
            flip: 0
        }
        character2d body {
            position: (-40.0, -40.0)
            material: resources.marker_color
        }
        camera2d cam {
            target: refs.body.actor
            bounds: (0.0, -4.0, 30.0, 12.0)
            view_size: (12.0, 8.0)
        }
    }
}
