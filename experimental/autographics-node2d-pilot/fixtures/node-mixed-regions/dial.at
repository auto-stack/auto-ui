// PLAN-054 T-05 fixture component: `Dial` — a cross-dimension component with
// a view-3d `ring` region (renamed counterpart of the probe's Meter/dial).
node Dial {
    model {
        var tx = 0
    }
    msg {
        Knob
    }
    view {
        view-3d ring {
            width: 70
            height: 70
            onclick: .Knob
            cylinder3d stem { translation: (.tx, 0, 0), color: (90, 200, 90) }
        }
    }
    on {
        .Knob -> {
            .tx = .tx + 3
        }
        Life.Tick -> {
            .tx = .tx + 1
        }
    }
}
