// PLAN-035 full-G3 HUD helpers: the author owns count and end-state text.
fn count_text(n int) str {
    if n == 0 {
        return "0/3"
    }
    if n == 1 {
        return "1/3"
    }
    if n == 2 {
        return "2/3"
    }
    return "3/3"
}

fn status_text(s int) str {
    if s == 1 {
        return "Won"
    }
    if s == 2 {
        return "Failed"
    }
    return "Playing"
}
