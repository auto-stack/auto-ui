// The two shard templates (respawn uses ShardB into the same slot).
node ShardA {
    object3d { }
    view-3d { mob3d shard { position: (-30.0, 1.0, -3.0)
                            visible: false
                            scale: (0.5, 0.5, 0.5) } }
}
node ShardB {
    object3d { }
    view-3d { mob3d shard { position: (-30.0, 1.0, -3.0)
                            visible: false
                            scale: (0.6, 0.6, 0.6) } }
}
