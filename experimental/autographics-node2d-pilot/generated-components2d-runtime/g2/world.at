fn app_start() {
 ok=ok+ag_char_bind(1)*1.0
 ok=ok+ag_char_solid(2)*1.0
 ok=ok+ag_char_solid(3)*1.0
 ok=ok+ag_char_solid(4)*1.0
 ok=ok+ag_char_solid(5)*1.0
 ok=ok+ag_char_solid(6)*1.0
 ok=ok+ag_char_solid(7)*1.0
 ok=ok+ag_char_solid(8)*1.0
 ok=ok+ag_camera_follow_2d(1, 0.0, -4.0, 30.0, 12.0, 12.0, 8.0)*1.0
 coin_handle[0]=ag_object_spawn(0,9,coin_cx[0],coin_cy[0],0.0)
 coin_handle[1]=ag_object_spawn(1,10,coin_cx[1],coin_cy[1],0.0)
 coin_handle[2]=ag_object_spawn(2,11,coin_cx[2],coin_cy[2],0.0)
 enemy_handle[0]=ag_object_spawn(3,12,enemy_ex[0],enemy_ey[0],0.0)
 goal_handle[0]=ag_object_spawn(4,13,goal_gx[0],goal_gy[0],0.0)
 pit_handle[0]=ag_object_spawn(5,14,pit_tx[0],pit_ty[0],0.0)
// 6 presentation trigger binds (pair = authoring order; subject = the single character instance)
 ok=ok+ag_trigger_bind(0,1,1,coin_handle[0],1,0.5)*1.0
 ok=ok+ag_trigger_bind(1,1,1,coin_handle[1],1,0.5)*1.0
 ok=ok+ag_trigger_bind(2,1,1,coin_handle[2],1,0.5)*1.0
 ok=ok+ag_trigger_bind(3,1,1,enemy_handle[0],0,0.0)*1.0
 ok=ok+ag_trigger_bind(4,1,1,goal_handle[0],1,0.5)*1.0
 ok=ok+ag_trigger_bind(5,1,1,pit_handle[0],0,0.0)*1.0
}
fn app_update(dt float) {
 main_lifetick(dt)
 player_lifetick(0,dt)
 cmp_patrol(dt)
 cmp_restart()
 cmp_closeout()
}
// bounded four-row request buffer; the fifth pending request keeps the
// true count so the closeout bundle carries n=5 into the named fault 51
fn sfx_play(c int, g float) {
 r_ord = (r_ord + 1)
 if (r_np == 0) {
  r_p0 = c
 } else {
  if (r_np == 1) {
   r_p1 = c
  } else {
   if (r_np == 2) {
    r_p2 = c
   } else {
    if (r_np == 3) {
     r_p3 = c
    }
   }
  }
 }
 if (r_np < 5) {
  r_np = (r_np + 1)
 }
}
fn cmp_events() {
 let n = ag_events_snapshot()
 for i in 0..n {
  let p = ag_event_snap_pair(i)
  let ph = ag_event_snap_phase(i)
  if p == 0 {
   if coin_alive[0] == 1 {
    c1_hit(0, ph)
   }
  }
  if p == 1 {
   if coin_alive[1] == 1 {
    c2_hit(1, ph)
   }
  }
  if p == 2 {
   if coin_alive[2] == 1 {
    c3_hit(2, ph)
   }
  }
  if p == 3 {
   enemy_hit(0, ph)
  }
  if p == 4 {
   goal_hit(0, ph)
  }
  if p == 5 {
   pit_hit(0, ph)
  }
 }
}
fn cmp_patrol(dt float) {
 if (r_state == 0) {
  r_ex = (r_ex + ((r_edir * 1.0) * dt))
  if (r_ex > 17.0) {
   r_edir = -1
  }
  if (r_ex < 11.0) {
   r_edir = 1
  }
  ok=ok+ag_object_move(enemy_handle[0], r_ex, 0.5, 0.0)*1.0
 }
}
fn cmp_restart() {
 if (r_state != 0) {
  if (((r_snap / 512) % 2) == 1) {
   ok=ok+ag_round_request()*1.0
  }
 }
}
