fn player_lifetick(i int, dt float) {
 let snap = r_snap
 let held = (snap - ((snap / 64) * 64))
 let pr = (snap / 64)
 let jp = ((pr / 4) - ((pr / 8) * 2))
 let hl = (held - ((held / 2) * 2))
 let hr = ((held / 2) - ((held / 4) * 2))
 let axis = (hr - hl)
 if (jp == 1) {
  if (player_grounded[i] == 1) {
   player_vy[i] = 8.0
   sfx_play(3, 1.0)
  }
 }
 player_vy[i] = (player_vy[i] - (20.0 * dt))
 let dx = ((axis * 4.0) * dt)
 let q = ag_char_move(dx, (player_vy[i] * dt), 0.002)
 player_grounded[i] = ag_char_grounded(q)
 if (player_grounded[i] == 1) {
  player_vy[i] = 0.0
 }
 if (axis > 0) {
  player_facing[i] = 1
 }
 if (axis < 0) {
  player_facing[i] = (-1)
 }
 if (player_grounded[i] == 1) {
  if (axis != 0) {
   player_pose[i] = 1
  } else {
   player_pose[i] = 0
  }
 } else {
  if (player_vy[i] > 0.0) {
   player_pose[i] = 2
  } else {
   player_pose[i] = 3
  }
 }
}
