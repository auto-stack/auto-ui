// PLAN-020 T-05 lifecycle Player: probe walk-jump rules plus starts/ticks
// counters and a Life.Start handler (one Start per Run — the frozen Resume
// contract says a resumed Run must NOT re-run Start).
node Player(px: float, py: float, tint: Material2D) {
    model {
        var vy = 0.0
        var grounded = 0
        var starts = 0
        var ticks = 0
    }
    view-2d {
        character2d body {
            position: (px, py)
            material: tint
        }
    }
    on {
        Life.Start -> {
            .starts = .starts + 1
        }
        Life.Tick(dt) -> {
            .ticks = .ticks + 1
            let jp = input.pressed(Jump)
            if jp == 1 {
                if .grounded == 1 {
                    .vy = 8.0
                }
            }
            .vy = .vy - 20.0 * dt
            let axis = input.axis(Left, Right)
            let dx = axis * 4.0 * dt
            let q = refs.body.move_and_slide((dx, .vy * dt))
            .grounded = refs.body.grounded(q)
            if .grounded == 1 {
                .vy = 0.0
            }
        }
    }
}
