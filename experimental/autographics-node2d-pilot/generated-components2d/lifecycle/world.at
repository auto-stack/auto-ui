 gauge_starts[i] = (gauge_starts[i] + 1)
}
fn meter_add(j int, n int) {
 gauge_count[j] = (gauge_count[j] + n)
}
fn gauge_present(i int) {
 if ((((gauge_px[i]-gauge_draw_x[i])*(gauge_px[i]-gauge_draw_x[i]))+((gauge_py[i]-gauge_base_y[i])*(gauge_py[i]-gauge_base_y[i])))>0.0) {
  gauge_px[i]=gauge_draw_x[i]
  gauge_py[i]=gauge_base_y[i]
  ag_object_move(gauge_handle[i],gauge_draw_x[i],gauge_base_y[i],0.0)
 }
 if gauge_vis[i]!=gauge_show[i] {
  gauge_vis[i]=gauge_show[i]
  ag_object_visible(gauge_handle[i],gauge_show[i])
 }
}
fn player_lifetick(i int, dt float) {
 player_ticks[i] = (player_ticks[i] + 1)
 let jp = ag_action_pressed(2)
 if (jp == 1) {
  if (player_grounded[i] == 1) {
   player_vy[i] = 8.0
  }
 }
 player_vy[i] = (player_vy[i] - (20.0 * dt))
 let axis = (ag_action_held(1) - ag_action_held(0))
 let dx = ((axis * 4.0) * dt)
 let q = ag_char_move(dx, (player_vy[i] * dt), 0.002)
 player_grounded[i] = ag_char_grounded(q)
 if (player_grounded[i] == 1) {
  player_vy[i] = 0.0
 }
}
fn player_lifestart(i int) {
