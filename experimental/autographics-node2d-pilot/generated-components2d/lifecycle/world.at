 }
}
fn panel_lifestart(i int) {
 panel_starts[i] = (panel_starts[i] + 1)
 meter_add(meter_bind_ADD[i], 5)
}
fn gauge_lifetick(i int, dt float) {
 gauge_ticks[i] = (gauge_ticks[i] + 1)
 gauge_phase[i] = (gauge_phase[i] + (gauge_speed[i] * dt))
 if (gauge_parity[i] == 0) {
  gauge_draw_x[i] = ((gauge_base_x[i] + (gauge_phase[i] * 2.0)) + (gauge_count[i] * 0.2))
  gauge_parity[i] = 1
 } else {
  gauge_parity[i] = 0
 }
 if (gauge_ticks[i] == gauge_hide_at[i]) {
  gauge_show[i] = 0
 }
}
