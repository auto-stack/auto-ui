fn app_start() {
 ok=ok+ag_char_bind(1)*1.0
 ok=ok+ag_char_solid(2)*1.0
 ok=ok+ag_camera_follow_2d(1, 0.0, -4.0, 40.0, 12.0, 40.0, 12.0)*1.0
 gauge_handle[0]=ag_object_spawn(0,3,gauge_draw_x[0],gauge_base_y[0],0.0)
 gauge_handle[1]=ag_object_spawn(1,4,gauge_draw_x[1],gauge_base_y[1],0.0)
 main_lifestart()
 panel_lifestart(0)
 gauge_lifestart(0)
 panel_lifestart(1)
 gauge_lifestart(1)
 player_lifestart(0)
}
