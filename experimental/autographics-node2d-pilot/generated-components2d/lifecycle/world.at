fn panel_lifetick(i int, dt float) {
 panel_ticks[i] = (panel_ticks[i] + 1)
 panel_acc[i] = (panel_acc[i] + 1)
 if (panel_acc[i] == panel_period[i]) {
  panel_acc[i] = 0
