// PLAN-020 T-05 budget fixture (V-05): the probe chain's player (walk tick
// = 30 charged credits: ag_char_move 26 = 1+24+1, pressed 1, held 2 via the
// differential axis, grounded 1) plus FOUR same-def Gauge instances whose
// recompute sides are staggered via parity0 (g1/g3 odd ticks, g2/g4 even
// ticks) so EVERY tick charges exactly two ag_object_move writes.
// Worst tick = 30 + 2 = 32 credits — exactly at the frozen shared pool, so
// the chain must run status 0 indefinitely (120 ticks asserted). The 9th
// envelope rule: root + player + 4 gauges = 6 stateful (<= 8).
use resources: gauge_blue, gauge_green, char_orange, ground_color, ground_mesh, disc_mesh, dot_mesh
use gauge: Gauge
use player: Player

node Main {
    model {
        var vy = 999
    }
    view-2d {
        Gauge g1 {
            phase0: 0.0
            speed: 1.0
            base_x: 4.0
            base_y: 3.0
            hide_at: -1
            parity0: 0
            geo: resources.disc_mesh
            tint: resources.gauge_blue
        }
        Gauge g2 {
            phase0: 5.0
            speed: 6.0
            base_x: -4.0
            base_y: 3.0
            hide_at: -1
            parity0: 1
            geo: resources.dot_mesh
            tint: resources.gauge_green
        }
        Gauge g3 {
            phase0: 2.0
            speed: 2.0
            base_x: 8.0
            base_y: 3.5
            hide_at: -1
            parity0: 0
            geo: resources.disc_mesh
            tint: resources.gauge_blue
        }
        Gauge g4 {
            phase0: 7.0
            speed: 3.0
            base_x: -8.0
            base_y: 3.5
            hide_at: -1
            parity0: 1
            geo: resources.dot_mesh
            tint: resources.gauge_green
        }
        Player player {
            px: 2.0
            py: 1.0
            tint: resources.char_orange
        }
        solid2d ground {
            position: (6.0, -0.5)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
        camera2d cam {
            target: refs.player.actor
            bounds: (0.0, -4.0, 40.0, 12.0)
            view_size: (40.0, 12.0)
        }
    }
}
