// PLAN-020 components-2d Panel definition: a counting parent. acc cycles to
// the per-instance period, then dispatches the typed int .Add event to ITS
// OWN meter child only (synchronous binding-table dispatch, T-02 measured
// 12/8 counts at T=120 for periods 10/15). Child-directed event syntax is
// the selector form `<child>.<Ev>(args)` (the Core body grammar accepts
// selector calls; `emit` prefix is only for the leading-dot self/ancestor
// form). Params forward to the child.
use gauge: Gauge

node Panel(period: int, payload: int, phase0: float, speed: float, base_x: float, hide_at: int, geo: Mesh2D, tint: Material2D) {
    model {
        var acc = 0
    }
    view-2d {
        Gauge meter {
            phase0: .phase0
            speed: .speed
            base_x: .base_x
            base_y: 3.0
            hide_at: .hide_at
            geo: .geo
            tint: .tint
        }
    }
    on {
        Life.Tick(dt) -> {
            .acc = .acc + 1
            if .acc == .period {
                .acc = 0
                meter.Add(.payload)
            }
        }
    }
}
