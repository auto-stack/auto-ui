// PLAN-027 components-3d-runtime events3d: two same-definition Beeper
// instances exercise the 020 local state/msg/event face under the runtime
// profile: typed .Pinged payloads land in separate root counters per
// instance (receiver isolation across same-def instances).
use beeper: Beeper

node Main {
    model {
        var lo = 0
        var hi = 0
    }
    msg {
        Pinged(float)
    }
    view-3d {
        cylinder3d pad {
            position: (0.0, -0.5, 0.0)
            scale: (10.0, 0.5, 12.0)
        }
        Beeper b0 {
            p0: 0.0
        }
        Beeper b1 {
            p0: 3.0
        }
    }
    on {
        Life.Start -> {}
        .Pinged(v) -> {
            if v > 2.0 {
                .hi = .hi + 1
            } else {
                .lo = .lo + 1
            }
        }
    }
}
