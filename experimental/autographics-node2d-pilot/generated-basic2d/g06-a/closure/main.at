// PLAN-019 basic2d g06 layout-a entry: original speed 4 / jump 8 / gravity 20
// with dt=1/60 owned by the run. The tick body is the original walk-jump
// logic: one Jump pressed edge consumed per dispatch, ground-only jump gate,
// gravity integrate, differential axis, one ag_char_move with clearance
// 0.002, grounded read from THAT move result. No camera (character-2d).
use resources: char_orange, ground_color, ground_mesh, wall_color, wall_mesh, step_color, step_mesh, block_mesh
use walkjump: Player

node Main {
    model {
        var speed = 4.0
        var jump = 8.0
        var gravity = 20.0
        var vy = 0.0
        var grounded = 0
    }
    view-2d {
        Player body {
            px: 0.0
            py: 1.0
            tint: resources.char_orange
        }
        solid2d ground {
            position: (6.0, -0.5)
            mesh: resources.ground_mesh
            material: resources.ground_color
        }
        solid2d wall {
            position: (14.5, 1.5)
            mesh: resources.wall_mesh
            material: resources.wall_color
        }
        solid2d step {
            position: (8.0, 0.375)
            mesh: resources.step_mesh
            material: resources.step_color
        }
        solid2d block {
            position: (-4.0, 0.5)
            mesh: resources.block_mesh
            material: resources.step_color
        }
    }
    on {
        Life.Tick(dt) -> {
            let jp = input.pressed(Jump)
            if jp == 1 {
                if .grounded == 1 {
                    .vy = .jump
                }
            }
            .vy = .vy - .gravity * dt
            let axis = input.axis(Left, Right)
            let dx = axis * .speed * dt
            let q = refs.body.move_and_slide((dx, .vy * dt))
            .grounded = refs.body.grounded(q)
            if .grounded == 1 {
                .vy = 0.0
            }
        }
    }
}
