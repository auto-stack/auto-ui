// PLAN-019 g03 v-parent variant: root group x 20 -> 40 (+20); the deep leaf
// world moves to (55,5) purely through the parent chain — no leaf/child edits.
use resources: leaf_red, deep_blue

node Main {
    view-2d {
        group2d root_2d {
            position: (40.0, 10.0)
            group2d child_2d {
                position: (10.0, -5.0)
                shape2d deep_quad {
                    kind: quad
                    position: (5.0, 0.0)
                    size: (10.0, 10.0)
                    material: resources.deep_blue
                }
            }
            shape2d leaf_circle {
                kind: circle
                position: (0.0, 0.0)
                size: (12.0, 12.0)
                material: resources.leaf_red
            }
        }
    }
}
