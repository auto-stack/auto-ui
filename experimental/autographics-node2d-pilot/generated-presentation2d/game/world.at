fn app_start() {
 ok=ok+ag_char_bind(1)*1.0
 ok=ok+ag_char_solid(2)*1.0
 ok=ok+ag_camera_follow_2d(1, 0.0, -8.0, 24.0, 8.0, 24.0, 16.0)*1.0
 coin_handle[0]=ag_object_spawn(0,3,coin_cx[0],coin_cy[0],0.0)
 coin_handle[1]=ag_object_spawn(1,4,coin_cx[1],coin_cy[1],0.0)
 coin_handle[2]=ag_object_spawn(2,5,coin_cx[2],coin_cy[2],0.0)
 zone_handle[0]=ag_object_spawn(3,6,zone_zx[0],zone_zy[0],0.0)
 zone_handle[1]=ag_object_spawn(4,7,zone_zx[1],zone_zy[1],0.0)
// 5 presentation trigger binds (pair = authoring order; subject = the single character instance)
 ok=ok+ag_trigger_bind(0,1,1,coin_handle[0],1,0.9)*1.0
 ok=ok+ag_trigger_bind(1,1,1,coin_handle[1],1,0.9)*1.0
 ok=ok+ag_trigger_bind(2,1,1,coin_handle[2],1,0.9)*1.0
 ok=ok+ag_trigger_bind(3,1,1,zone_handle[1],0,0.0)*1.0
 ok=ok+ag_trigger_bind(4,1,1,zone_handle[0],0,0.0)*1.0
}
fn app_update(dt float) {
 main_lifetick(dt)
 player_lifetick(0,dt)
 zone_lifetick(0,dt)
 zone_present(0)
 zone_lifetick(1,dt)
 zone_present(1)
 pres_closeout()
}
// ---- PLAN-025 presentation generated closeout (T-02 frozen skeleton)
fn sfx_play(c int, g float) {
 r_ord = r_ord + 1
 if r_np == 0 {
  r_o0 = r_ord
  r_c0 = c
  r_g0 = g
 }
 if r_np == 1 {
  r_o1 = r_ord
  r_c1 = c
  r_g1 = g
 }
 if r_np == 2 {
  r_o2 = r_ord
  r_c2 = c
  r_g2 = g
 }
 if r_np == 3 {
  r_o3 = r_ord
  r_c3 = c
  r_g3 = g
 }
 if r_np < 5 {
  r_np = r_np + 1
 }
}
fn pres_events() {
 let e = ag_event_next()
 if e == 0 {
  return
 }
 let p = ag_event_pair()
 let ph = ag_event_phase()
 if p == 0 {
  if coin_alive[0] == 1 {
   c1_hit(0, ph)
  }
  return
 }
 if p == 1 {
  if coin_alive[1] == 1 {
   c2_hit(1, ph)
  }
  return
 }
 if p == 2 {
  if coin_alive[2] == 1 {
   c3_hit(2, ph)
  }
  return
 }
 if p == 3 {
  hazard_hit(1, ph)
  return
 }
 if p == 4 {
  pad_hit(0, ph)
  return
 }
}
fn pres_closeout() {
 ok = ok + ag_present2d(-1, 0, 0, 0, 0, 0, 0, r_np, r_o0, r_c0, r_g0, r_o1, r_c1, r_g1, r_o2, r_c2, r_g2, r_o3, r_c3, r_g3, 1, hudmap_remaining_text(r_remaining), 1, statusmap_status_text(r_status), 0, "", 0, "") * 1.0
 r_np = 0
}
