fn main_lifestart() {
}
fn main_lifetick(dt float) {
 pres_events()
 if (r_busy == 1) {
  r_busy = 0
  player_idle(0, 1)
 }
}
fn main_doomed(ph int) {
 r_busy = 1
 if (r_status == 0) {
  r_status = 2
  sfx_play(2, 1.0)
 }
}
fn main_goaltry(ph int) {
 r_busy = 1
 if (r_status == 0) {
  if (r_remaining == 0) {
   if (ph == 1) {
    r_status = 1
    sfx_play(1, 1.0)
   }
  }
 }
}
fn main_picked(n int) {
 r_busy = 1
 r_remaining = (r_remaining - 1)
 sfx_play(0, 1.0)
}
