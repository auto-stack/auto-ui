fn player_lifetick(i int, dt float) {
 var jp = 0
 var axis = 0
 if (player_halt[i] == 1) {
  player_halt[i] = 0
 } else {
  jp = ag_action_pressed(2)
  axis = (ag_action_held(1) - ag_action_held(0))
 }
 if (jp == 1) {
  if (player_grounded[i] == 1) {
   player_vy[i] = 4.5
  }
 }
 player_vy[i] = (player_vy[i] - (12.0 * dt))
 let dx = ((axis * 2.5) * dt)
 let q = ag_char_move(dx, (player_vy[i] * dt), 0.002)
 player_grounded[i] = ag_char_grounded(q)
 if (player_grounded[i] == 1) {
  player_vy[i] = 0.0
 }
}
fn player_idle(j int, n int) {
 if (n == 1) {
  player_halt[j] = 1
 } else {
  player_halt[j] = 0
 }
}
fn zone_lifetick(i int, dt float) {
 zone_ticks[i] = (zone_ticks[i] + 1)
}
fn hazard_hit(j int, p int) {
 zone_ph[j] = 0
 if (p == 1) {
  zone_ph[j] = 1
 }
 if (p == 2) {
  zone_ph[j] = 2
 }
 if (p == 3) {
  zone_ph[j] = 3
 }
 if (zone_kind[j] == 1) {
  main_goaltry(zone_ph[j])
 } else {
  main_doomed(zone_ph[j])
 }
}
fn pad_hit(j int, p int) {
 zone_ph[j] = 0
 if (p == 1) {
  zone_ph[j] = 1
 }
 if (p == 2) {
  zone_ph[j] = 2
 }
 if (p == 3) {
  zone_ph[j] = 3
 }
 if (zone_kind[j] == 1) {
  main_goaltry(zone_ph[j])
 } else {
  main_doomed(zone_ph[j])
 }
}
fn zone_present(i int) {
 if zone_vis[i]!=zone_live[i] {
  zone_vis[i]=zone_live[i]
  ag_object_visible(zone_handle[i],zone_live[i])
 }
}
