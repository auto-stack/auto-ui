  if dimensions[ignore]!=space {_ag_fail(8,ignore,0); return 0}
 }
 let bx=ax+dx; let by=ay+dy; let bz=az+dz
 if space==2 {if az!=0.0 {_ag_fail(7,-1,2); return 0}; if bz!=0.0 {_ag_fail(7,-1,5); return 0}}
 if ax - ax != 0.0 {_ag_fail(12,-1,0); return 0}; if ay - ay != 0.0 {_ag_fail(12,-1,0); return 0}; if az - az != 0.0 {_ag_fail(12,-1,0); return 0}
 if bx - bx != 0.0 {_ag_fail(12,-1,0); return 0}; if by - by != 0.0 {_ag_fail(12,-1,0); return 0}; if bz - bz != 0.0 {_ag_fail(12,-1,0); return 0}
 if dx - dx != 0.0 {_ag_fail(12,-1,0); return 0}; if dy - dy != 0.0 {_ag_fail(12,-1,0); return 0}; if dz - dz != 0.0 {_ag_fail(12,-1,0); return 0}
 var negx=0; var signx=-1.0; if dx<0.0 {negx=1; signx=1.0};var n0=1;var f0=4;if negx==1 {n0=4;f0=1}
 var negy=0; var signy=-1.0; if dy<0.0 {negy=1; signy=1.0};var n1=2;var f1=5;if negy==1 {n1=5;f1=2}
 var negz=0; var signz=-1.0; if dz<0.0 {negz=1; signz=1.0};var n2=3;var f2=6;if negz==1 {n2=6;f2=3}
 if _ag_dirty==1 {_ag_derive(); _ag_dirty=0}
 var target=-1; var fraction=2.0;
 let validate=_ag_motion_checked==0
 let cw=worlds; let cb=_ag_spatial_boxes; let ck=kinds; let cd=dimensions; let cv=effective; let count=identities.len()
