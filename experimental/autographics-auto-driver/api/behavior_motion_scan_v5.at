fn _ag_motion_two(space int, ignore int, visible_only int, ax float, ay float, az float, dx float, dy float, dz float) int {
 if space!=2 {if space!=3 {_ag_fail(7,-1,0); return 0}}
 if visible_only!=0 {if visible_only!=1 {_ag_fail(7,-1,2); return 0}}
