 } else {fraction=1.0}
 _ag_sweep_overlap=0; if found==1 {if nxout==0.0 && nyout==0.0 && nzout==0.0 {_ag_sweep_overlap=1}}
 _ag_cast_found=found; _ag_cast_target=target; _ag_cast_fraction=fraction; _ag_cast_px=pxout; _ag_cast_py=pyout; _ag_cast_pz=pzout; _ag_cast_nx=nxout; _ag_cast_ny=nyout; _ag_cast_nz=nzout;
 return 1
}
