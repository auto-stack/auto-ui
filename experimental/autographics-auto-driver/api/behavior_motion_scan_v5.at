  } else {
   var near float=(loy - ay)/dy; var far float=(hiy - ay)/dy
   if (near - near) != (far - far) {_ag_fail(12,node,1); return 0}

   if near>enter {enter=near}
   if far<leave {leave=far}
   if enter>leave {continue}
