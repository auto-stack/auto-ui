// autographics.node_animation3d/1; visual-only state on triggers3d.
// One setter atomically chooses clip ordinal (-1=base), seconds, looping and
// yaw radians. kind 0 uses a stable document id; kind 1 uses a full object token.
// One shared callback credit. No Host gameplay or render-time phase advance.
var _ag_vis_frozen=0
var _ag_vis_ids=[]
var _ag_vis_nodes=[]
var _ag_vis_assets=[]
var _ag_vis_counts=[]
var _ag_vis_c=[]
var _ag_vis_p=[]
var _ag_vis_l=[]
var _ag_vis_y=[]
var _ag_vis_sc=[]
var _ag_vis_sp=[]
var _ag_vis_sl=[]
var _ag_vis_sy=[]
var _ag_vis_sg=[]
var _ag_vis_ops=0
fn _ag_vis_map(id int, node int, asset int, clips int) {
 if _ag_vis_frozen==1 {_ag_fail(11,node,0);return}
 if _ag_vis_ids.len()>=128 {_ag_fail(45,node,0);return}
 if id<1 {_ag_fail(45,node,id);return}
 if node<0 {_ag_fail(45,node,0);return}
 if node>=identities.len() {_ag_fail(45,node,0);return}
 if dimensions[node]!=3 {_ag_fail(45,node,0);return}
 if kinds[node]==5 {_ag_fail(45,node,0);return}
 if asset<0 {_ag_fail(45,node,0);return}
 if clips<0 {_ag_fail(45,node,0);return}
 if clips>16 {_ag_fail(45,node,0);return}
 for i in 0.._ag_vis_ids.len() {
  if _ag_vis_ids[i]==id {_ag_fail(45,node,0);return}
  if _ag_vis_nodes[i]==node {_ag_fail(45,node,0);return}
 }
 _ag_vis_ids.push(id);_ag_vis_nodes.push(node);_ag_vis_assets.push(asset);_ag_vis_counts.push(clips)
 _ag_vis_c.push(-1);_ag_vis_p.push(0.0);_ag_vis_l.push(0);_ag_vis_y.push(0.0)
}
fn _ag_vis_freeze() {
 if _ag_error!=0 {return}
 if _ag_vis_frozen==1 {return}
 for i in 0..8 {
  _ag_vis_sc.push(-1);_ag_vis_sp.push(0.0);_ag_vis_sl.push(0);_ag_vis_sy.push(0.0);_ag_vis_sg.push(0)
 }
 _ag_vis_frozen=1
}
fn _ag_vis_tick_begin() {_ag_vis_ops=0}
fn _ag_vis_find(id int) int {
 for i in 0.._ag_vis_ids.len() {if _ag_vis_ids[i]==id {return i}}
 return -1
}
fn _ag_vis_node(node int) int {
 for i in 0.._ag_vis_nodes.len() {if _ag_vis_nodes[i]==node {return i}}
 return -1
}
fn _ag_vis_refresh(s int) int {
 if _ag_obj_live[s]==0 {_ag_vis_sg[s]=0;return -1}
 let b=_ag_vis_node(_ag_obj_tmpl[s])
 if b<0 {_ag_vis_sg[s]=0;return -1}
 if _ag_vis_sg[s]!=_ag_obj_gen[s] {
  _ag_vis_sg[s]=_ag_obj_gen[s]
  _ag_vis_sc[s]= -1;_ag_vis_sp[s]=0.0;_ag_vis_sl[s]=0;_ag_vis_sy[s]=0.0
 }
 return b
}
fn ag_visual_pose(kind int, entity int, clip int, phase float, looping int, yaw float) int {
 if _ag_error!=0 {return 0}
 if _ag_vis_frozen==0 {_ag_fail(38,-1,0);return 0}
 var b= -1
 var s= -1
 if kind==0 {b=_ag_vis_find(entity)}
 if kind==1 {
  s=_ag_obj_slot_of(entity)
  if s<0 {return 0}
  b=_ag_vis_refresh(s)
 }
 if b<0 {_ag_fail(45,entity,kind);return 0}
 if clip< -1 {_ag_fail(46,entity,clip);return 0}
 if clip>=_ag_vis_counts[b] {_ag_fail(46,entity,clip);return 0}
 if phase - phase!=0.0 {_ag_fail(47,entity,0);return 0}
 if phase<0.0 {_ag_fail(47,entity,0);return 0}
 if looping!=0 {if looping!=1 {_ag_fail(47,entity,looping);return 0}}
 if yaw - yaw!=0.0 {_ag_fail(47,entity,0);return 0}
 if yaw>6433.98175455 {_ag_fail(47,entity,0);return 0}
 if yaw< -6433.98175455 {_ag_fail(47,entity,0);return 0}
 _ag_vis_ops=_ag_vis_ops+1
 if _ag_vis_ops>32 {_ag_fail(48,entity,_ag_vis_ops);return 0}
 if _ag_cast_charge(1)==0 {return 0}
 if s<0 {
  _ag_vis_c[b]=clip;_ag_vis_p[b]=phase;_ag_vis_l[b]=looping;_ag_vis_y[b]=yaw
 } else {
  _ag_vis_sg[s]=_ag_obj_gen[s]
  _ag_vis_sc[s]=clip;_ag_vis_sp[s]=phase;_ag_vis_sl[s]=looping;_ag_vis_sy[s]=yaw
 }
 return 1
}
fn _ag_vis_status() int {if _ag_vis_frozen==1 {if _ag_error==0 {return 1}};return 0}
fn _ag_vis_count() int {return _ag_vis_ids.len()}
fn _ag_vis_run() int {return _ag_run_id()}
fn _ag_vis_tick() int {return _ag_tick_id()}
// Static integer row: node, asset, clip, looping. Float row: phase,yaw.
fn _ag_vis_pi(i int, f int) int {
 if i<0 {return 0}
 if i>=_ag_vis_ids.len() {return 0}
 if f==0 {return _ag_vis_nodes[i]}
 if f==1 {return _ag_vis_assets[i]}
 if f==2 {return _ag_vis_c[i]}
 return _ag_vis_l[i]
}
fn _ag_vis_pf(i int, f int) float {
 if i<0 {return 0.0}
 if i>=_ag_vis_ids.len() {return 0.0}
 if f==0 {return _ag_vis_p[i]}
 return _ag_vis_y[i]
}
// Slot integer row: generation, asset, clip, looping. Free rows canonical zero.
fn _ag_vis_qi(i int, f int) int {
 if i<0 {return 0}
 if i>7 {return 0}
 let b=_ag_vis_refresh(i)
 if b<0 {return 0}
 if f==0 {return _ag_vis_sg[i]}
 if f==1 {return _ag_vis_assets[b]}
 if f==2 {return _ag_vis_sc[i]}
 return _ag_vis_sl[i]
}
fn _ag_vis_qf(i int, f int) float {
 if i<0 {return 0.0}
 if i>7 {return 0.0}
 if _ag_vis_refresh(i)<0 {return 0.0}
 if f==0 {return _ag_vis_sp[i]}
 return _ag_vis_sy[i]
}
