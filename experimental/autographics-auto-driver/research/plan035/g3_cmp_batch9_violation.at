// PLAN-035 T-03 named-rejection spike: ag_object_despawn_batch with n=9 is
// outside the frozen 0..8 length domain and must refuse with the named
// fault 59 before any handle validation or mutation.
var ok=0
var stepn=0
fn app_start(){
 ok=ag_char3_bind(1)
 ok=ag_camera_orbit_3d(1,8.0,45.0,0,0.0)
}
fn app_update(dt float){
 stepn=stepn+1
 let token=ag_char3_move(1.0*dt,0.0,0.0,0.002)
 let grounded=ag_char3_grounded(token)
 ok=ag_object_despawn_batch(9,1,2,3,4,5,6,7,8)
}
