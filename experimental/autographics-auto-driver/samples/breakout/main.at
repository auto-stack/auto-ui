// Frozen PLAN-829 arithmetic/order; all simulation executes in Auto.
var frames = 0
var bx = 0.0
var by = -50.0
var vx = 0.0
var vy = 0.0
var px = 0.0
var score = 0
var sounds = 0
var alive = []
var contacts = []
var gone = []
fn init() {
 frames = 0
 bx = 0.0; by = -50.0; px = 0.0; score = 0; sounds = 0
 var n float = 0.5 * 0.5 + -0.5 * -0.5
 var length float = 1.0
 var j = 0
 while j < 8 { length = (length + n / length) * 0.5; j = j + 1 }
 vx = (0.5 / length) * 400.0
 vy = (-0.5 / length) * 400.0
 alive = []; contacts = []; gone = []
 var i = 0
 while i < 56 { alive.push(1); i = i + 1 }
}
fn clamp(v float, lo float, hi float) float {
 if v < lo { return lo }; if v > hi { return hi }; return v
}
fn collide(cx float, cy float, hx float, hy float) int {
 var ox = bx - clamp(bx, cx - hx, cx + hx)
 var oy = by - clamp(by, cy - hy, cy + hy)
 if ox * ox + oy * oy > 15.0 * 15.0 { return -1 }
 var ax float = ox; var ay float = oy
 if ax < 0.0 { ax = -ax }; if ay < 0.0 { ay = -ay }
 if ax > ay { if ox < 0.0 { return 0 }; return 1 }
 if oy > 0.0 { return 2 }; return 3
}
fn reflect(side int) {
 if side == 0 && vx > 0.0 { vx = -vx }
 if side == 1 && vx < 0.0 { vx = -vx }
 if side == 2 && vy < 0.0 { vy = -vy }
 if side == 3 && vy > 0.0 { vy = -vy }
}
fn update(direction int) {
 frames = frames + 1
 var dt = 1.0 / 60.0
 bx = bx + vx * dt
 by = by + vy * dt
 px = clamp(px + direction * 500.0 * dt, -375.0, 375.0)
 contacts = []; gone = []
 var i = 0
 while i < 61 {
  var cx = 0.0; var cy = 0.0; var hx = 5.0; var hy = 305.0
  var enabled = true
  if i == 0 { cx = -450.0 }
  if i == 1 { cx = 450.0 }
  if i == 2 { cy = -300.0; hx = 455.0; hy = 5.0 }
  if i == 3 { cy = 300.0; hx = 455.0; hy = 5.0 }
  if i == 4 { cx = px; cy = -240.0; hx = 60.0; hy = 10.0 }
  if i >= 5 {
   var k = i - 5
   enabled = alive[k] == 1
   cx = -367.5 + (k % 8) * 105.0
   cy = 45.0 + (k / 8) * 35.0
   hx = 50.0; hy = 15.0
  }
  if enabled {
   var side = collide(cx,cy,hx,hy)
   if side >= 0 {
    contacts.push(i * 4 + side); sounds = sounds + 1
    if i >= 5 { alive[i - 5] = 0; score = score + 1; gone.push(i - 5) }
    reflect(side)
   }
  }
  i = i + 1
 }
}
fn value(i int) float {
 if i == 0 { return bx }; if i == 1 { return by }
 if i == 2 { return vx }; if i == 3 { return vy }; return px
}
fn integer(i int) int {
 if i == 0 { return score }; if i == 1 { return sounds }
 if i == 2 { return contacts.len() }; return gone.len()
}
fn brick(i int) int { return alive[i] }
fn contact(i int) int { return contacts[i] }
fn destroyed(i int) int { return gone[i] }

fn main() {}
fn protocol() int { return 1 }
fn object_count() int { return 62 }
fn object_alive(i int) int { if i >= 6 { return alive[i - 6] }; return 1 }
fn generation(i int) int { return 1 }
fn shape(i int) int { if i == 5 { return 0 }; return 1 }
fn field(i int, f int) float {
 var x = 0.0; var y = 0.0; var z = 0.0
 var sx = 10.0; var sy = 610.0; var sz = 1.0
 var r = 0.8; var g = 0.8; var b = 0.8
 if i == 0 { x = -450.0 }; if i == 1 { x = 450.0 }
 if i == 2 { y = -300.0; sx = 910.0; sy = 10.0 }
 if i == 3 { y = 300.0; sx = 910.0; sy = 10.0 }
 if i == 4 { x = px; y = -240.0; sx = 120.0; sy = 20.0; r = 0.3; g = 0.3; b = 0.7 }
 if i == 5 { x = bx; y = by; z = 1.0; sx = 30.0; sy = 30.0; r = 1.0; g = 0.5; b = 0.5 }
 if i >= 6 { var k = i - 6; x = -367.5 + (k % 8) * 105.0; y = 45.0 + (k / 8) * 35.0; sx = 100.0; sy = 30.0; r = 0.5; g = 0.5; b = 1.0 }
 if f == 0 { return x }; if f == 1 { return y }; if f == 2 { return z }
 if f == 3 { return sx }; if f == 4 { return sy }; if f == 5 { return sz }
 if f == 6 { return r }; if f == 7 { return g }; if f == 8 { return b }; return 1.0
}

fn pointer(x float, y float) { contacts = []; gone = [] }

fn key(code int) { contacts = []; gone = [] }

fn event_count() int { return contacts.len() * 2 + gone.len() }
fn event_kind(i int) int { if i < contacts.len() * 2 { return i % 2 }; return 2 }
fn event_a(i int) int {
 if i < contacts.len() * 2 { if i % 2 == 0 { return contacts[i / 2] / 4 }; return sounds - contacts.len() + i / 2 + 1 }
 return gone[i - contacts.len() * 2]
}
fn event_b(i int) int {
 if i < contacts.len() * 2 { if i % 2 == 0 { return contacts[i / 2] % 4 }; return 0 }
 return score - gone.len() + (i - contacts.len() * 2) + 1
}

fn changed(i int) int { if frames == 0 { return 1 }; if i == 4 || i == 5 { return 1 }; if i >= 6 { if alive[i - 6] == 0 { return 1 } }; return 0 }

fn background(i int) float { if i == 3 { return 1.0 }; return 0.9 }
