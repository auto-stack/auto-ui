// T-02 scratch: real Auto arithmetic, never a gameplay driver.
var state = 0.0
var serial = 0
fn accept_random(sequence int, value float) int {
 if sequence != serial + 1 { return 0 }
 if value < 0.0 || value >= 1.0 { return 0 }
 serial = sequence; state = value
 return 1
}
fn reset() { state = 0.0; serial = 0 }
fn value() float { return state }
fn count() int { return serial }
fn root(n float) float {
 if n == 0.0 { return 0.0 }
 var x float = 1.0
 var i = 0
 while i < 32 { var next float = (x + n / x) * 0.5; if next == x { return x }; x = next; i = i + 1 }
 return x
}
fn sine(x float) float {
 while x > 3.141592653589793 { x = x - 6.283185307179586 }
 while x < -3.141592653589793 { x = x + 6.283185307179586 }
 if x > 1.5707963267948966 { x = 3.141592653589793 - x }
 if x < -1.5707963267948966 { x = -3.141592653589793 - x }
 var t float = x
 var result float = x
 var n = 1
 while n < 6 {
  t = -t * x * x / ((2 * n) * (2 * n + 1))
  result = result + t; n = n + 1
 }
 return result
}
fn cosine(x float) float { return sine(x + 1.5707963267948966) }
fn ag_abs(x float) float { if x < 0.0 { return -x }; return x }
fn small_atan(x float) float {
 var t float = x; var result float = x; var n = 1
 while n < 8 {
  t = -t * x * x
  result = result + t / (2 * n + 1)
  n = n + 1
 }
 return result
}
fn positive_atan(x float) float {
 if x > 1.0 { return 1.5707963267948966 - positive_atan(1.0 / x) }
 if x > 0.414213562373095 { return 0.7853981633974483 + small_atan((x - 1.0) / (x + 1.0)) }
 return small_atan(x)
}
fn angle(y float, x float) float {
 if x == 0.0 {
  if y > 0.0 { return 1.5707963267948966 }
  if y < 0.0 { return -1.5707963267948966 }
  return 0.0
 }
 var a float = positive_atan(ag_abs(y / x))
 if x < 0.0 { a = 3.141592653589793 - a }
 if y < 0.0 { a = -a }
 return a
}
fn transform(i int) float {
 if i == 0 { return state * 10.0 - 5.0 }
 if i == 1 { return sine(state * 3.141592653589793) }
 return cosine(state * 3.141592653589793)
}

fn pathological_math(n int) float {
 var i = 0; var total = 0.0
 while i < n {
  total = total + sine(i * 0.01) + cosine(i * 0.01) + angle(i * 0.01,1.0) + root(i + 1.0)
  i = i + 1
 }
 return total
}
