// auto-ui PLAN-001 objects2d/1 second public configuration: the SAME scene
// with a faster coin and an earlier respawn line. The changed user
// parameters alter the real trajectory (pickup tick) and lifecycle — this
// file is the param-sensitivity twin of main.at.
var speed=4.0
var coin_x=8.0
var h_coin=0
var h_gem=0
var ok=0
fn app_start() {
 ok=ok+ag_char_bind(1)
 ok=ok+ag_char_solid(2)
 ok=ok+ag_camera_follow_2d(1, 0.0, -4.0, 30.0, 12.0, 12.0, 8.0)
 h_coin=ag_object_spawn(0, 3, coin_x, 2.0, 0.0)
 h_gem=ag_object_spawn(1, 4, 20.0, 2.5, 0.0)
 ok=ok+ag_object_visible(h_gem, 1)
}
fn app_update(dt float) {
 let hr=ag_action_held(1)
 let dx=(hr*1.0)*3.0*dt
 ok=ok+ag_char_move(dx,0.0,0.002)
 coin_x=coin_x - speed*dt
 ok=ok+ag_object_move(h_coin, coin_x, 2.0, 0.0)
 if coin_x<10.0 {
  ok=ok+ag_object_despawn(h_coin)
  coin_x=26.0
  h_coin=ag_object_spawn(0, 3, coin_x, 2.0, 0.0)
 }
 let blink=ag_tick()%2
 ok=ok+ag_object_visible(h_gem, blink)
}
