// PLAN-086 官方分页示例 — routes + outlet（file-dialog 例同形）。
// 明暗切换走 runtime 惯例 dark_mode 字段（file-dialog 例同款）。
widget App {
    msg { ToggleTheme }
    model { var dark_mode bool = false }
    routes { "/" -> use demo }
    view {
        col (style: "w-full h-full bg-background text-foreground") {
            row (style: "items-center gap-2 px-3 py-1.5 border-b border-border shrink-0") {
                button "切换明暗" { onclick: .ToggleTheme, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
            }
            outlet
        }
    }
    on { .ToggleTheme -> { .dark_mode = !.dark_mode } }
}
