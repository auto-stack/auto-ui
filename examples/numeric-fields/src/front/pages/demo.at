use auto.json

// PLAN-087 演示页 — 普通设置表单：受控回路（committed → 应用校验/接受 →
// value/revision 原子推进 → 字段 Tick 重投影）与独立结果日志。
// 业务拒绝路径：「业务拒绝模式」开启后，所有 committed 以修订过期为由拒绝
// （value/revision 不变、errorMessage 显示业务错误）——验证组件不把请求当
// 成功、正式值不被覆盖。handler 内不做跨 handler 调用（T-01 P8 实证）。
widget demo {
    msg { Init, SizeCommitted(str), SizeErr(str), ZoomCommitted(str), ZoomErr(str), LenCommitted(str), LenUnit(str), LenErr(str), DurCommitted(str), DurUnit(str), DurErr(str), ToggleRules, ClearLog, Quit }
    model {
        // 受控状态（应用所有）
        var font_size str = "16.00"
        var font_rev int = 1
        var zoom str = "1.00"
        var zoom_rev int = 1
        var width_mm str = "210.00"
        var width_rev int = 1
        var width_unit str = "mm"
        var timeout_ms str = "1250.00"
        var timeout_rev int = 1
        var timeout_unit str = "ms"
        // 业务错误（按字段独立的正式 errorMessage 通道）
        var font_err str = ""
        var zoom_err str = ""
        var width_err str = ""
        var timeout_err str = ""
        // 结果日志（每次事件追加一条）
        var events List = []
        var seq_log int = 0
        // 业务拒绝演示开关
        var strict bool = false
    }
    use { package: numeric_fields from "../../../../../packages/numeric-fields" }
    view {
        col (style: "w-full h-full bg-background text-foreground gap-3 p-4 overflow-y-auto") {
            row (style: "items-center gap-2") {
                text "数值与单位输入设置表单" { style: "text-sm font-medium" }
                row (style: "flex-1") {}
                checkbox { text: "业务拒绝模式", checked: .strict, onclick: .ToggleRules }
            }
            row (style: "items-start gap-6 flex-wrap w-full") {
                col (style: "gap-3 min-w-80 flex-1") {
                    NumericField (value: .font_size, revision: .font_rev, precision: 2, min: "8", max: "72", step: "1", label: "字号 (8-72)", oncommitted: .SizeCommitted($event), onerror: .SizeErr($event), errorMessage: .font_err) {}
                    NumericField (value: .zoom, revision: .zoom_rev, precision: 2, min: "0.50", max: "3.00", step: "0.10", label: "缩放 (0.50-3.00)", oncommitted: .ZoomCommitted($event), onerror: .ZoomErr($event), errorMessage: .zoom_err) {}
                    UnitField (value: .width_mm, revision: .width_rev, precision: 2, min: "10", max: "1000", step: "1", label: "页面宽度", unitGroup: "length", unit: .width_unit, oncommitted: .LenCommitted($event), onunitChanged: .LenUnit($event), onerror: .LenErr($event), errorMessage: .width_err) {}
                    UnitField (value: .timeout_ms, revision: .timeout_rev, precision: 2, min: "100", step: "1", label: "超时时长", unitGroup: "time", unit: .timeout_unit, oncommitted: .DurCommitted($event), onunitChanged: .DurUnit($event), onerror: .DurErr($event), errorMessage: .timeout_err) {}
                }
                col (style: "gap-2 min-w-80 flex-1") {
                    text "当前值（受控真源）" { style: "text-xs font-medium text-muted-foreground" }
                    text f"字号 ${.font_size}（修订 ${.font_rev}）" { style: "text-xs" }
                    text f"缩放 ${.zoom}（修订 ${.zoom_rev}）" { style: "text-xs" }
                    text f"宽度 ${.width_mm} mm（显示 ${.width_unit}）" { style: "text-xs" }
                    text f"超时 ${.timeout_ms} ms（显示 ${.timeout_unit}）" { style: "text-xs" }
                    text "提交日志" { style: "text-xs font-medium text-muted-foreground mt-2" }
                    col (style: "gap-1 max-h-56 overflow-y-auto") {
                        if .seq_log == 0 {
                            text "（暂无提交）" { style: "text-xs text-muted-foreground" }
                        }
                        for line in .events {
                            text line { style: "text-xs text-muted-foreground break-all" }
                        }
                    }
                }
            }
            row (style: "items-center gap-2 border-t border-border pt-2") {
                button "清空日志" { onclick: .ClearLog, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
                button "退出" { onclick: .Quit, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
            }
        }
    }
    on {
        .Init -> {
            .events = []
            .seq_log = 0
        }
        .SizeCommitted(ev str) -> {
            var req = json.parse(ev)
            if .strict && req.baseRevision != .font_rev {
                .font_err = f"字号提交被业务拒绝（修订 ${req.baseRevision}）"
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] font 拒绝 ${ev}")
            } else {
                .font_size = req.value
                .font_rev = .font_rev + 1
                .font_err = ""
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] font 接受 ${req.value}")
            }
        }
        .SizeErr(ev str) -> {
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] font 错误 ${ev}")
        }
        .ZoomCommitted(ev str) -> {
            var req = json.parse(ev)
            if .strict && req.baseRevision != .zoom_rev {
                .zoom_err = f"缩放提交被业务拒绝（修订 ${req.baseRevision}）"
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] zoom 拒绝 ${ev}")
            } else {
                .zoom = req.value
                .zoom_rev = .zoom_rev + 1
                .zoom_err = ""
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] zoom 接受 ${req.value}")
            }
        }
        .ZoomErr(ev str) -> {
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] zoom 错误 ${ev}")
        }
        .LenCommitted(ev str) -> {
            var req = json.parse(ev)
            if .strict && req.baseRevision != .width_rev {
                .width_err = f"宽度提交被业务拒绝（修订 ${req.baseRevision}）"
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] width 拒绝 ${ev}")
            } else {
                .width_mm = req.value
                .width_rev = .width_rev + 1
                .width_err = ""
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] width 接受 ${req.value}")
            }
        }
        .LenUnit(ev str) -> {
            .width_unit = json.parse(ev).unit
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] width 单位 ${ev}")
        }
        .LenErr(ev str) -> {
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] width 错误 ${ev}")
        }
        .DurCommitted(ev str) -> {
            var req = json.parse(ev)
            if .strict && req.baseRevision != .timeout_rev {
                .timeout_err = f"超时提交被业务拒绝（修订 ${req.baseRevision}）"
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] timeout 拒绝 ${ev}")
            } else {
                .timeout_ms = req.value
                .timeout_rev = .timeout_rev + 1
                .timeout_err = ""
                .seq_log = .seq_log + 1
                .events.push(f"[${.seq_log}] timeout 接受 ${req.value}")
            }
        }
        .DurUnit(ev str) -> {
            .timeout_unit = json.parse(ev).unit
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] timeout 单位 ${ev}")
        }
        .DurErr(ev str) -> {
            .seq_log = .seq_log + 1
            .events.push(f"[${.seq_log}] timeout 错误 ${ev}")
        }
        .ToggleRules -> {
            .strict = !.strict
        }
        .ClearLog -> {
            .events = []
            .seq_log = 0
        }
        .Quit -> {
            ui.close()
        }
    }
}
