// app.at — 029-photo-gallery 现代相册（Plan 628 → PLAN-043 Part 1 后端化）
//
// 数据源：后端 photo_service 实时扫描（pac `photo_root:` 声明根目录）——
// Init 拉 /api/photos/scan?dir=<当前目录> 建库面；缩略图走
// /api/photos/thumb/:id（按需渲染 + 磁盘缓存），查看器原图走
// /api/photos/full/:id。目录增删后重启 app 即跟随（Plan 628 离线烘焙链
// 已删，见 pac.at 头注）。
//
// PLAN-091 T-04 网格/搜索/目录迁移：库面（网格/搜索/相册/目录导航）消费
// 官方 AssetBrowser 包（受控 query/selection 合同）——应用仍是唯一
// provider：scan 业务、收藏（photo-gallery.favs）、相册、资源 URL 契约
// 全部保留；查看区（PLAN-089 ImageViewport）不变。卡片点击=选择；
// 「查看大图」按选择身份进入查看器；收藏走工具栏「收藏选中」；分页由
// PaginationControl 驱动（替代原 render_cap 批量闸）。
//
// 浏览模型（2026-09-24 用户裁定，迁移后保留）：**非递归**——库面只列当前
// 目录直属图片；子目录以分类树节点呈现（folder id = "dir:<rel>"，选择即
// 进入）。收藏跨目录全局（fav 记录带完整 URL，收藏夹聚合所有目录的收藏
// 项）。收藏 id 落 app Storage（photo-gallery.favs），重开保留。

use auto.json
use std.json: json_is_valid
use stylekit.styles: caption_text

// PLAN-046 T-03：接入官方主题包（Auto/Solarized 两族；family 经
// theme_name + design 绑定，dark_mode/accent_color 契约变量与
// ToggleDark/SetAccent 原 handler 全保留；scan/thumb/full 与收藏业务零改动）。
use themes.themes: Auto, Solarized

style label_xs_medium = "text-xs font-medium"
style glass_btn_a = "h-9 px-4 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center gap-1.5 border border-white/10"
style glass_btn_b = "h-9 px-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center gap-1.5 backdrop-blur-md border border-white/10"
style icon_btn = "h-8 w-8 rounded-lg bg-transparent hover:bg-muted text-muted-foreground hover:text-foreground flex items-center justify-center"

fn photo_gallery_saved_favorites(value str) bool {
    var index int = 0
    for index < value.len() {
        let ch = value.slice(index, index + 1)
        if ch == "[" { return json_is_valid(value) }
        if ch != " " && ch != "\n" && ch != "\r" && ch != "\t" { return false }
        index = index + 1
    }
    return false
}

fn photo_gallery_parent_directory(path Str) Str {
    var end int = path.len()
    for end > 0 {
        if path.slice(end - 1, end) == "/" {
            return path.slice(0, end - 1).to(Str)
        }
        end = end - 1
    }
    return ""
}

fn photo_gallery_escape_query_byte(byte int) Str {
    let hex Str = "0123456789ABCDEF"
    let high = byte / 16
    let low = byte % 16
    let percent Str = "%"
    return percent + hex.slice(high, high + 1) + hex.slice(low, low + 1)
}

fn photo_gallery_directory_query(path str) Str {
    var encoded Str = ""
    var index int = 0
    let length = path.len()
    for index < length {
        let ch = path.char_at(index)
        let code = ch.to_codepoint()
        let digit = code >= 48 && code <= 57
        let letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
        let punctuation = code == 45 || code == 46 || code == 95 || code == 126
        if digit || letter || punctuation {
            encoded = encoded + ch.to(Str)
        } else {
            if code < 128 {
                encoded = encoded + photo_gallery_escape_query_byte(code)
            } else {
                // Percent escapes represent UTF-8 bytes.
                if code < 2048 {
                    encoded = encoded + photo_gallery_escape_query_byte(192 + code / 64)
                } else {
                    if code < 65536 {
                        encoded = encoded + photo_gallery_escape_query_byte(224 + code / 4096)
                    } else {
                        encoded = encoded + photo_gallery_escape_query_byte(240 + code / 262144)
                        encoded = encoded + photo_gallery_escape_query_byte(128 + code / 4096 % 64)
                    }
                    encoded = encoded + photo_gallery_escape_query_byte(128 + code / 64 % 64)
                }
                encoded = encoded + photo_gallery_escape_query_byte(128 + code % 64)
            }
        }
        index = index + 1
    }
    return encoded
}

fn photo_gallery_record_index(records List, id str) int {
    var index int = 0
    for index < records.len() {
        let record_id str = records[index].id
        if record_id == id { return index }
        index = index + 1
    }
    return -1
}

fn photo_gallery_sort_rows(source List, query str, direction str) List {
    var hits = []
    var i int = 0
    for i < source.len() {
        var matches bool = query == ""
        if !matches {
            let title str = source[i].title
            matches = title.to_lower().contains(query)
        }
        if matches {
            hits.push(i)
        }
        i = i + 1
    }

    // 选择排序保持同一 mtime 下的原目录顺序。
    var rows List = []
    for hits.len() > 0 {
        var best int = 0
        var best_key int = source[hits[0]].sort_key
        var bi int = 1
        for bi < hits.len() {
            let k int = source[hits[bi]].sort_key
            if (direction == "asc" && k < best_key) || (direction == "desc" && k > best_key) {
                best = bi
                best_key = k
            }
            bi = bi + 1
        }
        let index int = hits.remove(best)
        rows.push(source[index])
    }
    return rows
}

fn photo_gallery_page_rows(source List, offset int, count int) List {
    var page List = []
    let end int = offset + count
    var index int = offset
    for index < source.len() && index < end {
        let p = source[index]
        page.push({
            id: p.id,
            revision: p.sort_key.str(),
            label: p.title,
            kind: "image",
            thumbnailUri: p.thumb,
            resourceRef: "photo:" + p.id
        })
        index = index + 1
    }
    return page
}

widget App {
    // PLAN-089：查看区（原图展示）消费正式包（widget 内 use；收藏/目录/
    // 扫描业务仍归 Gallery）。
    // PLAN-091 T-04：库面消费官方包（查看区消费 image_viewer 保持不变）。
    use { package: asset_browser from "../../../../../packages/asset-browser" }
    use { package: image_viewer from "../../../../../packages/image-viewer" }
    msg {
        Init, OpenGallery, RestoreFavorites(str),
        GoUp, ReloadDir,
        ToggleSort, ToggleDark, SetAccent(str),
        OpenSelected, ToggleFavSelected,
        GalQuery(str), GalSel(str), GalPrev(str), GalApply, PublishQuery,
        // PLAN-117（U05 029 真语料）：AGE 面要求「handler 消息须已声明」——
        // 以下为 on 段引用的内部消息（仅声明，不改行为）。
        OpenPhoto(str), PrevPhoto, NextPhoto, ApplyView(str), ViewEvent(str), BackToGrid, ToggleFav(str)
    }

    bind {
        "storage:photo-gallery.favs:fav_json" -> .RestoreFavorites
    }

    timer {
        OpenGallery (every_ms: 250, when: .initial_scan)
    }

    model {
        // ---- 主题契约变量 ----
        var dark_mode bool = true
        var accent_color str = "indigo"

        // ---- 视图形态 ----
        var mode str = "grid"               // "grid" | "view"

        // ---- 数据源（Init/导航自后端 scan 填充；非递归浏览模型）----
        var photos = []                     // 当前目录直属图片（scan 原始条目）
        var dirs = []                       // 当前目录的子目录 [{name,rel_path}]
        var dir str = ""                    // 当前目录（根相对路径，"" = 根）
        var fav_records = []                // 收藏全记录（跨目录聚合视图 + Storage 持久化）
        var fav_json str = "[]"
        var initial_scan bool = true
        var load_error str = ""             // scan 失败文案（空 = 成功）
        var root_missing bool = false       // 后端根目录缺席诚实态

        // ---- 过滤 / 排序（provider 镜像）----
        var album str = "all"               // all | favorites
        var search_q str = ""
        var sort_dir str = "desc"           // "desc"=最新在前 | "asc"
        var sort_label str = "最新 ↓"
        var status_label str = "加载中…"
        var scan_source_label str = ""

        // ---- PLAN-091 provider 受控面（AssetBrowser 的应用侧）----
        var gal_records = []                // 当前页（r2 记录形状）
        var gal_folders = []                // 分类树（全部/收藏/各子目录）
        var gal_error str = ""              // 组件 errorMessage（provider 具名错误）
        var query str = ""
        var querySeq int = 0
        var resultQueryId str = ""
        var total int = 0
        var selection str = ""
        var revision int = 100
        var loading bool = false
        var qf_id str = "q1"
        var qf_folder str = "all"
        var qf_text str = ""
        var qf_kind str = ""
        var qf_page int = 1
        var qf_pageSize int = 50
        var qid_counter int = 1
        var last_accepted_seq int = 0
        var view_list = []                  // 过滤+排序后的全量（当前语义域）
        var view_ids = []

        // ---- 查看器 ----
        var cur_id str = ""
        var cur_title str = ""
        var cur_meta str = ""
        var cur_full str = ""
        // PLAN-089：受控视图状态（查看区组件的调用方所有）。
        var view_rev int = 0
        var view_fit str = "contain"
        var view_zoom float = 1.0
        var view_ox float = 0.0
        var view_oy float = 0.0
        var view_rot int = 0
        var prev_id str = ""
        var next_id str = ""
        var fav_label str = "♡ 收藏"
        var is_cur_fav bool = false
        // PLAN-046 T-03：主题族选择态。
        var theme_name str = "Auto"
    }

    // PLAN-046 T-03：主题/模式绑定（C-14 数据绑定形态；不复制调色板、
    // 不新增业务菜单；ToggleDark/SetAccent 原 handler 保留）。
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "w-full h-screen flex flex-col bg-background text-foreground overflow-hidden font-sans"

            // ════════════════════════════════════════════════════════
            // 模式 1：库面（PLAN-091：AssetBrowser 消费网格/搜索/目录）
            // ════════════════════════════════════════════════════════
            if .mode == "grid" {
                col {
                    style: "w-full h-full flex flex-col overflow-hidden"

                    // ---- 顶栏：标题 + 选择动作 + 排序/主题 ----
                    row {
                        style: "h-14 shrink-0 items-center justify-between px-5 border-b border-border bg-card/60 gap-3"

                        row {
                            style: "items-center gap-2.5"
                            text "相册" { style: "text-lg font-bold tracking-tight" }
                            text "Photos" { style: "text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary font-medium" }
                            if .dir != "" {
                                button (text: "← 上一级", variant: "ghost") {
                                    onclick: .GoUp
                                    style: "h-8 px-3 rounded-lg bg-background text-foreground text-xs font-semibold shadow-sm border border-border"
                                }
                            }
                        }

                        row {
                            style: "items-center gap-2"
                            button (text: "查看大图", title: "查看选中的照片", onclick: .OpenSelected, disabled: .selection == "", style: "h-8 px-3 text-xs rounded-lg border border-primary text-primary disabled:opacity-40") {}
                            button (text: "收藏选中", title: "收藏/取消收藏选中的照片", onclick: .ToggleFavSelected, disabled: .selection == "", style: "h-8 px-3 text-xs rounded-lg border border-border text-muted-foreground hover:text-foreground disabled:opacity-40") {}
                            button (text: .sort_label, variant: "ghost") {
                                onclick: .ToggleSort
                                style: "h-8 px-2.5 text-xs rounded-lg border border-border text-muted-foreground hover:text-foreground"
                            }
                            if .dark_mode {
                                button {
                                    onclick: .ToggleDark
                                    style: icon_btn
                                    icon (name: "moon", size: 16)
                                }
                            } else {
                                button {
                                    onclick: .ToggleDark
                                    style: icon_btn
                                    icon (name: "sun", size: 16)
                                }
                            }
                        }
                    }

                    // ---- 信息条（计数 + 后端扫描态/错误）----
                    row {
                        style: "h-8 shrink-0 items-center justify-between px-5 bg-muted/20 border-b border-border/40"
                        text .status_label { style: caption_text }
                        if .root_missing {
                            text "⚠️ 照片源目录不存在（检查 photo_root）" { style: "text-[11px] text-destructive/80" }
                        } else {
                            text .scan_source_label { style: "text-[11px] text-muted-foreground/60" }
                        }
                    }

                    // ---- 库面：官方 AssetBrowser（PLAN-091）----
                    AssetBrowser (
                        records: .gal_records, folders: .gal_folders, query: .query,
                        querySeq: .querySeq, resultQueryId: .resultQueryId,
                        total: .total, selection: .selection, revision: .revision,
                        loading: .loading, errorMessage: .gal_error,
                        onqueryRequested: .GalQuery($event),
                        onselectionRequested: .GalSel($event),
                        onpreviewRequested: .GalPrev($event)
                    ) {}
                }
            } else {
                // ════════════════════════════════════════════════════════
                // 模式 2：沉浸式原画全屏查看态 (PLAN-089 查看区，不变)
                // ════════════════════════════════════════════════════════
                col {
                    style: "w-full h-full flex flex-col bg-black text-white relative select-none"

                    // 悬浮顶栏（返回 + 标题与参数 + 收藏）
                    row {
                        style: "h-16 shrink-0 items-center justify-between px-6 bg-gradient-to-b from-black/80 to-transparent z-10 gap-4"
                        button {
                            onclick: .BackToGrid
                            style: glass_btn_b
                            icon (name: "chevron-left", size: 16)
                            text "返回网格" { style: label_xs_medium }
                        }
                        col {
                            style: "items-center text-center"
                            text .cur_title { style: "text-sm font-semibold tracking-wide text-white truncate max-w-md" }
                            text .cur_meta { style: "text-[11px] text-white/60 mt-0.5" }
                        }
                        button {
                            onclick: .ToggleFav(.cur_id)
                            style: glass_btn_b
                            text .fav_label { style: label_xs_medium }
                        }
                    }

                    // 主图展示区（PLAN-089：通用受控视口；缩放/平移/旋转/
                    // 重置动作由组件工具栏提供，请求经 ApplyView 接受）
                    col {
                        style: "flex-1 min-h-0 relative"
                        ImageViewport (
                            src: .cur_full,
                            alt: .cur_title,
                            resourceId: .cur_id,
                            resourceRevision: .cur_id,
                            revision: .view_rev,
                            fit: .view_fit,
                            zoom: .view_zoom,
                            offsetX: .view_ox,
                            offsetY: .view_oy,
                            rotation: .view_rot,
                            showToolbar: true,
                            onviewRequested: .ApplyView($event),
                            onloaded: .ViewEvent($event),
                            onerror: .ViewEvent($event),
                            onnavigateRequested: .ViewEvent($event)
                        ) {}
                    }

                    // 移动端风格悬浮胶囊控制底栏 (Floating Navigation Capsule)
                    row {
                        style: "h-20 shrink-0 items-center justify-center px-6 bg-gradient-to-t from-black/80 to-transparent z-10"
                        row {
                            style: "items-center px-4 py-2 rounded-full bg-white/15 backdrop-blur-xl border border-white/15 gap-4 shadow-2xl"
                            button {
                                onclick: .PrevPhoto
                                style: glass_btn_a
                                icon (name: "chevron-left", size: 16)
                                text "上一张" { style: label_xs_medium }
                            }
                            text "•" { style: "text-white/30 text-xs" }
                            button {
                                onclick: .NextPhoto
                                style: glass_btn_a
                                text "下一张" { style: label_xs_medium }
                                icon (name: "chevron-right", size: 16)
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        // ---- Init：发布首个查询，等宿主恢复收藏后再扫描 ----
        .Init -> {
            // 初始 query 先于首次 scan 发布（浏览器 Tick 的 q_raw 守卫只在
            // query 变化时清 q_error——空串 query 会让 invalid_query 常驻）。
            .query = json.stringify({id: .qf_id, folderId: .qf_folder, text: .qf_text, kind: .qf_kind, page: .qf_page, pageSize: .qf_pageSize})
        }

        .RestoreFavorites(value str) -> {
            if photo_gallery_saved_favorites(value) {
                let saved = json.parse(value)
                .fav_records = saved
                .fav_json = value
            }
        }

        .OpenGallery -> {
            .ReloadDir()
            .initial_scan = .load_error != ""
        }

        // ---- ReloadDir：scan 当前 .dir（首扫与导航共用臂）----
        .ReloadDir -> {
            try {
                // PLAN-043 Phase 2: UI 路径裸 Http.get_json 编译期自带
                // to_value（PLAN-080 F-2③），直接取解析产物，勿再外包。
                // dir 参数经 query 传递——根为空串时后端归一化。
                let data = Http.get_json("/api/photos/scan?dir=" + photo_gallery_directory_query(.dir))
                .root_missing = data.root_missing ?? false
                if .load_error != "" { .gal_error = "" }
                .load_error = ""
                var entries = data.entries ?? []
                var dlist = []
                var dd = data.dirs ?? []
                var di int = 0
                while di < dd.len() {
                    let d = dd[di]
                    dlist.push({
                        name: d.name,
                        rel_path: d.rel_path
                    })
                    di = di + 1
                }
                .dirs = dlist
                var plist = []
                var i int = 0
                while i < entries.len() {
                    let e = entries[i]
                    // meta 串：尺寸缺席（头部解析失败）时只留大小+日期
                    var meta str = e.size_str + " · " + e.date
                    let w int = e.width
                    if w > 0 {
                        meta = w.str() + "×" + e.height.str() + " · " + meta
                    }
                    plist.push({
                        id: e.id,
                        title: e.title,
                        date: e.date,
                        meta: meta,
                        thumb: e.thumb_url,
                        full: e.full_url,
                        sort_key: e.sort_key
                    })
                    i = i + 1
                }
                .photos = plist
                if .dir == "" {
                    .scan_source_label = "后端实时扫描 · 根目录"
                } else {
                    .scan_source_label = "后端实时扫描 · " + .dir
                }
            } catch {
                .photos = []
                .dirs = []
                .scan_source_label = ""
                .root_missing = false
                .load_error = "照片后端未就绪（scan 请求失败）"
                .gal_error = "gallery: " + .load_error
            }
            .GalApply()
        }

        // ---- 导航：返回上一级（进入子目录走分类树选择）----
        .GoUp -> {
            .dir = photo_gallery_parent_directory(.dir)
            .album = "all"
            .qf_folder = "all"
            .qf_page = 1
            .selection = ""
            .PublishQuery()
            .ReloadDir()
        }

        .ToggleSort -> {
            if .sort_dir == "desc" {
                .sort_dir = "asc"
                .sort_label = "最早 ↑"
            } else {
                .sort_dir = "desc"
                .sort_label = "最新 ↓"
            }
            .GalApply()
        }

        // ============================================================
        // PLAN-091 provider：AssetBrowser 的应用侧（唯一查询/选择写点）
        // ============================================================
        // 查询请求：folder 语义映射（all=当前目录 / favorites=收藏夹 /
        // dir:<rel>=进入子目录），text=搜索，page/pageSize=真实分页。
        .GalQuery(ev str) -> {
            try {
                let req = json.parse(ev)
                let base_revision int = req.baseRevision
                let sequence int = req.seq
                if base_revision != .revision {
                    .querySeq = sequence
                    .loading = false
                    .gal_error = "gallery: 查询代次已过期（invalid_query）"
                    .status_label = "查询被拒绝：代次过期"
                } else {
                    if sequence <= .last_accepted_seq {
                        .status_label = "查询已丢弃：代次过期"
                    } else {
                        let q = req.query
                        let folder str = q.folderId
                        let search str = q.text
                        let kind str = q.kind
                        .last_accepted_seq = sequence
                        .querySeq = sequence
                        if folder != .qf_folder || search != .qf_text || kind != .qf_kind {
                            .selection = ""
                        }
                        var target_dir str = .dir
                        if folder != .qf_folder {
                            if folder == "all" {
                                .album = "all"
                                target_dir = ""
                            } else if folder == "favorites" {
                                .album = "favorites"
                                target_dir = ""
                            } else if folder.len() > 4 && folder.slice(0, 4) == "dir:" {
                                .album = "all"
                                target_dir = folder.slice(4, folder.len())
                            }
                        }
                        .qf_folder = folder
                        .qf_text = search
                        .qf_kind = kind
                        .qf_page = q.page
                        .qf_pageSize = q.pageSize
                        .PublishQuery()
                        .gal_error = ""
                        .loading = true
                        if target_dir != .dir {
                            .dir = target_dir
                            .ReloadDir()
                        } else {
                            .GalApply()
                        }
                    }
                }
            } catch {
                .status_label = "查询请求解析失败"
            }
        }

        .PublishQuery -> {
            .qid_counter = .qid_counter + 1
            .qf_id = "q" + .qid_counter.str()
            .query = json.stringify({id: .qf_id, folderId: .qf_folder, text: .qf_text, kind: .qf_kind, page: .qf_page, pageSize: .qf_pageSize})
            .revision = .revision + 1
        }

        // 应用查询：分类树 + 过滤 + 排序 + 真实分页 + 发布（结果可信三件套）。
        .GalApply -> {
            // 分类树（当前目录视角：全部/收藏/各子目录）
            var tabs List = []
            tabs.push({id: "all", label: "全部", children: []})
            tabs.push({id: "favorites", label: "❤ 收藏", children: []})
            var ti int = 0
            while ti < .dirs.len() {
                tabs.push({id: "dir:" + .dirs[ti].rel_path, label: "📂 " + .dirs[ti].name, children: []})
                ti = ti + 1
            }
            .gal_folders = tabs

            let ql str = .qf_text.to_lower()

            // 数据源：收藏夹聚合 fav_records，其余为当前目录 photos。
            var vlist List = []
            if .album == "favorites" {
                vlist = photo_gallery_sort_rows(.fav_records, ql, .sort_dir)
            } else {
                vlist = photo_gallery_sort_rows(.photos, ql, .sort_dir)
            }
            var vids = []
            var i int = 0
            while i < vlist.len() {
                vids.push(vlist[i].id)
                i = i + 1
            }

            // 真实分页（PLAN-091：page/pageSize 由 query 携带；替代原
            // render_cap 批量闸——分页由 PaginationControl 驱动）。
            let start int = (.qf_page - 1) * .qf_pageSize
            .gal_records = photo_gallery_page_rows(vlist, start, .qf_pageSize)
            .view_list = vlist
            .view_ids = vids
            .total = .view_list.len()
            .resultQueryId = .qf_id
            .loading = false
            .search_q = .qf_text

            // 文案
            var cur_label str = "全部"
            if .album == "favorites" { cur_label = "收藏夹" }
            if .qf_text == "" {
                .status_label = .total.str() + " 项内容 · " + cur_label + " · 第 " + .qf_page.str() + " 页"
            } else {
                .status_label = .total.str() + " 项内容 · 搜索 “" + .qf_text + "” · " + cur_label + " · 第 " + .qf_page.str() + " 页"
            }
        }

        // 选择请求：在当前语义域定位真实身份（收藏夹里可能不在当前目录）。
        .GalSel(ev str) -> {
            try {
                let req = json.parse(ev)
                let requested_id str = req.id
                var found int = -1
                var favorites bool = .album == "favorites"
                if favorites {
                    var si int = 0
                    while si < .fav_records.len() {
                        let candidate_id str = .fav_records[si].id
                        if candidate_id == requested_id { found = si }
                        si = si + 1
                    }
                }
                if found < 0 {
                    // 普通目录和收藏未命中的选择都在 photos 中定位。
                    favorites = false
                    var pi int = 0
                    while pi < .photos.len() {
                        let candidate_id str = .photos[pi].id
                        if candidate_id == requested_id { found = pi }
                        pi = pi + 1
                    }
                }
                if found >= 0 {
                    let c = if favorites { .fav_records[found] } else { .photos[found] }
                    .selection = json.stringify({id: c.id, revision: c.sort_key.str(), label: c.title})
                    .status_label = "已选 " + c.title
                } else {
                    .status_label = "选择被拒绝：当前库中无此资源"
                }
            } catch {
                .status_label = "选择请求解析失败"
            }
        }

        // 组件内预览（缩略图视口）仅观察；大图走「查看大图」→查看器。
        .GalPrev(ev str) -> {
            .status_label = "缩略图预览请求已收到"
        }

        // ---- 查看器：按选择身份定位（view_ids 为当前过滤排序序）----
        .OpenSelected -> {
            if .selection != "" {
                try {
                    let s = json.parse(.selection)
                    .OpenPhoto(s.id)
                } catch {
                    .status_label = "选择身份解析失败"
                }
            }
        }

        // ---- 收藏选中：按照片 ID 更新收藏及持久化 ----
        .ToggleFavSelected -> {
            if .selection != "" {
                try {
                    let s = json.parse(.selection)
                    .ToggleFav(s.id)
                } catch {
                }
            }
        }

        .OpenPhoto(pid) -> {
            var pos int = -1
            var n int = .view_ids.len()
            var i int = 0
            while i < n {
                let candidate_id str = .view_ids[i]
                if candidate_id == pid { pos = i }
                i = i + 1
            }
            if pos >= 0 {
                let photo = .view_list[pos]
                .mode = "view"
                .cur_id = pid
                var prev_pos int = pos - 1
                if prev_pos < 0 { prev_pos = n - 1 }
                var next_pos int = pos + 1
                if next_pos >= n { next_pos = 0 }
                .prev_id = .view_ids[prev_pos]
                .next_id = .view_ids[next_pos]

                .cur_title = photo.title
                .cur_full = photo.full
                .cur_meta = photo.meta
                .is_cur_fav = photo_gallery_record_index(.fav_records, pid) >= 0
                // 新图初始基线：contain/1/0/0/0（组件换代即捕获）。
                .view_fit = "contain"
                .view_zoom = 1.0
                .view_ox = 0.0
                .view_oy = 0.0
                .view_rot = 0
                .view_rev = .view_rev + 1
                if .is_cur_fav {
                    .fav_label = "❤ 已收藏"
                } else {
                    .fav_label = "♡ 收藏"
                }
            }
        }

        .PrevPhoto -> { .OpenPhoto(.prev_id) }
        .NextPhoto -> { .OpenPhoto(.next_id) }
        // PLAN-089：受控接受（唯一业务 view 写点；拒绝 = 保持原视图）。
        .ApplyView(ev str) -> {
            let req = json.parse(ev)
            if req.baseRevision == .view_rev {
                // PLAN-089：`view` 在成员位被 DotView 词元吞掉（auto-lang 解析缺口，成员访问静默取空）——消费方以索引取键，载荷键不变。
                .view_fit = req.fit
                .view_zoom = req.zoom
                .view_ox = req.offsetX
                .view_oy = req.offsetY
                .view_rot = req.rotation
                .view_rev = .view_rev + 1
            }
        }
        // 组件 loaded/error/navigate 事件在 029 仅观察（导航走胶囊按钮）。
        .ViewEvent(ev str) -> {
        }
        .BackToGrid -> {
            .mode = "grid"
            .ReloadDir()
        }

        // ---- 收藏：fav_records 是跨目录收藏状态的唯一来源 ----
        .ToggleFav(pid) -> {
            let photo_index = photo_gallery_record_index(.photos, pid)
            let favorite_index = photo_gallery_record_index(.fav_records, pid)
            if photo_index >= 0 || favorite_index >= 0 {
                let favored = favorite_index < 0
                if favored {
                    let photo = .photos[photo_index]
                    .fav_records.push({
                        id: pid,
                        title: photo.title,
                        date: photo.date,
                        meta: photo.meta,
                        fav: true,
                        thumb: photo.thumb,
                        full: photo.full,
                        sort_key: photo.sort_key
                    })
                } else {
                    var kept = []
                    var index int = 0
                    while index < .fav_records.len() {
                        if index != favorite_index { kept.push(.fav_records[index]) }
                        index = index + 1
                    }
                    .fav_records = kept
                }
                .fav_json = json.stringify(.fav_records)
                .GalApply()
                if .mode == "view" && .cur_id == pid {
                    .is_cur_fav = favored
                    if favored {
                        .fav_label = "❤ 已收藏"
                    } else {
                        .fav_label = "♡ 收藏"
                    }
                }
            }
        }

        .ToggleDark -> { .dark_mode = !.dark_mode }
        .SetAccent(name) -> { .accent_color = name }
    }
}
