name: "calculator"
version: "1.0.0"
scene: "ui"
render: "vue"
icon: "calculator"
title: "Calculator"
title_zh: "计算器"
# PLAN-615 T-04：theme 显式键移除——跟随主题链（CLI > os-config > OS 系统
# 主题；桌面轨经 config.dark_theme 派生）。显式值会以 pac.at 优先级压过
# OS 跟随，深浅双主题需求下不声明。
accent: "indigo"
# Plan 504: 窗口随内容自然尺寸收缩（独立 VM 窗 / 虚拟桌面窗双路径）。
window: "fit"
desktop: "true"

dep stylekit {
    path: "../stylekit"
}

# PLAN-037 T-02：官方主题单源包（不复制配色表进本 app，C-13）。
# 本 pac 不声明 theme 键（PLAN-615 T-04：跟随主题链）——独立默认按 031/033
# 契约为官方 Auto/light；App 内既有 dark_mode = true（暗支外观优先）作为
# 应用级显式默认精确保留，家族/模式选择经 theme_name + design 数据绑定。
dep themes {
    path: "../../../packages/themes"
}
