// 027-file-manager 的 VM 后端将目录读取和写操作委托给宿主授予的当前文件会话。
// 路由保留单行委托体供 a2r 签名生成使用，前端根据原始元数据派生展示字段。

pub type DirEntry = {
    name: str
    path: str
    is_dir: bool
    size: int
    mtime: int
    extension: str
}

pub type DirListing = {
    ok: bool
    path: str
    entries: []DirEntry
}

fn impl_list(path str) DirListing {
    let raw str = fs.session_list(path)
    if raw == "" {
        return { ok: false, path: "", entries: [] }
    }
    return json.parse(raw)
}

fn impl_home() str {
    return fs.session_root()
}

fn impl_drives() []DirEntry {
    let root str = fs.session_root()
    if root == "" {
        return []
    }
    return [DirEntry { name: root, path: root, is_dir: true, size: 0, mtime: 0, extension: "" }]
}

/// 列出当前会话根目录内的条目。请求被拒绝或读取失败时返回 ok:false。
#[api(method = "GET", path = "/api/fs/list")]
pub fn fs_list(path str) DirListing {
    return impl_list(path)
}

/// 返回当前会话授权的根目录。会话尚未获得授权时返回空字符串。
#[api(method = "GET", path = "/api/fs/home")]
pub fn fs_home() str {
    return impl_home()
}

/// 返回当前会话浏览起点，供位置选择器使用。
#[api(method = "GET", path = "/api/fs/drives")]
pub fn fs_drives() []DirEntry {
    return impl_drives()
}

/// 在当前会话授权的目录内执行一次写操作。拒绝或失败返回 false。
#[api(method = "POST", path = "/api/fs/mutate")]
pub fn fs_mutate(operation str, path str, target str) bool {
    return fs.session_mutate(operation, path, target)
}
