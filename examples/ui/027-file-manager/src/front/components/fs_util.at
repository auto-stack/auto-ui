// components/fs_util.at — 文件管理器纯函数工具（PLAN-016 T-05/T-06）。
//
// 文件类型、扩展名、缩略图与打开关联。

/// PLAN-023：媒体管线可缩略的图片扩展名（image_pipeline supported_media_path
/// 同款白名单：jpg/jpeg/png/webp——gif/bmp/svg/ico 管线解码器不收，照旧
/// FileIcon）。thumb 队列的 app 侧预门，避免排注定失败的活。
pub fn is_image_ext(extension str) bool {
    if extension == "jpg" || extension == "jpeg" || extension == "png" || extension == "webp" {
        return true
    }
    return false
}

/// PLAN-016 T-09：扩展名 → 桌面 open_with 关联（v1 静态表——注册表
/// `opens:` 投影面落地前，027 内置默认关联；与 041/031 pac.at opens
/// 声明保持同源，host 执行臂仍按注册表校验）。无关联返回 ""。
pub fn app_for_ext(extension str) str {
    if extension == "txt" || extension == "md" || extension == "log" || extension == "at" || extension == "rs" || extension == "toml" || extension == "json" || extension == "yaml" || extension == "yml" || extension == "py" || extension == "js" || extension == "ts" || extension == "html" || extension == "css" || extension == "csv" {
        return "041-auto-edit"
    }
    if extension == "jpg" || extension == "jpeg" || extension == "png" || extension == "webp" || extension == "gif" || extension == "bmp" || extension == "svg" || extension == "ico" {
        return "031-image-viewer"
    }
    return ""
}
// The dialog accepts arbitrary text. File Manager requires one local path entry.
pub fn valid_entry_name(name str) bool {
    return (name != "" && name != "." && name != ".." &&
        !name.ends_with(" ") && !name.ends_with(".") &&
        !name.contains("/") && !name.contains("\\") && !name.contains(":") &&
        !name.contains("*") && !name.contains("?") && !name.contains("\"") &&
        !name.contains("<") && !name.contains(">") && !name.contains("|") &&
        !name.contains("\r") && !name.contains("\n") && !name.contains("\t"))
}
