use fs_util: is_image_ext

pub fn fm_path_index(files List, target str) int {
    if target == "" { return -1 }
    var i int = 0
    while i < files.len() {
        if files[i].path == target { return i }
        i = i + 1
    }
    return -1
}

pub fn fm_collection_items(files List, item_revision str) List {
    var result List = []
    var i int = 0
    while i < files.len() {
        let file = files[i]
        if file.path != "" {
            let kind = if file.is_dir { "folder" } else if is_image_ext(file.file_ext) { "image" } else { "file" }
            result.push({
                id: file.path, itemRevision: item_revision, label: file.name,
                kind: kind, icon: kind, thumbnailUri: file.thumb_src,
                thumbnailState: if file.thumb_src == "" { "missing" } else { "ready" },
                cells: [
                    {key: "size", text: file.size_str},
                    {key: "type", text: file.type_name},
                    {key: "date", text: file.date}
                ],
                actions: [
                    {id: "open", label: "打开", enabled: true},
                    {id: "menu", label: "菜单", enabled: true}
                ],
                defaultActionId: "open", disabled: false
            })
        }
        i = i + 1
    }
    return result
}
