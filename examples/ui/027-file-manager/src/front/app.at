use components.native_directory: native_shortcuts, native_drives, native_listing
use components.native_file_actions: native_file_mutation, native_open_default
use std.json: json_object_text, json_object_i32
use collection_view.collection_schema: CollectionColumn
use back.api: fs_list, fs_home, fs_mutate
use auto.fs
use auto.file

// PLAN-046 T-03：接入官方主题包（Auto/Solarized 两族；family 经
// theme_name + design 绑定；dark_mode 既有契约（宿主 SetTheme 回写链）
// 与文件系统业务零改动；不复制调色板、不新增菜单）。
use themes.themes: Auto, Solarized

style breadcrumb_label = "text-sm text-muted-foreground font-medium"
style row_gap1 = "items-center gap-1"
style sidebar_item = "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
style dim_xs = "shrink-0 text-xs text-muted-foreground/60"
style col_tight = "items-center gap-0.5 shrink-0"
style search_input = "w-full text-xs px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-1 outline-none focus:border-primary"
style row_gap3 = "items-center gap-3"

type DirEntry {
    name str
    path str
    is_dir bool
    size u64
    mtime i64
    extension str
}

type DirListing {
    ok bool
    path str
    entries List<DirEntry>
}

fn prepare_file_listing(entries List<DirEntry>, query str, include_dotfiles bool, column str, direction str) PreparedListing {
    var rows List<FileManagerRow> = []
    var kept int = 0
    var truncated bool = false
    var index int = 0
    while index < entries.len() && !truncated {
        let entry_name = "" + entries[index].name
        if matches_file(entry_name.to(str), query, include_dotfiles) {
            if kept >= 500 {
                truncated = true
            } else {
                let entry_path = "" + entries[index].path
                let extension = "" + entries[index].extension
                rows.push(listed_file_row(
                    kept, entry_name.to(str), entry_path.to(str), entries[index].is_dir,
                    entries[index].size, entries[index].mtime, extension.to(str)
                ))
                kept = kept + 1
            }
        }
        index = index + 1
    }
    return PreparedListing {
        rows: sort_files(rows, column, direction),
        truncated: truncated,
        total_size: summarize_bytes(rows)
    }
}

fn root_shortcuts(root str) List<FileManagerShortcut> {
    var items List<FileManagerShortcut> = []
    items.push(FileManagerShortcut {path: root.to(Str), label: "主目录", is_home: true})
    return items
}

fn directory_shortcuts(root str, entries List<DirEntry>) List<FileManagerShortcut> {
    var items = root_shortcuts(root)
    let folder_names List<str> = ["Desktop", "Documents", "Downloads", "Pictures", "Music"]
    let folder_labels List<str> = ["桌面", "文档", "下载", "图片", "音乐"]
    var which int = 0
    while which < folder_names.len() {
        var index int = 0
        var found bool = false
        let expected_name = "" + folder_names[which]
        while index < entries.len() && !found {
            if entries[index].is_dir && entries[index].name == expected_name {
                let shortcut_path = "" + entries[index].path
                let shortcut_label = "" + folder_labels[which]
                items.push(FileManagerShortcut {
                    path: shortcut_path.to(str).to(Str),
                    label: shortcut_label.to(str).to(Str),
                    is_home: false
                })
                found = true
            }
            index = index + 1
        }
        which = which + 1
    }
    return items
}

fn directory_roots(root str) List<FileManagerDrive> {
    var items List<FileManagerDrive> = []
    items.push(FileManagerDrive {path: root.to(Str), label: root.to(Str)})
    return items
}

fn collection_status(booting bool) Str {
    if booting { return "loading" }
    return "ready"
}

fn collection_empty_label(track str, available bool) Str {
    if track == "vm" || available { return "此目录为空" }
    return "后端读盘不可达"
}

fn offline_shortcuts() List<FileManagerShortcut> {
    return [
        FileManagerShortcut {path: "demo://home", label: "主目录", is_home: true},
        FileManagerShortcut {path: "demo://docs", label: "文档", is_home: false},
        FileManagerShortcut {path: "demo://pics", label: "图片", is_home: false}
    ]
}

