    return [
        FileManagerRow {id: 0, name: "Documents", path: "demo://home/Documents", is_dir: true, size: (0).to(u64), size_str: "", file_ext: "", type_name: "文件夹", date: "2026-09-20 10:00", is_hidden: false, thumb_src: ""},
        FileManagerRow {id: 1, name: "Pictures", path: "demo://home/Pictures", is_dir: true, size: (0).to(u64), size_str: "", file_ext: "", type_name: "文件夹", date: "2026-09-20 10:00", is_hidden: false, thumb_src: ""},
        FileManagerRow {id: 2, name: "Downloads", path: "demo://home/Downloads", is_dir: true, size: (0).to(u64), size_str: "", file_ext: "", type_name: "文件夹", date: "2026-09-18 09:12", is_hidden: false, thumb_src: ""},
        FileManagerRow {id: 3, name: "readme.md", path: "demo://home/readme.md", is_dir: false, size: (2048).to(u64), size_str: "2 KB", file_ext: "md", type_name: "Markdown", date: "2026-09-21 14:30", is_hidden: false, thumb_src: ""},
        FileManagerRow {id: 4, name: "report.pdf", path: "demo://home/report.pdf", is_dir: false, size: (245760).to(u64), size_str: "240 KB", file_ext: "pdf", type_name: "PDF", date: "2026-09-19 11:05", is_hidden: false, thumb_src: ""},
        FileManagerRow {id: 5, name: "photo.png", path: "demo://home/photo.png", is_dir: false, size: (1048576).to(u64), size_str: "1 MB", file_ext: "png", type_name: "图片", date: "2026-09-17 16:44", is_hidden: false, thumb_src: ""}
    ]
}

fn child_path(directory str, name str) Str {
    if directory == "" || name == "" || name == "." || name == ".." || name.contains("/") {
        return ""
    }
    let windows bool = directory.slice(1, 2) == ":" || directory.contains("\\") && directory.slice(0, 1) != "/"
    if windows && (name.contains("\\") || name.contains(":")) {
        return ""
    }
    let last str = directory.slice(directory.len() - 1, directory.len())
    if last == "/" || (windows && last == "\\") {
        return directory + name
    }
    if windows {
        return directory + "\\" + name
    }
    return directory + "/" + name
}

widget App {
    use { package: prompt_dialog from "../../../../../packages/prompt-dialog" }
    use { package: collection_view from "../../../../../packages/collection-view" }
    use { package: official from "./components" }

    msg {
        Init, BootTick, AdvanceBoot, ShowOfflineDemo, DirectoryRootOpened(str),
        NavTo(str), Navigate(str, int), NavigateInSession(str, int), RequestDirectory(str, int, bool), DirectoryListed(DirListing),
        RequestMutation(str, str, str, str, bool), MutationApplied(bool),
        CommitDirectoryPath(str, int),
        CommitNavigation(str, int), GoBack, GoForward, GoUp,
        SetViewMode(str), SortByName, SortBySize, SortByDate, SortByType, ToggleHidden,
        RestoreViewMode(str), RestoreSortColumn(str), RestoreSortDirection(str), RestoreHidden(str),
        SetSearch(str), SetAddr(str), AddrGo, AddrEdit, AddrCancel, SelectItem(int), OpenItem(int), FileOpened(int),
        CollectionMode(str), CollectionSort(str), CollectionSelection(str), CollectionAction(str),
        CollectionItem(str, bool), PublishCollection,
        CrumbsExpand,
        StartRename(int), BeginName(str, str, str), CommitName(str), CancelName(str),
        SetEditName(str), CommitRename, CancelRename, NewModalClose, SetNewName(str), CommitNew,
        ItemCtx(int), CtxClose, CtxOpen, CtxRename, CtxCopy, CtxCut, CtxPaste, CtxDelete,
        NewFolderOpen, NewFileOpen,
        ConfirmDelete(int), ExecuteDelete, CancelDelete
    }

    bind {
        "file:list" -> .DirectoryListed
        "file:root" -> .DirectoryRootOpened
        "file:mutate" -> .MutationApplied
        "file:open" -> .FileOpened
        "storage:fileman.view_mode:view_mode" -> .RestoreViewMode
        "storage:fileman.sort_col:sort_col" -> .RestoreSortColumn
        "storage:fileman.sort_dir:sort_dir" -> .RestoreSortDirection
        "storage:fileman.show_hidden:show_hidden" -> .RestoreHidden
    }
    timer { BootTick (every_ms: 250, when: .booting) }

    model {
        // PLAN-016 T-09：桌面命令总线上行（shell 同款状态面——宿主每周期
        // 读+清；v1.7 起普通注册表窗联合排空，open_with 可达）。
        var __desktop_cmd str = ""
        // PLAN-016 T-01：主题跟随——桌面切主题时宿主对本变量回写（dark_mode
        // 回写链），视图全语义 token 随之换肤；vue 轨按本变量绑根 dark class。
        var dark_mode bool = true
        // PLAN-046 T-03：主题族选择态（官方包 family 经 design 绑定；
        // 默认 Auto；宿主/CLI/fixture 可切 Solarized）。
        var theme_name str = "Auto"

        // 延迟引导（250ms 基准 = 012/025 先例）：Init 只做轻量
        // 恢复，快捷访问探测和首目录扫描由启动计时器负责。
        // 避开 iced boot 临界区（PLAN-016 实测：Init 内同步 fs 原生调用与
        // 宿主 GPU/surface 初始化偶发竞态挂起）。
        var booting bool = true
        var tick_count int = 0               // 等待初始窗口完成绘制

        // ---- 真实文件系统导航状态（T-05）----
        var home str = ""                   // Env USERPROFILE/HOME，Init 解析
        var is_vm str = ""                  // PLAN-680 Q1：轨别（Env.track），FS 能力守卫
        var back_fs bool = false            // PLAN-684 rev7：vue 轨后端读盘就绪（fs_home 非空；骨架/不可达=false→演示后备）
        var current_path str = ""
        var file_request_revision int = 0
        var file_request_pending bool = false
        var file_request_path str = ""
        var file_request_history_index int = -1
        var file_request_startup bool = false
        var file_mutation_pending bool = false
        var file_mutation_operation str = ""
        var file_mutation_path str = ""
        var file_mutation_target str = ""
        var file_mutation_label str = ""
        var file_mutation_move bool = false
        var file_mutation_view_revision int = 0
        var file_open_pending bool = false
        var file_open_path str = ""
        var file_open_name str = ""
        var history List<str> = []
        var history_idx int = -1
        var can_back bool = false
        var can_forward bool = false

        // 面包屑段（父链回走生成；PLAN-023 坍缩：全链存 crumbs，视图取
        // crumbs_head + [...] + crumbs_tail 三面）
        var crumbs List<FileManagerBreadcrumb> = []
        var crumbs_head List<FileManagerBreadcrumb> = []
        var crumbs_tail List<FileManagerBreadcrumb> = []
        var crumb_gap bool = false
        var crumbs_expanded bool = false

        // 快捷访问（Tick 引导构建，exists 门控）：{ path: str, label: str, is_home: bool }
        var quick List<FileManagerShortcut> = []
        // 此电脑：可用盘符（Tick 引导探测 C..Z）：{ path: str, label: str }
        //（PLAN-016 修订 r2：用户需求——跨盘切换入口）
        var drives List<FileManagerDrive> = []

        // ---- 视图与过滤配置 ----
        var view_mode str = "list"          // "list" | "grid"
        var sort_col str = "name"           // "name" | "size" | "date" | "type"
        var sort_dir str = "asc"            // "asc" | "desc"
        var show_hidden bool = false
        var search_q str = ""
        var addr str = ""                    // 地址编辑值（Phase 2：点击面包屑区进入编辑态）
        var addr_editing bool = false
        // R7：桌面在场标记（宿主 AUTO_UI_IN_DESKTOP）——open_with 仅桌面内可达；
        // 独立窗口走系统默认程序
        var in_desktop bool = false

        // 选中与重命名
        var selected_id int = -1
        var selected_path str = ""
        var selected_name str = ""
        var selected_info str = "未选中任何项目"
        var name_dialog_open bool = false
        var name_dialog_mode str = ""
        var name_dialog_title str = ""
        var name_dialog_initial str = ""
        var name_dialog_context str = ""
        var name_dialog_directory str = ""
        var name_dialog_revision int = 0
        var name_dialog_response str = ""
        var editing_id int = -1
        var edit_name str = ""
        var rename_open bool = false
        var rename_path str = ""            // StartRename 捕获（排序后 id 会漂移）
        var new_modal_open bool = false
        var new_modal_type str = "folder"   // "folder" | "file"
        var new_modal_name str = ""

        // 右键和显式菜单按钮共同指向当前目录中的目标。
        var ctx_id int = -1
        var ctx_name str = ""

        // ---- 删除确认模态（alert-dialog）----
        var confirm_del_open bool = false
        var confirm_del_id int = -1
        var confirm_del_path str = ""       // ConfirmDelete 捕获
        var confirm_del_name str = ""
        var confirm_del_is_dir bool = false
        var confirm_del_desc str = "确定要删除选中的项目吗？"

        // ---- 剪贴板状态（真实路径）----
        var clipboard_op str = ""           // "copy" | "cut" | ""
        var clipboard_path str = ""
        var clipboard_name str = ""
        var clipboard_is_dir bool = false
        var clipboard_label str = ""

        // ---- 状态栏 ----
        var item_count_str str = "0 个项目"
        var total_size_str str = "0 B"
        var collection_revision int = 0
        var collection_token str = ""
        var navigation_error str = ""
        var mutation_notice str = ""
        var mutation_error str = ""
        var collection_columns List<CollectionColumn> = [
            {key: "name", label: "名称", align: "left", sortable: true},
            {key: "size", label: "大小", align: "right", sortable: true},
            {key: "type", label: "类型", align: "left", sortable: true},
            {key: "date", label: "修改日期", align: "left", sortable: true}
        ]

        // 渲染视图模型（NavTo 从真实目录物化；行 schema 与视图绑定一一对应）
        var files_view List<FileManagerRow> = [
            FileManagerRow {
                id: 0,
                name: "",
                path: "",
                is_dir: false,
                size: (0).to(u64),
                size_str: "",
                file_ext: "",
                type_name: "",
                date: "",
                is_hidden: false,
                thumb_src: ""
            }
        ]
    }

    computed {
        collection_items => fm_collection_items(.files_view, f"${.collection_revision}")
        listing_status => collection_status(.booting)
        empty_listing_label => collection_empty_label(.is_vm, .back_fs)
    }

    // PLAN-046 T-03：主题/模式绑定（C-14 数据绑定形态；宿主 SetTheme 回写
    // 仍作用于 dark_mode，族选择经 theme_name；同帧校验发布）。
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "w-full h-full min-h-screen flex flex-col bg-background text-foreground select-none overflow-hidden font-sans"

            // ══════════════════════════════════════════════════════════════
            // 顶部工具栏与路径条
            // ══════════════════════════════════════════════════════════════
            row {
                style: "h-14 border-b border-border px-4 flex items-center bg-card/90 shrink-0 gap-3"

                // 历史导航与路径面包屑
                row {
                    style: "items-center gap-1.5 flex-1 min-w-0"

                    // 后退
                    button (variant: "ghost", title: "后退") {
                        onclick: .GoBack
                        style: if .can_back { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center opacity-40" }
                        icon (name: "arrow-left", size: 16) {}
                    }

                    // 前进
                    button (variant: "ghost", title: "前进") {
                        onclick: .GoForward
                        style: if .can_forward { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center opacity-40" }
                        icon (name: "arrow-right", size: 16) {}
                    }

                    // 上一级
                    button (variant: "ghost", title: "上一级") {
                        onclick: .GoUp
                        style: if .current_path != "" && .current_path != .home { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center mr-2" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center mr-2 opacity-40" }
                        icon (name: "arrow-up", size: 16) {}
                    }

                    // 面包屑胶囊条（Phase 2 T-12：点击进编辑态；全按钮化
                    // 无分隔符同行对齐）
                    if .addr_editing {
                        row {
                            style: "items-center gap-1 flex-1 min-w-0"
                            input {
                                value: .addr
                                oninput: .SetAddr
                                onenter: .AddrGo
                                placeholder: "输入路径后回车..."
                                style: "flex-1 min-w-0 h-9 text-xs px-3 bg-background border border-primary rounded-lg text-foreground font-mono outline-none"
                            }
                            button (title: "跳转") {
                                onclick: .AddrGo
                                style: "h-8 w-8 shrink-0 rounded-lg text-primary hover:bg-accent flex items-center justify-center"
                                icon (name: "check", size: 15) {}
                            }
                            button (title: "取消") {
                                onclick: .AddrCancel
                                style: "h-8 w-8 shrink-0 rounded-lg text-muted-foreground hover:bg-accent flex items-center justify-center"
                                icon (name: "x", size: 15) {}
                            }
                        }
                    } else {
                        button (title: "编辑地址", onclick: .AddrEdit, style: "h-8 w-8 shrink-0 rounded-lg text-muted-foreground hover:text-foreground") {
                            icon (name: "pencil", size: 15) {}
                        }
                        // 就地展开和目录跳转各自消费点击，尾部空白用于编辑地址。
                        row {
                            style: "h-9 items-center bg-background/80 border border-border rounded-lg px-2 gap-0.5 flex-1 min-w-0 overflow-hidden"
                            for c in .crumbs_head {
                                // VM for 迭代单根元素纪律：按钮+分隔符包进行
                                // 片段（多根迭代纵向堆叠，chevron 掉行实证）
                                row {
                                    style: col_tight
                                    button (text: c.name, variant: "ghost", title: "" + c.path) {
                                        onclick: .NavTo(c.path)
                                        style: if c.is_last { "h-7 shrink-0 max-w-[10rem] truncate text-xs font-medium text-foreground px-1.5" } else { "h-7 shrink-0 max-w-[10rem] truncate text-xs text-muted-foreground px-1.5" }
                                    }
                                    text c.separator { style: dim_xs }
                                }
                            }
                            if .crumb_gap {
                                row {
                                    style: col_tight
                                    button (text: "...", variant: "ghost", title: "展开完整路径") {
                                        onclick: .CrumbsExpand
                                        style: "h-7 shrink-0 text-xs font-semibold text-primary px-1.5"
                                    }
                                    text "›" { style: dim_xs }
                                }
                            }
                            for c in .crumbs_tail {
                                row {
                                    style: col_tight
                                    button (text: c.name, variant: "ghost", title: "" + c.path) {
                                        onclick: .NavTo(c.path)
                                        style: if c.is_last { "h-7 shrink-0 max-w-[10rem] truncate text-xs font-medium text-foreground px-1.5" } else { "h-7 shrink-0 max-w-[10rem] truncate text-xs text-muted-foreground px-1.5" }
                                    }
                                    text c.separator { style: dim_xs }
                                }
                            }
                            mouse-area (onclick: .AddrEdit, style: "flex-1 h-8 min-w-2") {}
                        }
                    }
                }

                // 右侧操作区：搜索 + 视图切换 + 隐藏开关 + 新建
                row {
                    style: "items-center gap-1.5 shrink-0"

                    // 搜索框
                    input {
                        value: .search_q
                        oninput: .SetSearch
                        placeholder: "搜索当前目录..."
                        style: "w-40 text-xs px-3 py-1.5 bg-background/80 border border-border rounded-lg text-foreground outline-none placeholder:text-muted-foreground focus:border-primary"
                    }


                    // 隐藏文件开关（icon-only + tooltip；Phase 2 T-13）
                    button (title: "显示/隐藏隐藏项") {
                        onclick: .ToggleHidden
                        style: if .show_hidden { "h-8 w-8 shrink-0 rounded-lg bg-accent text-primary border border-primary/50 flex items-center justify-center" } else { "h-8 w-8 shrink-0 rounded-lg text-muted-foreground hover:text-foreground flex items-center justify-center" }
                        if .show_hidden {
                            icon (name: "eye", size: 15) {}
                        } else {
                            icon (name: "eye-off", size: 15) {}
                        }
                    }

                    // 新建文件夹（icon-only + tooltip；Phase 2 T-13）
                    button (title: "新建文件夹") {
                        onclick: .NewFolderOpen
                        style: "h-8 w-8 shrink-0 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent border border-border flex items-center justify-center"
                        icon (name: "folder-plus", size: 16) {}
                    }

                    // 新建文件（icon-only + tooltip）
                    button (title: "新建文件") {
                        onclick: .NewFileOpen
                        style: "h-8 w-8 shrink-0 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 flex items-center justify-center"
                        icon (name: "file-plus", size: 16) {}
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 主体区：左侧栏 + 右内容区
            // ══════════════════════════════════════════════════════════════
            row {
                style: "flex-1 min-h-0 flex"

                // ---- 左侧导航栏（Sidebar 组件族；PLAN-016 用户反馈换装——
                // 手搓 button 列退役。015-notes NavTree 同款形态）----
                sidebar_provider (class: "min-h-0 w-auto shrink-0") {
                    col {
                        style: "w-56 h-full flex flex-col overflow-hidden bg-card border-r border-border"

                        sidebar_content (style: "px-2 pb-2") {
                            sidebar_group {
                                sidebar_group_label { text "快速访问" }
                                sidebar_group_content {
                                    sidebar_menu {
                                        for q in .quick {
                                            sidebar_menu_item {
                                                sidebar_menu_button (active: .current_path == q.path) {
                                                    onclick: .NavTo(q.path)
                                                    if q.is_home {
                                                        icon (name: "home", size: 15) {}
                                                    } else {
                                                        if q.label == "桌面" {
                                                            icon (name: "monitor", size: 15) {}
                                                        } else {
                                                            if q.label == "文档" {
                                                                icon (name: "file-text", size: 15) {}
                                                            } else {
                                                                if q.label == "下载" {
                                                                    icon (name: "download", size: 15) {}
                                                                } else {
                                                                    if q.label == "图片" {
                                                                        icon (name: "image", size: 15) {}
                                                                    } else {
                                                                        if q.label == "音乐" {
                                                                            icon (name: "music", size: 15) {}
                                                                        } else {
                                                                            icon (name: "folder", size: 15) {}
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    text q.label { style: "text-sm" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            sidebar_group {
                                sidebar_group_label { text "此电脑" }
                                sidebar_group_content {
                                    sidebar_menu {
                                        for d in .drives {
                                            sidebar_menu_item {
                                                sidebar_menu_button (active: .current_path == d.path) {
                                                    onclick: .NavTo(d.path)
                                                    icon (name: "hard-drive", size: 15) {}
                                                    text d.label { style: "text-xs" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 目录与业务操作仍由应用持有，网格与明细共用当前结果。
                col (style: "flex-1 min-w-0 min-h-0 bg-background") {
                    if .ctx_id >= 0 {
                        row (style: "w-full items-center gap-1 px-2 py-1 border-b border-border bg-card") {
                            text .ctx_name { style: "flex-1 min-w-0 text-xs truncate" }
                            button (text: "打开", onclick: .CtxOpen, style: "h-7 px-2 text-xs") {}
                            button (text: "重命名", onclick: .CtxRename, style: "h-7 px-2 text-xs") {}
                            button (text: "复制", onclick: .CtxCopy, style: "h-7 px-2 text-xs") {}
                            button (text: "剪切", onclick: .CtxCut, style: "h-7 px-2 text-xs") {}
                            button (text: "删除", onclick: .CtxDelete, style: "h-7 px-2 text-xs text-destructive") {}
                            button (text: "关闭菜单", onclick: .CtxClose, style: "h-7 px-2 text-xs") {}
                        }
                    }
                    CollectionView (
                        items: .collection_items, columns: .collection_columns,
                        viewMode: .view_mode, selectedId: .selected_path, scopeId: .current_path,
                        revision: .collection_revision, sortKey: .sort_col, sortDirection: .sort_dir,
                        status: .listing_status, emptyLabel: .empty_listing_label,
                        onviewModeRequested: .CollectionMode($event),
                        onselectionRequested: .CollectionSelection($event),
                        onitemActionRequested: .CollectionAction($event),
                        onsortRequested: .CollectionSort($event)
                    ) {}
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 底部状态栏
            // ══════════════════════════════════════════════════════════════
            row {
                style: "h-9 border-t border-border px-4 items-center justify-between text-xs text-muted-foreground bg-card/80 shrink-0 select-none"
                row {
                    style: row_gap3
                    text .item_count_str { style: "font-medium text-foreground" }
                    text "|" { style: "text-border" }
                    text .total_size_str { style: "font-mono" }
                }

                row {
                    style: row_gap3
                    if .clipboard_name != "" {
                        text .clipboard_label {
                            style: "text-primary font-medium text-[11px]"
                        }
                        button (text: "粘贴到此处", variant: "ghost") {
                            onclick: .CtxPaste
                            style: "text-xs px-2 py-0.5 rounded bg-primary/20 text-primary font-semibold hover:bg-primary/30"
                        }
                        text "|" { style: "text-border" }
                    }
                    text .selected_info { style: "text-foreground" }
                    if .navigation_error != "" {
                        text .navigation_error { style: "text-destructive" }
                    }
                    if .mutation_error != "" {
                        text .mutation_error { style: "text-destructive" }
                    }
                    if .mutation_notice != "" {
                        text .mutation_notice { style: "text-muted-foreground" }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 模态弹层（PLAN-016 T-03：alert-dialog，025-sys-monitor 形态）
            // ══════════════════════════════════════════════════════════════

            if Env.track() == "vm" || Env.track() == "vue" {
                PromptDialog (open: .name_dialog_open, contextId: .name_dialog_context, revision: .name_dialog_revision,
                    title: .name_dialog_title,
                    description: if .name_dialog_mode == "rename" { "输入选中项目的新名称。" } else { "在当前目录下创建一个项目。" },
                    label: "名称", placeholder: "请输入名称",
                    acceptLabel: if .name_dialog_mode == "rename" { "重命名" } else { "创建" },
                    initialValue: .name_dialog_initial, response: .name_dialog_response,
                    errorMessage: if .is_vm == "vm" { "" } else { "写操作仅在 VM 轨可用" },
                    onsubmitRequested: .CommitName, oncancelled: .CancelName) {}
            } else {
                // 1. 新建文件/文件夹
                alert-dialog (open: .new_modal_open) {
                    alert-dialog-content {
                        alert-dialog-header {
                            if .new_modal_type == "folder" {
                                alert-dialog-title "新建文件夹"
                                alert-dialog-description "在当前目录下创建一个新的子文件夹"
                            } else {
                                alert-dialog-title "新建文件"
                                alert-dialog-description "在当前目录下创建一个新的空文件"
                            }
                        }
                        input {
                            value: .new_modal_name
                            oninput: .SetNewName
                            onenter: .CommitNew
                            placeholder: "请输入名称..."
                            style: search_input
                        }
                        alert-dialog-footer {
                            alert-dialog-cancel "取消" { onclick: .NewModalClose }
                            alert-dialog-action "创建" { onclick: .CommitNew }
                        }
                    }
                }

                // 2. 重命名
                alert-dialog (open: .rename_open) {
                    alert-dialog-content {
                        alert-dialog-header {
                            alert-dialog-title "重命名"
                            alert-dialog-description f"将「${.selected_name}」重命名为："
                        }
                        input {
                            value: .edit_name
                            oninput: .SetEditName
                            onenter: .CommitRename
                            placeholder: "请输入新名称..."
                            style: search_input
                        }
                        alert-dialog-footer {
                            alert-dialog-cancel "取消" { onclick: .CancelRename }
                            alert-dialog-action "重命名" { onclick: .CommitRename }
                        }
                    }
                }
            }

            // 3. 删除确认
            alert-dialog (open: .confirm_del_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "确认删除项目？"
                        alert-dialog-description .confirm_del_desc
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CancelDelete }
                        alert-dialog-action "确认删除" { onclick: .ExecuteDelete }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // The compatibility VM reads its home directly. Checked hosts
            // publish the granted root through the file session.
            if Env.track() == "vm" {
                .is_vm = "vm"
                .home = Env.get("USERPROFILE")
                if .home == "" {
                    .home = Env.get("HOME")
                }
                .in_desktop = Env.get("AUTO_UI_IN_DESKTOP") != ""
            }
        }

        .RestoreViewMode(value str) -> {
            let saved str = value.to(str)
            if saved == "grid" || saved == "list" { .view_mode = value }
        }

        .RestoreSortColumn(value str) -> {
            let saved str = value.to(str)
            if saved == "name" || saved == "size" || saved == "date" || saved == "type" {
                .sort_col = value
            }
        }

        .RestoreSortDirection(value str) -> {
            let saved str = value.to(str)
            if saved == "asc" || saved == "desc" { .sort_dir = value }
        }

        .RestoreHidden(value str) -> {
            let saved str = value.to(str)
            if saved == "true" { .show_hidden = true }
            if saved == "false" { .show_hidden = false }
        }

        // 启动完成后取消订阅，后续媒体刷新由现有图片管线唤醒。
        .BootTick -> {
            let was_booting bool = .booting
            .AdvanceBoot()
            if Env.track() == "vm" {
                if was_booting && !.booting {
                    if .home != "" {
                        .quick = native_shortcuts(.home)
                        .drives = native_drives()
                        .NavTo(.home)
                    } else {
                        .navigation_error = "无法定位主目录（USERPROFILE/HOME 均为空）"
                    }
                }
            }
        }

        .ShowOfflineDemo -> {
            .file_request_pending = false
            .file_request_startup = false
            .home = "demo://home"
            .current_path = "demo://home"
            .addr = "demo://home"
            .quick = offline_shortcuts()
            .files_view = offline_rows()
            .PublishCollection()
            .item_count_str = "6 个项目"
            .total_size_str = "1.2 MB"
        }

        .DirectoryRootOpened(root_path str) -> {
            if root_path == "" {
                .ShowOfflineDemo()
            } else {
                .home = root_path
                .back_fs = true
                .quick = root_shortcuts(root_path)
                .drives = directory_roots(root_path)
            }
        }

        .AdvanceBoot -> {
            if .booting {
                .tick_count = .tick_count + 1
                if .tick_count > 8 {
                    .booting = false
                    if Env.track() != "vm" {
                        .RequestDirectory("", -1, true)
                    }
                }
            }
        }

        // ---- 目录导航（真实 FS；T-05）----
        .NavTo(target_path) -> {
            .Navigate(target_path, -1)
        }

        .Navigate(target_path str, history_index int) -> {
            if Env.track() == "vm" {
                .file_request_revision = .file_request_revision + 1
                let canonical str = fs.canonical(target_path)
                if canonical == "" {
                    .navigation_error = "无法打开: " + target_path
                } else if !file.is_dir(canonical) {
                    .navigation_error = "不是目录: " + canonical
                } else {
                    let prepared = native_listing(canonical, .search_q, .show_hidden, .sort_col, .sort_dir)
                    .navigation_error = ""
                    .CommitDirectoryPath(canonical, history_index)
                    .files_view = prepared.rows
                    .item_count_str = file_count_label(.files_view.len(), prepared.truncated)
                    .PublishCollection()
                    .total_size_str = prepared.total_size
                }
            } else {
                .NavigateInSession(target_path, history_index)
            }
        }

        .NavigateInSession(target_path str, history_index int) -> {
            if .back_fs && !target_path.contains("demo://") {
                .RequestDirectory(target_path, history_index, false)
            } else {
                .file_request_revision = .file_request_revision + 1
                .file_request_pending = false
                .file_request_startup = false
            }
        }

        .RequestDirectory(requested_path str, requested_index int, startup bool) -> {
            .navigation_error = ""
            .file_request_revision = .file_request_revision + 1
            .file_request_path = requested_path
            .file_request_history_index = requested_index
            .file_request_startup = startup
            .file_request_pending = true
        }

        .RequestMutation(operation str, source str, target str, label str, move_clipboard bool) -> {
            if !.file_mutation_pending {
                .mutation_notice = ""
                .mutation_error = ""
                if (!.back_fs && .is_vm != "vm") || .current_path == "" {
                    .mutation_error = "文件会话未授权"
                } else if source == "" || ((operation == "rename" || operation == "copy") && target == "") {
                    .mutation_error = "无效的文件名"
                } else {
                    .file_mutation_operation = operation
                    .file_mutation_path = source
                    .file_mutation_target = target
                    .file_mutation_label = label
                    .file_mutation_move = move_clipboard
                    .file_mutation_view_revision = .file_request_revision
                    .file_mutation_pending = true
                    if Env.track() == "vm" {
                        let result str = native_file_mutation(operation, source, target)
                        .MutationApplied(result == "")
                        if result == "exists" {
                            .mutation_error = "已存在同名项目: " + label
                        }
                        if result == "not-empty" {
                            .mutation_error = "目录非空，仅支持删除空目录: " + label
                        }
                    }
                }
            }
        }

        .MutationApplied(ok bool) -> {
            if .file_mutation_pending {
                .file_mutation_pending = false
                if ok {
                    .mutation_notice = "操作完成: " + .file_mutation_label
                    if .file_mutation_move && .clipboard_op == "cut" && .clipboard_path == .file_mutation_path {
                        .clipboard_op = ""
                        .clipboard_path = ""
                        .clipboard_name = ""
                        .clipboard_is_dir = false
                        .clipboard_label = ""
                    }
                    if .file_mutation_view_revision == .file_request_revision && !.file_request_pending {
                        if Env.track() == "vm" {
                            .Navigate(.current_path, .history_idx)
                        } else {
                            .RequestDirectory(.current_path, .history_idx, false)
                        }
                    }
                } else {
                    .mutation_error = "文件操作失败: " + .file_mutation_label
                }
            }
        }

        .DirectoryListed(listing DirListing) -> {
            if .file_request_pending {
                let requested_index int = .file_request_history_index
                let startup bool = .file_request_startup
                .file_request_pending = false
                .file_request_startup = false
                if listing.ok {
                    if startup {
                        let root_path = "" + listing.path
                        .home = root_path
                        .back_fs = true
                        .quick = directory_shortcuts(root_path.to(str), listing.entries)
                        .drives = directory_roots(root_path.to(str))
                    }
                    .CommitDirectoryPath(listing.path, requested_index)
                    let prepared = prepare_file_listing(listing.entries, .search_q, .show_hidden, .sort_col, .sort_dir)
                    .files_view = prepared.rows
                    .item_count_str = file_count_label(.files_view.len(), prepared.truncated)
                    .PublishCollection()
                    .total_size_str = prepared.total_size
                } else {
                    if startup {
                        .navigation_error = "无法打开授权目录"
                    } else {
                        .navigation_error = "无法打开: " + .file_request_path
                    }
                }
            }
        }

        // 文件会话确认可读后，一次提交路径、面包屑、选中状态和历史。
        .CommitDirectoryPath(path str, history_index int) -> {
            if .current_path != path { .selected_path = "" }
            .current_path = path
            .addr = path
            .selected_id = -1
            .selected_name = ""
            .selected_info = "未选中任何项目"
            .editing_id = -1
            .ctx_id = -1
            .crumbs_expanded = false
            .crumbs = build_crumbs(path)
            let count int = .crumbs.len()
            .crumb_gap = count > 5
            if .crumb_gap {
                .crumbs_head = slice_crumbs(.crumbs, 0, 1)
                .crumbs_tail = slice_crumbs(.crumbs, count - 2, count)
            } else {
                .crumbs_head = slice_crumbs(.crumbs, 0, count)
                .crumbs_tail = []
            }
            .CommitNavigation(path, history_index)
        }

        // 只有目录读取成功才提交历史索引及可用方向。
        .CommitNavigation(path str, history_index int) -> {
            if history_index >= 0 {
                .history_idx = history_index
            } else if .history_idx < 0 || .history[.history_idx] != path {
                .history = extend_history(.history, .history_idx, path)
                .history_idx = .history.len() - 1
            }
            .can_back = .history_idx > 0
            .can_forward = .history_idx + 1 < .history.len()
        }

        .GoBack -> {
            if .history_idx > 0 {
                let index int = .history_idx - 1
                .Navigate(.history[index], index)
            }
        }

        .GoForward -> {
            let index int = .history_idx + 1
            if index < .history.len() {
                .Navigate(.history[index], index)
            }
        }

        .GoUp -> {
            if .current_path != .home {
                let up str = parent_of(.current_path)
                if up != "" {
                    .NavTo(up)
                }
            }
        }

        // 校验 CollectionView 的 JSON 请求所属目录、结果代次和实例，再按路径定位当前行。
        .CollectionMode(payload str) -> {
            let token Str = collection_request_token(payload, .current_path, .collection_revision, .collection_token)
            if token.len() > 0 {
                let mode Str = json_object_text(payload, "viewMode", "")
                if mode == "grid" || mode == "list" {
                    .collection_token = token
                    .SetViewMode(mode)
                }
            }
        }

        .CollectionSort(payload str) -> {
            let token Str = collection_request_token(payload, .current_path, .collection_revision, .collection_token)
            if token.len() > 0 {
                let key Str = json_object_text(payload, "sortKey", "")
                .collection_token = token
                if key == "name" { .SortByName() }
                if key == "size" { .SortBySize() }
                if key == "type" { .SortByType() }
                if key == "date" { .SortByDate() }
            }
        }

        .CollectionSelection(payload str) -> { .CollectionItem(payload, false) }
        .CollectionAction(payload str) -> { .CollectionItem(payload, true) }

        .CollectionItem(payload str, is_action bool) -> {
            let token Str = collection_request_token(payload, .current_path, .collection_revision, .collection_token)
            if token.len() > 0 {
                let item_revision Str = json_object_text(payload, "itemRevision", "")
                let current_revision Str = f"${.collection_revision}"
                if item_revision == current_revision {
                    let requested_path Str = json_object_text(payload, "id", "")
                    let index = fm_path_index(.files_view, requested_path.to(str))
                    if index >= 0 {
                        .collection_token = token
                        if !is_action {
                            .SelectItem(index)
                        } else {
                            let action Str = json_object_text(payload, "actionId", "")
                            if action == "open" { .OpenItem(index) }
                            if action == "menu" { .ItemCtx(index) }
                        }
                    }
                }
            }
        }

        .PublishCollection -> {
            .collection_revision = .collection_revision + 1
            .SelectItem(fm_path_index(.files_view, .selected_path))
        }

        // ---- 视图与排序 ----
        .SetViewMode(mode) -> {
            .view_mode = mode
        }

        .SortByName -> {
            if .sort_col == "name" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "name"
                .sort_dir = "asc"
            }
            .NavTo(.current_path)
        }

        .SortBySize -> {
            if .sort_col == "size" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "size"
                .sort_dir = "asc"
            }
            .NavTo(.current_path)
        }

        .SortByDate -> {
            if .sort_col == "date" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "date"
                .sort_dir = "asc"
            }
            .NavTo(.current_path)
        }

        .SortByType -> {
            if .sort_col == "type" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "type"
                .sort_dir = "asc"
            }
            .NavTo(.current_path)
        }

        .ToggleHidden -> {
            .show_hidden = !.show_hidden
            .NavTo(.current_path)
        }

        .SetSearch(q) -> {
            .search_q = q
            .NavTo(.current_path)
        }

        // ---- 地址栏（T-05：可编辑回车跳转）----
        .SetAddr(v) -> {
            .addr = v
        }

        .AddrGo -> {
            .addr_editing = false
            if .addr != "" {
                .NavTo(.addr)
            }
        }

        // ---- 地址编辑态（Phase 2 T-12：点击面包屑区进入）----
        .AddrEdit -> {
            .addr = .current_path
            .addr_editing = true
        }

        .AddrCancel -> {
            .addr_editing = false
        }

        // ---- PLAN-023：地址栏 "..." 就地展开全链（不导航；导航后重回坍缩态）----
        .CrumbsExpand -> {
            .crumbs_expanded = true
            .crumbs_head = slice_crumbs(.crumbs, 0, .crumbs.len())
            .crumbs_tail = []
            .crumb_gap = false
        }

        // ---- 选中与打开 ----
        .SelectItem(id) -> {
            .selected_id = id
            var n int = .files_view.len()
            if id >= 0 && id < n {
                .selected_path = "" + .files_view[id].path
                .selected_name = "" + .files_view[id].name
                .selected_info = "选定: " + .selected_name + " (" + .files_view[id].size_str + ")"
            } else {
                .selected_path = ""
                .selected_name = ""
                .selected_info = "未选中任何项目"
            }
        }

        .OpenItem(id int) -> {
            .SelectItem(id)
            if id >= 0 && id < .files_view.len() {
                let r = .files_view[id]
                if r.is_dir {
                    .NavTo(r.path)
                } else {
                    .mutation_error = ""
                    .mutation_notice = ""
                    if Env.track() != "vm" {
                        .file_open_path = "" + r.path
                        .file_open_name = "" + r.name
                        .file_open_pending = true
                    } else {
                        let app str = app_for_ext(r.file_ext)
                        if app != "" && .in_desktop {
                            .__desktop_cmd = "open_with\t" + app + "\t" + r.path
                            .mutation_notice = "正在打开: " + r.name
                        } else {
                            let opened bool = native_open_default(r.path)
                            if opened {
                                .mutation_notice = "已调用系统默认程序打开: " + r.name
                            } else {
                                .mutation_error = "无法打开: " + r.name
                            }
                        }
                    }
                }
            }
        }

        .FileOpened(status int) -> {
            if .file_open_pending {
                .file_open_pending = false
                .file_open_path = ""
                if status == 1 {
                    .mutation_notice = "已调用系统默认程序打开: " + .file_open_name
                } else if status == 0 {
                    .mutation_notice = "文件打开仅在桌面可用 — 请使用 auto run -r vm"
                } else {
                    .mutation_error = "无法打开: " + .file_open_name
                }
                .file_open_name = ""
            }
        }

        // ---- 重命名（alert-dialog 模态；T-06 真实 fs.rename）----
        .StartRename(id) -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                if id >= 0 && id < .files_view.len() {
                    let item = .files_view[id]
                    .selected_name = item.name
                    .BeginName("rename", item.path, item.name)
                }
            } else {
                if id >= 0 && id < .files_view.len() {
                    let r = .files_view[id]
                    .editing_id = id
                    .edit_name = r.name
                    .rename_path = r.path
                    .selected_name = r.name
                    .rename_open = true
                }
            }
        }

        .BeginName(mode, context, initial) -> {
            .name_dialog_mode = mode
            if mode == "rename" {
                .name_dialog_title = "重命名"
            } else if mode == "folder" {
                .name_dialog_title = "新建文件夹"
            } else {
                .name_dialog_title = "新建文件"
            }
            .name_dialog_context = context
            .name_dialog_directory = .current_path
            .name_dialog_initial = initial
            .name_dialog_revision = .name_dialog_revision + 1
            .name_dialog_response = ""
            .name_dialog_open = true
        }

        .CommitName(payload) -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                let request = json.parse(payload)
                if .name_dialog_open && request.contextId == .name_dialog_context && request.baseRevision == .name_dialog_revision {
                    let name str = request.value
                    let target str = .name_dialog_context
                    var problem str = ""
                    var retryable bool = false
                    if .is_vm != "vm" {
                        problem = "写操作仅在 VM 轨可用"
                    } else if .name_dialog_directory != .current_path || !file.exists(target) {
                        problem = "项目或目录已变化，请关闭对话框后重新选择"
                    } else if !valid_entry_name(name) {
                        problem = "请输入有效的文件或文件夹名称"
                    } else {
                        let destination str = fs.join(.name_dialog_directory, name)
                        if .name_dialog_mode != "rename" || destination != target {
                            if file.exists(destination) {
                                problem = "已存在同名项目: " + name
                            } else {
                                var result str = ""
                                if .name_dialog_mode == "rename" {
                                    result = native_file_mutation("rename", target, destination)
                                } else if .name_dialog_mode == "folder" {
                                    result = native_file_mutation("create-directory", destination, "")
                                } else {
                                    result = native_file_mutation("create-file", destination, "")
                                }
                                if result == "exists" {
                                    problem = "已存在同名项目: " + name
                                } else if result != "" {
                                    problem = "操作失败，请检查名称、权限或项目是否正在使用"
                                    retryable = true
                                }
                            }
                        }
                    }
                    var status str = "rejected"
                    if problem == "" {
                        status = "accepted"
                    }
                    .name_dialog_response = json.stringify({
                        instanceToken: request.instanceToken, session: request.session, seq: request.seq,
                        contextId: request.contextId, status: status,
                        message: problem, retryable: retryable
                    })
                    if problem == "" {
                        .name_dialog_open = false
                        .name_dialog_revision = .name_dialog_revision + 1
                        .NavTo(.current_path)
                    }
                }
            }
        }

        .CancelName(payload) -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                let request = json.parse(payload)
                if .name_dialog_open && request.contextId == .name_dialog_context && request.baseRevision == .name_dialog_revision {
                    .name_dialog_open = false
                }
            }
        }

        // ---- 条目菜单 ----
        .SetEditName(name) -> {
            .edit_name = name
        }

        .CommitRename -> {
            let old_path Str = "" + .rename_path
            .rename_open = false
            if .editing_id >= 0 && old_path != "" {
                let target_path Str = child_path(.current_path, .edit_name)
                if target_path != old_path {
                    .RequestMutation("rename", old_path, target_path, .edit_name, false)
                }
            }
            .editing_id = -1
            .rename_path = ""
        }

        .CancelRename -> {
            .editing_id = -1
            .rename_path = ""
            .rename_open = false
        }

        // ---- 条目菜单 ----
        .ItemCtx(id) -> {
            if id >= 0 && id < .files_view.len() {
                .ctx_id = id
                .ctx_name = .files_view[id].name
            }
        }

        .CtxClose -> {
            .ctx_id = -1
        }

        .CtxOpen -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .OpenItem(target)
            }
        }

        .CtxRename -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .StartRename(target)
            }
        }

        .CtxCopy -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 && target < .files_view.len() {
                let r = .files_view[target]
                .clipboard_op = "copy"
                .clipboard_path = r.path
                .clipboard_name = r.name
                .clipboard_is_dir = r.is_dir
                .clipboard_label = "已复制: " + r.name
            }
        }

        .CtxCut -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 && target < .files_view.len() {
                let r = .files_view[target]
                .clipboard_op = "cut"
                .clipboard_path = r.path
                .clipboard_name = r.name
                .clipboard_is_dir = r.is_dir
                .clipboard_label = "已剪切: " + r.name
            }
        }

        .CtxPaste -> {
            .ctx_id = -1
            if .clipboard_path != "" {
                let destination Str = child_path(.current_path, .clipboard_name)
                if .clipboard_op == "copy" {
                    .RequestMutation("copy", .clipboard_path, destination, .clipboard_name, false)
                } else if .clipboard_op == "cut" {
                    .RequestMutation("rename", .clipboard_path, destination, .clipboard_name, true)
                }
            }
        }

        .CtxDelete -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .ConfirmDelete(target)
            }
        }

        .NewFolderOpen -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                .BeginName("folder", .current_path, "新建文件夹")
            } else {
                .new_modal_type = "folder"
                .new_modal_name = "新建文件夹"
                .new_modal_open = true
            }
        }

        .NewFileOpen -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                .BeginName("file", .current_path, "新建文档.txt")
            } else {
                .new_modal_type = "file"
                .new_modal_name = "新建文档.txt"
                .new_modal_open = true
            }
        }

        .NewModalClose -> {
            .new_modal_open = false
        }

        .SetNewName(name) -> {
            .new_modal_name = name
        }

        .CommitNew -> {
            let name Str = "" + .new_modal_name
            .new_modal_open = false
            let target_path Str = child_path(.current_path, name.to(str))
            if .new_modal_type == "folder" {
                .RequestMutation("create-directory", target_path, "", name, false)
            } else {
                .RequestMutation("create-file", target_path, "", name, false)
            }
        }

        // ---- 删除确认（T-06；D-4 口径：文件 + 空目录，非空目录拒绝）----
        .ConfirmDelete(id) -> {
            if id >= 0 && id < .files_view.len() {
                let r = .files_view[id]
                .confirm_del_id = id
                .confirm_del_path = r.path
                .confirm_del_name = r.name
                .confirm_del_is_dir = r.is_dir
                .confirm_del_desc = "确定要永久删除「" + r.name + "」吗？此操作不可撤销。"
                .confirm_del_open = true
            }
        }

        .ExecuteDelete -> {
            let del_path Str = "" + .confirm_del_path
            let del_name Str = "" + .confirm_del_name
            let is_dir_target bool = .confirm_del_is_dir
            .confirm_del_open = false
            .confirm_del_id = -1
            .confirm_del_path = ""
            if del_path != "" {
                if is_dir_target {
                    .RequestMutation("delete-directory", del_path, "", del_name, false)
                } else {
                    .RequestMutation("delete-file", del_path, "", del_name, false)
                }
            }
        }

        .CancelDelete -> {
            .confirm_del_open = false
            .confirm_del_id = -1
            .confirm_del_path = ""
        }

    }
}
