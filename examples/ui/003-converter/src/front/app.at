// front/app.at — Temperature Converter.
// PLAN-637 Phase A：重复 class 串提取为本地配方（展开后与原串逐字节等价，
// 双端零漂移）。两串各仅 ×2 且与共享库形态不合（变体纪律，r2：不跨串合并），
// 留本地不升库。全 demo 无调色板色，Phase B 无事。

// 字段列（输入列容器，×2）
style field_col = "flex-1 gap-1.5"
// 字段标签（×2）
style field_label = "text-sm font-medium text-muted-foreground"

// PLAN-031 T-06：003-converter 接入官方主题包（第二批验收，§4.3）。
// 主题/模式经 design 块数据绑定（独立默认 Auto/light）；两向换算业务、
// 字段身份与已声明的 pac `desktop_render: "remote"` 支持面不变。
// 换族/换模式走受控 host 输入（V-07）或 App 状态，不在本 App 内新增业务。
use themes.themes: Auto, Solarized

widget App {
    model {
        var celsius double = 0.0
        var fahrenheit double = 32.0
        // 主题选择（默认 Auto/light；显式 host override 见 UI 宿主端口）
        var theme_name str = "Auto"
        var dark_mode bool = false
    }

    // 主题/模式选择器（C-06/07：数据绑定，同帧校验发布）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    // Plan 506: 外壳改"内容即页面"（无 center 包裹，循 011 样板），配合
    // pac `window: "fit"` 窗口随内容收缩。
    view {
        col {
            // mx-auto: 画廊视口内居中卡片(iced 端 Fill+max-w 不参与父级
            // items-center,须自带 auto 边距;fit 窗口下 auto 边距自然归零)
            style: "max-w-md p-8 bg-card border rounded-2xl shadow-sm mx-auto"

            text "Temperature Converter" {
                style: "text-2xl font-bold text-primary text-center mb-6"
            }

            row {
                style: "gap-4"

                col {
                    style: field_col
                    text "Celsius (°C)" {
                        style: field_label
                    }
                    input (value: .celsius) {
                        oninput: () => {.fahrenheit = math.round((.celsius * 9.0 / 5.0 + 32.0) * 100.0) / 100.0}
                        placeholder: "0"
                    }
                }

                col {
                    style: field_col
                    text "Fahrenheit (°F)" {
                        style: field_label
                    }
                    input (value: .fahrenheit) {
                        oninput: () => {.celsius = math.round((.fahrenheit - 32.0) * 5.0 / 9.0 * 100.0) / 100.0}
                        placeholder: "32"
                    }
                }
            }

            text "°F = °C × 9/5 + 32" {
                style: "text-xs text-muted-foreground text-center mt-6"
            }
        }
    }
}
