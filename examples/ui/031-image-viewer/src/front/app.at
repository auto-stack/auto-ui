// 031-image-viewer front UI (Plan 547 Tasks 29 and 33).
// The model is metadata and transform state only; pixels stay behind the
// shared media route and ImageSurface renderer.
use auto.json
use back.api: open_file, open_directory, current_uri, names, request_view, close_session, image_stats, navigate

use stylekit.styles: caption_text

// PLAN-046 T-03：接入官方主题包（Auto/Solarized 两族经 theme_name + design
// 绑定；模式由 dark_mode 承担，首帧 true = pac 显式 theme: "dark" 默认保留）。
// 会话/URI/视图 revision/媒体管线业务零改动——换肤不重建 session。
use themes.themes: Auto, Solarized

style ctrl_size = "w-8 h-7"
style tool_sm = "px-2.5 py-1.5 text-xs"
style tool_xs = "px-2 text-xs"
style caption_sm = "text-sm text-muted-foreground"
style stage_row = "items-center justify-center gap-2"
style content_col = "flex-1 min-h-0"

widget App {
    // PLAN-089：查看区消费正式包（widget 内 use；局部 shadow 已移除；
    // media 会话/索引/导航业务仍归本应用与 back 服务）。
    use { package: image_viewer from "../../../../../packages/image-viewer" }
    msg {
        Init,
        OpenFile,
        OpenDirectory,
        SelectImage(int),
        RefreshStats,
        ToggleFullscreen,
        ImageLoaded(str),
        ImageError(str),
        ApplyView(str),
        DoNavigate(str),
        SettleTick,
        Close
    }

    model {
        var view_state str = "empty"
        var status str = "Open a file or directory to begin"
        var stats str = ""
        var session_id str = ""
        var media_src str = ""
        var media_alt str = ""
        var selected_name str = ""
        var selected_path str = ""
        var image_count int = 0
        var selected_index int = 0
        var zoom float = 1.0
        var offset_x float = 0.0
        var offset_y float = 0.0
        var rotation int = 0
        var fit_mode str = "contain"
        var is_fullscreen bool = false
        var revision int = 0
        // PLAN-089：媒体资源修订（换图即增；组件按 (resourceId, resourceRevision)
        // 判定换代并捕获该图初始基线）。
        var media_rev str = "0"
        var media_rev_seq int = 0
        // PLAN-016 T-08：桌面 open_with 接收面（host write_state 写路径，
        // SettleTick 消费一次；open_consumed 防重放）。
        var auto_open_path str = ""
        var auto_open_consumed str = "__none__"
        // PLAN-046 T-03：主题族/模式选择态（主题选择，非业务状态；
        // 显式 dark 默认与 pac theme: "dark" 一致，C-14 保留）。
        var theme_name str = "Auto"
        var dark_mode bool = true
        var thumbnails = [
            { id: 0, name: "No images", src: "" }
        ]
    }

    // PLAN-046 T-03：主题/模式绑定（C-14 数据绑定形态；同帧校验发布）。
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    timer {
        SettleTick (every_ms: 80)
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden"
            row {
                style: "h-12 shrink-0 items-center justify-between px-4 border-b border-border bg-card"
                row {
                    style: "items-center gap-2"
                    text "🖼️" { style: "text-lg" }
                    h1 "Image Viewer" { style: "text-lg font-semibold" }
                    text .status { style: "text-xs text-muted-foreground ml-2 truncate max-w-sm" }
                }
                row {
                    style: "items-center gap-1"
                    button "Open File" { onclick: .OpenFile, style: tool_sm }
                    button "Open Directory" { onclick: .OpenDirectory, style: tool_sm }
                    button "Fullscreen" { onclick: .ToggleFullscreen, style: tool_sm }
                        button "Stats" { onclick: .RefreshStats, style: tool_sm }
                }
            }

            row {
                style: content_col
                col {
                    style: "w-52 shrink-0 border-r border-border bg-card p-3 gap-2 overflow-hidden"
                    row {
                        style: "items-center justify-between"
                        text "Images" { style: "text-xs font-semibold" }
                        text .image_count { style: caption_text }
                    }
                    if .image_count == 0 {
                        text "No images yet" { style: "text-xs text-muted-foreground p-2" }
                    } else {
                        col {
                            style: content_col
                            col {
                                style: "gap-1"
                                for item in .thumbnails {
                                    button item.name {
                                        onclick: .SelectImage(item.id),
                                        style: "w-full text-left px-2 py-1.5 text-xs rounded hover:bg-muted"
                                    }
                                }
                            }
                        }
                    }
                }

                col {
                    style: "flex-1 min-w-0 min-h-0"
                    // PLAN-089：变换/导航工具栏由 ImageViewport 自带（受控请求
                    // 经 ApplyView 接受；收藏/目录/会话业务仍归本应用）。
                    col {
                        style: "flex-1 min-h-0 items-center justify-center p-3 bg-muted/20"
                        if .view_state == "empty" {
                            col {
                                style: stage_row
                                text "🖼️" { style: "text-5xl opacity-40" }
                                text "Choose an image file or directory" { style: caption_sm }
                            }
                        } else if .view_state == "loading" {
                            text "Loading image…" { style: caption_sm }
                        } else if .view_state == "error" {
                            col {
                                style: stage_row
                                text "Unable to load image" { style: "text-sm text-destructive" }
                                button "Retry" { onclick: .OpenFile, style: "px-3 py-1.5 text-xs" }
                            }
                        } else {
                            ImageViewport (
                                src: .media_src,
                                alt: .media_alt,
                                resourceId: .selected_name,
                                resourceRevision: .media_rev,
                                revision: .revision,
                                fit: .fit_mode,
                                zoom: .zoom,
                                offsetX: .offset_x,
                                offsetY: .offset_y,
                                rotation: .rotation,
                                canPrevious: .selected_index > 0,
                                canNext: .selected_index + 1 < .image_count,
                                onviewRequested: .ApplyView($event),
                                onloaded: .ImageLoaded($event),
                                onerror: .ImageError($event),
                                onnavigateRequested: .DoNavigate($event)
                            ) {}
                        }
                    }

                    row {
                        style: "h-9 shrink-0 items-center justify-between px-3 border-t border-border bg-card"
                        text .selected_name { style: "text-xs font-medium truncate" }
                        text .selected_path { style: "text-[11px] text-muted-foreground truncate max-w-md" }
                    }
                }
            }
        }
    }

    // PLAN-089：变换类快捷键随工具栏迁入组件（v1 无外部动作通道，工具栏
    // 按钮/MCP 即操作面）；本应用仅保留应用级键。
    bind {
        "s" -> .RefreshStats
        "S" -> .RefreshStats
        "F" -> .ToggleFullscreen
        "Escape" -> .Close
    }

    on {
        .Init -> {
            .view_state = "empty"
            .status = "Open a file or directory to begin"
        }
        .OpenFile -> {
            .view_state = "loading"
            .status = "Reading image metadata…"
            if .session_id != "" {
                let _closed = close_session(.session_id)
            }
            let session = open_file("../../tests/fixtures/scenic-320x240.png")
            .session_id = session
            .media_src = current_uri(session)
            .media_alt = "Selected image"
            .selected_name = "rgb-1x1.png"
            .selected_path = "tests/fixtures"
            .image_count = 1
            .thumbnails = [{ id: 0, name: "rgb-1x1.png", src: "" }]
            .selected_index = 0
            .fit_mode = "contain"
            .zoom = 1.0
            .offset_x = 0.0
            .offset_y = 0.0
            .rotation = 0
            .media_rev_seq = .media_rev_seq + 1
            .media_rev = f"r${.media_rev_seq}"
            .revision = .revision + 1
        }
        .OpenDirectory -> {
            .view_state = "loading"
            .status = "Indexing directory…"
            if .session_id != "" {
                let _closed = close_session(.session_id)
            }
            let session = open_directory("../../tests/fixtures")
            .session_id = session
            .media_src = current_uri(session)
            .media_alt = "Selected image"
            .selected_name = "Opening directory…"
            .selected_path = "tests/fixtures"
            .fit_mode = "contain"
            .zoom = 1.0
            .offset_x = 0.0
            .offset_y = 0.0
            .rotation = 0
            .media_rev_seq = .media_rev_seq + 1
            .media_rev = f"r${.media_rev_seq}"
            .revision = .revision + 1
        }
        .SelectImage(i) -> {
            .selected_index = i
            if .session_id != "" {
                request_view(.session_id, i, 1024, 768, 90)
                .media_src = current_uri(.session_id)
                .status = "Queued rendition"
            }
            .view_state = "loading"
            // 新图初始基线（组件换代即捕获）：contain/1/0/0/0 + 资源修订递增。
            .fit_mode = "contain"
            .zoom = 1.0
            .offset_x = 0.0
            .offset_y = 0.0
            .rotation = 0
            .media_rev_seq = .media_rev_seq + 1
            .media_rev = f"r${.media_rev_seq}"
            .revision = .revision + 1
        }
        // PLAN-089：受控接受——baseRevision 校验后一次性赋值并增 revision；
        // 拒绝 = 保持原视图（组件请求不作成功论）。
        .ApplyView(ev str) -> {
            let req = json.parse(ev)
            if req.baseRevision == .revision {
                // PLAN-089：`view` 在成员位被 DotView 词元吞掉（auto-lang 解析缺口，成员访问静默取空）——消费方以索引取键，载荷键不变。
                .fit_mode = req.fit
                .zoom = req.zoom
                .offset_x = req.offsetX
                .offset_y = req.offsetY
                .rotation = req.rotation
                .revision = .revision + 1
                .status = "视图已接受"
            } else {
                .status = "视图请求已过期"
            }
        }
        // 前后张：组件只发方向请求；集合/顺序/媒体查询仍归本应用。
        .DoNavigate(ev str) -> {
            let req = json.parse(ev)
            if req.direction == "next" {
                if .session_id != "" {
                    if .selected_index + 1 < .image_count {
                        let _nav = navigate(.session_id, 1)
                        .selected_index = .selected_index + 1
                        .media_src = current_uri(.session_id)
                        .fit_mode = "contain"
                        .zoom = 1.0
                        .offset_x = 0.0
                        .offset_y = 0.0
                        .rotation = 0
                        .media_rev_seq = .media_rev_seq + 1
                        .media_rev = f"r${.media_rev_seq}"
                        .revision = .revision + 1
                        .status = "Next"
                    }
                }
            } else {
                if .session_id != "" {
                    if .selected_index > 0 {
                        let _nav = navigate(.session_id, -1)
                        .selected_index = .selected_index - 1
                        .media_src = current_uri(.session_id)
                        .fit_mode = "contain"
                        .zoom = 1.0
                        .offset_x = 0.0
                        .offset_y = 0.0
                        .rotation = 0
                        .media_rev_seq = .media_rev_seq + 1
                        .media_rev = f"r${.media_rev_seq}"
                        .revision = .revision + 1
                        .status = "Prev"
                    }
                }
            }
        }
        .RefreshStats -> { if .session_id != "" { .stats = image_stats(.session_id) } }
        .PanLeft -> { .offset_x = .offset_x - 40.0; .fit_mode = "free" }
        .PanRight -> { .offset_x = .offset_x + 40.0; .fit_mode = "free" }
        .ToggleFullscreen -> { .is_fullscreen = !.is_fullscreen }
        .ImageLoaded(ev str) -> { .view_state = "ready"; .status = "Ready" }
        // A media ticket can briefly be 503 while the bounded worker publishes
        // its rendition. Keep the viewport mounted so the browser can retry
        // the opaque URI; only an empty URI is a terminal error.
        .ImageError(ev str) -> {
            .status = "Waiting for image worker…"
            if .media_src == "" { .view_state = "error"; .status = "Image failed to load" }
        }
        .SettleTick -> {
            // PLAN-016 T-08：桌面 open_with 消费臂——路径来自宿主执行臂
            // write_state（未运行启动 / 已运行聚焦），同 OpenFile 流程打开。
            if .auto_open_path != "" {
                if .auto_open_path != .auto_open_consumed {
                    .auto_open_consumed = .auto_open_path
                    let p str = .auto_open_path
                    .auto_open_path = ""
                    .view_state = "loading"
                    .status = "Reading image metadata…"
                    if .session_id != "" {
                        let _closed = close_session(.session_id)
                    }
                    let session = open_file(p)
                    .session_id = session
                    .media_src = current_uri(session)
                    .media_alt = p
                    .selected_name = p
                    .selected_path = ""
                    .image_count = 1
                    .thumbnails = [{ id: 0, name: p, src: "" }]
                    .selected_index = 0
                    .fit_mode = "contain"
                    .zoom = 1.0
                    .offset_x = 0.0
                    .offset_y = 0.0
                    .rotation = 0
                    .media_rev_seq = .media_rev_seq + 1
                    .media_rev = f"r${.media_rev_seq}"
                    .revision = .revision + 1
                }
            }
            if .view_state == "loading" {
                if .session_id != "" {
                    .media_src = current_uri(.session_id)
                    let names_list = names(.session_id)
                    .image_count = names_list.len()
                    var thumb_list = []
                    var j int = 0
                    for j < names_list.len() {
                        thumb_list.push({ id: j, name: names_list[j], src: "" })
                        j = j + 1
                    }
                    if names_list.len() > 0 {
                        .thumbnails = thumb_list
                        .media_src = current_uri(.session_id)
                        if .selected_name == "Opening directory…" { .selected_name = names_list[0] }
                        .view_state = "ready"
                        .status = "Ready"
                    }
                }
            }
        }
        .Close -> {
            if .session_id != "" {
                let _closed = close_session(.session_id)
            }
            .view_state = "empty"
            .media_src = ""
            .session_id = ""
            .image_count = 0
            .selected_name = ""
            .selected_path = ""
            .status = "Closed"
        }
    }
}
