// pac.at — 031-image-viewer (Plan 547).
//
// Full-stack media viewer shell. The initial skeleton deliberately keeps the
// front/back contracts small; later tasks add indexing, sessions, controls and
// deterministic verification fixtures.
name: "image-viewer"
version: "0.1.0"
description: "AutoOS Image Viewer - asynchronous media surface and directory browsing"

scene: "ui"
render: "vue"
api: "rust"
front_port: 3031
back_port: 8031
icon: "image"
title: "Image Viewer"
title_zh: "图片查看器"
category: "media"
desktop: "true"
opens: ".jpg,.jpeg,.png,.webp,.gif,.bmp,.svg,.ico"
theme: "dark"
accent: "indigo"

dep stylekit {
    path: "../stylekit"
}

# PLAN-046 T-03：官方主题单源包（C-13；不复制配色表进本 app）。
# family 经 theme_name + design 绑定；pac 显式 theme: "dark" 保留为
# dark_mode=true 首帧默认（C-14 不暗改显式默认）；媒体/会话/URI 业务零改动。
dep themes {
    path: "../../../packages/themes"
}
