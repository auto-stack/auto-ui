// back/db.at — Todo Database Service
// In-memory storage with seed data.

use api: Todo

// ═══════════════════════════════════════════════════════════
// In-memory storage (seed data)
// ═══════════════════════════════════════════════════════════

var todos List<Todo> = List<Todo>.new([
    Todo { id: 0, text: "Learn Auto Language", done: true },
    Todo { id: 1, text: "Build a TodoMVC app", done: false },
    Todo { id: 2, text: "Master the a2r transpiler", done: false },
    Todo { id: 3, text: "Write integration tests", done: false }
])

var nextid int = 4

// ═══════════════════════════════════════════════════════════
// CRUD operations
// ═══════════════════════════════════════════════════════════

/// Return all todos
pub fn all_todos() []Todo {
    return todos
}

/// Create a new todo, returns the created todo
pub fn create_todo(text str) Todo {
    let todo = Todo { id: nextid, text: text, done: false }
    nextid = nextid + 1
    todos.push(Todo { id: todo.id, text: todo.text.clone(), done: todo.done })
    return todo
}

/// Update a todo's text and done status, returns the updated todo
pub fn update_todo(id int, text str, done bool) ?Todo {
    var new_todos = List<Todo>.new()
    var found ?Todo = None
    let current = all_todos()
    for todo in current {
        if todo.id == id {
            let updated = Todo {
                id: todo.id,
                text: text,
                done: done
            }
            new_todos.push(Todo { id: updated.id, text: updated.text.clone(), done: updated.done })
            found = Some(updated)
        } else {
            new_todos.push(Todo { id: todo.id, text: todo.text.clone(), done: todo.done })
        }
    }
    todos = new_todos
    return found
}

/// Delete a todo by id, returns true if deleted
pub fn delete_todo(id int) bool {
    var new_todos = List<Todo>.new()
    var found bool = false
    let current = all_todos()
    for todo in current {
        if todo.id != id {
            new_todos.push(Todo { id: todo.id, text: todo.text.clone(), done: todo.done })
        } else {
            found = true
        }
    }
    todos = new_todos
    return found
}

/// Remove all completed todos, returns true
pub fn remove_completed(done bool) bool {
    var new_todos = List<Todo>.new()
    let current = all_todos()
    for todo in current {
        if !todo.done {
            new_todos.push(Todo { id: todo.id, text: todo.text.clone(), done: todo.done })
        }
    }
    todos = new_todos
    return true
}

// The native Store sends ToggleAll as one checked request and one commit.
pub fn set_all_todos(done bool) bool {
    var updated = List<Todo>.new()
    let current = all_todos()
    for todo in current {
        updated.push(Todo { id: todo.id, text: todo.text.clone(), done: done })
    }
    todos = updated
    return true
}

// Internal to the checked ASE backend package. The HTTP API does not export
// these entries. Its process still starts with the seed data above.
pub fn restore_todo_snapshot(next_id int) bool {
    todos = List<Todo>.new()
    nextid = next_id
    return true
}

pub fn restore_todo_item(id int, text str, done bool) bool {
    todos.push(Todo { id: id, text: text, done: done })
    return true
}
