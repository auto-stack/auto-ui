// front/app.at — TodoMVC App (multi-component + backend).
//
// Layout: title + input + TodoList child component.
// App holds the store + input state; TodoList renders items + filters.

use todo_store: TodoStore
use todo_list: TodoList

// PLAN-637 Phase B token 化映射（2026-09-17，B1）：页面底 bg-gray-100→bg-background；
// 标题 text-red-400→text-primary（TodoMVC 传承红按设计退休，角色=品牌强调）；卡面
// bg-white→bg-card；输入行 border-gray-200→border-border；页脚提示 text-gray-400→
// text-muted-foreground。todo_list.at 侧映射见其文件头注。
//
// PLAN-037 T-03：接入官方主题包（原无主题接线、无显式默认 → 官方 Auto/light
// 独立默认）。family 经 theme_name + design 绑定；store/API/业务 handler 零改动
// ——换肤不丢列表/编辑输入，不把 API 变静态种子。
use themes.themes: Auto, Solarized

widget App {
    msg {
        Init, AddTodo, ToggleAll
    }

    model {
        var input str = ""
        // PLAN-037：主题族/模式选择态（主题选择，非业务状态）
        var theme_name str = "Auto"
        var dark_mode bool = false
    }

    // 主题/模式选择器（C-14：数据绑定，同帧校验发布；PLAN-037）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "flex flex-col items-center min-h-screen bg-background pt-16"

            // Title
            h1 "todos" {
                style: "text-6xl font-thin text-center text-primary mb-4"
            }

            // Main card
            col {
                style: "bg-card w-full max-w-xl shadow-lg rounded-lg overflow-hidden"

                // Input row
                row {
                    style: "flex items-center border-b border-border"
                    checkbox {
                        checked: .store.active_count == 0 && .store.todos.len() > 0
                        onclick: .ToggleAll
                        style: "w-10 h-12 ml-2"
                    }
                    input {
                        value: .input
                        onenter: .AddTodo
                        placeholder: "What needs to be done?"
                        style: "flex-1 text-xl px-2 py-3 outline-none"
                    }
                }

                // Todo list (child component)
                TodoList()
            }

            // Footer hint
            text "Double-click text to edit" {
                style: "mt-8 text-xs text-muted-foreground"
            }
        }
    }

    // PLAN-024 R18：桌面 dashboard 待办卡——active_count 大字 + 标签，
    // 与主窗同 store（活渲染面）；纯前端无后端 → 静默孵化主 tab 场景。
    // PLAN-035 T-06：3×2 声明（span 标记 = 宿主 dashboard_declared_span
    // 文本探测契约）+ 双列布局——左计数 / 右未完成前三（store Recompute
    // 派生，truncate 截断安全；AC-07）。
    view mini {
        // dashboard span: 3
        col {
            style: "w-full h-full items-center justify-center p-3"
            row {
                style: "items-center justify-center gap-4 w-full"
                col {
                    style: "items-center gap-0.5 w-16"
                    text .store.active_count {
                        style: "text-3xl font-semibold text-foreground tabular-nums text-center"
                    }
                    text "待办未完成" {
                        style: "text-xs text-muted-foreground"
                    }
                }
                col {
                    style: "gap-1 w-32"
                    if .store.preview1 != "" {
                        text f"· ${.store.preview1}" {
                            style: "text-xs text-muted-foreground truncate"
                        }
                    }
                    if .store.preview2 != "" {
                        text f"· ${.store.preview2}" {
                            style: "text-xs text-muted-foreground truncate"
                        }
                    }
                    if .store.preview3 != "" {
                        text f"· ${.store.preview3}" {
                            style: "text-xs text-muted-foreground truncate"
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .AddTodo -> {
            store.AddTodo()
        }

        .ToggleAll -> {
            store.ToggleAll()
        }
    }
}
