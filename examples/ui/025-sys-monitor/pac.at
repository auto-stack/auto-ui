// pac.at - 系统监视器（Plan 541）
//
// 任务管理器式系统监视器——真实系统数据（sysinfo 后端），vue/vm 双轨。
// 4页：进程 / 性能 / 详细信息 / 用户，含结束任务 alert-dialog 二次确认。

name: "sys-monitor"
version: "0.2.0"
description: "任务管理器式系统监视器——真实系统数据（sysinfo 后端），vue/vm 双轨"

scene: "ui"
render: "vue"
title: "System Monitor"
title_zh: "系统监视器"
icon: "activity"
category: "system"
front_port: 4025
back_port: 8425
desktop: "true"
theme: "dark"
accent: "indigo"

# PLAN-047 T-03：接入官方主题包（C-13）。025 既有显式默认 dark/indigo 保留
# （pac theme/accent 键原样；App dark_mode=true 迁移前已声明未读，本批接线
# design 绑定生效）。KPI/图例 hex 点（#2563eb/#16a34a/#8b5cf6/#d97706）与
# green/red 状态点为数据/状态身份色豁免；sysinfo 后端数据面不随肤变。
dep themes {
    path: "../../../packages/themes"
}
