name: "calendar"
version: "1.0.0"
scene: "ui"
render: "vue"
title: "Calendar"
title_zh: "日历"
theme: "light"
accent: "indigo"
window: "fit"

# PLAN-637 T-01b: dep settings 悬空声明移除（common/settings 已迁址 auto-os；
# 本 demo 的 settings 面板为 store 驱动的本地实现，不依赖共享包，自足）。
desktop: "true"

dep stylekit {
    path: "../stylekit"
}

# PLAN-037 T-02：官方主题单源包（不复制配色表进本 app，C-13）。
# 既有显式 pac `theme: "light"` 默认按 031 契约保留（同 010 先例）；
# 家族选择经 theme_name + design 数据绑定，store 主题主权链路原样。
dep themes {
    path: "../../../packages/themes"
}
