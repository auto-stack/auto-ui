// app.at — 031-paint 像素画板根组件（Plan 553；PLAN-088 T-04 迁移）。
//
// 形态：单组件内聚（025/028 形态——store 子组件 vue TS 生成损坏先例 013/038，
// 全部状态进 App model）。
//
// 颜色表示（PLAN-088 迁移后）：文档颜色一律 canonical **"#RRGGBBAA"** 数值
// 串（大写 8 位）——不再使用 Tailwind 类串承载文档内容色。像素画布经
// canvas 场景（数据驱动，双轨同规约）渲染，任选颜色不需要生成器支持的
// 动态类（PLAN-088 r2 禁令）。选色 UI = 官方 ColorPicker 包（PLAN-088）：
// preview 只回显不写正式画笔色；committed 才改 cur；取消零业务修改、不增
// 绘画历史（选色不是落笔）。
//
// 旧文档兼容（PLAN-088 T-04）：storage 旧样本 " bg-[#rrggbb] " 类串在
// Load/ApplySnap 读取路径逐格识别并迁移为 "#RRGGBBFF"（legacy_to_hex）；
// 新格式（"#" 前缀）原样通过。保存键不变（paint.canvas.v1）。
//
// 变更纪律（T6 VM 实测修正，沿用）：运行时 str 列表禁止下标写——本地构建
// 新列表 → 整体赋值。快照 join("|")/split 沿用（hex 不含 "|"）。
//
// 其余状态表示（T1 探针）：快照 BFS 邻接判定 `h%16`/`h>=16`/`h<240` 边界式。
// 拖画：v1 点击画（onhit 命中 → Paint(i)）。

use auto.json
use paint_color: legacy_to_hex, px_node
use stylekit.styles: caption_text
// PLAN-047 T-03：接入官方主题包。显式默认 dark 保留（pac theme: "dark" →
// dark_mode=true）；调色板/画布 hex 为文档内容色（换肤不改文档像素）。
use themes.themes: Auto, Solarized
// PLAN-088 T-04：官方选色包（内嵌 NumericField 传递依赖按消费方声明纪律
// 并列声明于 pac.at）。
style tool_btn = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
style wrap_row = "items-center gap-2 flex-wrap"

widget App {
    msg {
        Init, SetTool(str), SetCur(str), Paint(int), Fill(int), SetPx(int, str),
        PushUndo, Undo, Redo, ApplySnap(str), Clear, New, Save, Load,
        PickCommitted(str), PickPreview(str), PickCancelled, PickError(str), PaintHit(str)
    }

    // 主题/模式选择器（C-14：数据绑定，同帧校验发布）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    model {
        // PLAN-047 T-03：主题族/模式选择态
        var theme_name str = "Auto"
        var dark_mode bool = true

        // ---- 颜色词汇表（canonical hex；白色 = 橡皮色）----
        var white str = "#FFFFFFFF"
        var palette = [
            "#111827FF", "#EF4444FF", "#F97316FF", "#F59E0BFF",
            "#84CC16FF", "#22C55EFF", "#14B8A6FF", "#3B82F6FF",
            "#6366F1FF", "#A855F7FF", "#EC4899FF", "#92400EFF",
            "#57534EFF", "#A8A29EFF", "#E7E5E4FF", "#FFFFFFFF"
        ]

        // ---- 画布（canvas 场景：256 像素节点，320×320 逻辑幅面）----
        var px = []                 // 256 × "#RRGGBBFF"
        var cells_pts List = []
        var cells_meta List = []
        var cells_nodes List = []
        var cells_edges List = []
        var cells_labels List = []
        var curchip_pts List = []
        var curchip_meta List = []
        var curchip_nodes List = []
        var curchip_edges List = []
        var curchip_labels List = []

        // ---- 工具与当前色 ----
        var tool str = "pencil"     // pencil | eraser | fill | picker
        var cur str = "#111827FF"
        var cur_rev int = 1         // ColorPicker 受控修订
        var pencil_class str = ""
        var eraser_class str = ""
        var fill_class str = ""
        var picker_class str = ""

        // ---- 历史 ----
        var undo_stack = []         // 快照串列表，上限 20
        var redo_stack = []
        var saved str = "1"         // "0" = 有未保存改动（标题行 ● 提示）

        // ---- 状态条 ----
        var status str = ""
    }
    // PLAN-088 T-04：官方选色包（widget 级 use；内嵌 NumericField 传递依赖
    // 并列声明于 pac.at）。
    use { package: color_picker from "../../../../../packages/color-picker" }

    view {
        col {
            style: "w-full max-w-2xl bg-card border rounded-2xl shadow-2xl p-4 gap-3 mx-auto"

            // ---- 标题 + 工具行 ----
            row {
                style: wrap_row
                text "Paint" { style: "text-base font-semibold text-foreground mr-2" }
                if .saved == "0" {
                    text "●" { style: "text-xs text-primary" }
                }
                button "✏ Pencil" { onclick: .SetTool("pencil"), style: .pencil_class }
                button "◻ Eraser" { onclick: .SetTool("eraser"), style: .eraser_class }
                button "🪣 Fill" { onclick: .SetTool("fill"), style: .fill_class }
                button "💧 Picker" { onclick: .SetTool("picker"), style: .picker_class }
            }

            // ---- 画布（16×16 canvas 场景；onhit 命中 → Paint(i)）----
            col {
                style: "p-1 bg-muted/50 border rounded-lg w-fit"
                canvas (scene: .cells, coords: "320x320", clear: "#ffffff", onhit: .PaintHit, style: "w-80 h-80 rounded") {}
            }

            // ---- 选色（官方 ColorPicker：预览不写正式色；确认才改 cur）----
            row {
                style: "items-start gap-3"
                col {
                    style: "flex flex-col items-center gap-1"
                    canvas (scene: .curchip, coords: "32x32", style: "w-8 h-8 rounded-lg border border-border") {}
                    text "Current" { style: caption_text }
                }
                ColorPicker (value: .cur, revision: .cur_rev, palette: .palette, onpreview: .PickPreview($event), oncommitted: .PickCommitted($event), oncancelled: .PickCancelled, onerror: .PickError($event)) {}
            }

            // ---- 操作行 + 状态条 ----
            row {
                style: wrap_row
                button "Undo" { onclick: .Undo, style: tool_btn }
                button "Redo" { onclick: .Redo, style: tool_btn }
                button "Clear" { onclick: .Clear, style: tool_btn }
                button "New" { onclick: .New, style: tool_btn }
                button "Save" { onclick: .Save, style: "px-3 py-1.5 text-sm rounded-lg bg-primary text-primary-foreground" }
                button "Load" { onclick: .Load, style: "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary" }
                text .status { style: "ml-auto text-xs text-muted-foreground" }
            }
        }
    }

    on {
        .Init -> {
            .cells_pts = []
            .cells_meta = []
            .cells_nodes = []
            .cells_edges = []
            .cells_labels = []
            .curchip_pts = []
            .curchip_meta = []
            .curchip_nodes = []
            .curchip_edges = []
            .curchip_labels = []
            var ip = []
            var k int = 0
            while k < 256 {
                ip.push(.white)
                k = k + 1
            }
            .px = ip
            .undo_stack = []
            .redo_stack = []
            .saved = "1"
            .status = ""
            .tool = "pencil"
            .cur = "#111827FF"
            .ToolClasses()
            .RebuildCells()
            .RebuildChip()
        }

        // ---- 工具/当前色（选中态经 class 串状态，038 难度按钮同型）----
        .SetTool(t) -> {
            .tool = t
            .ToolClasses()
            .status = ""
        }

        .SetCur(c str) -> {
            .cur = c
            .cur_rev = .cur_rev + 1
            .RebuildChip()
            .status = ""
        }

        // ---- PLAN-088：选色业务适配（确认才改正式画笔色）----
        .PickPreview(ev str) -> {
            // 预览不写 cur（正式画笔色不被预览覆盖）；无业务动作
            .status = ""
        }
        .PickCommitted(ev str) -> {
            var req = json.parse(ev)
            .SetCur(req.value)
        }
        .PickCancelled -> {
            // 取消：零业务修改、不增历史
            .status = ""
        }
        .PickError(ev str) -> {
            .status = f"picker error"
        }

        .ToolClasses -> {
            if .tool == "pencil" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "eraser" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "fill" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "picker" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
            }
        }

        // ---- 画布节点重建（canvas 场景；256 节点 push 构建）----
        .RebuildCells -> {
            .cells_nodes = []
            var k int = 0
            while k < 256 {
                var it str = px_node(.px, k)
                .cells_nodes.push(it)
                k = k + 1
            }
        }

        // ---- 当前色 chip（棋盘 + color8 覆盖——透明可见）----
        .RebuildChip -> {
            .curchip_nodes = []
            var wr int = 0
            while wr < 2 {
                var wc int = 0
                while wc < 2 {
                    var tone str = "#ffffff"
                    var m int = (wr + wc) % 2
                    if m == 1 { tone = "#c8c8c8" }
                    var it str = f"ck${wr}_${wc},${wc * 16 + 8},${wr * 16 + 8},rect,${tone},16,16"
                    .curchip_nodes.push(it)
                    wc = wc + 1
                }
                wr = wr + 1
            }
            var ov str = f"ov,16,16,rect,${.cur},32,32"
            .curchip_nodes.push(ov)
        }

        // ---- onhit 命中 → 落笔（id "px<i>"）----
        .PaintHit(id) -> {
            var idx int = id.substr(2, id.len()).to(int)
            .Paint(idx)
        }

        // ---- 单格替换（本地构建 → 整体赋值；下标写静默失效，见文件头）----
        .SetPx(i, v) -> {
            var np = []
            var k int = 0
            while k < 256 {
                if k == i {
                    np.push(v)
                } else {
                    np.push(.px[k])
                }
                k = k + 1
            }
            .px = np
        }

        // ---- 落笔分派 ----
        .Paint(i) -> {
            if .tool == "pencil" {
                if .px[i] != .cur {
                    .PushUndo()
                    .SetPx(i, .cur)
                    .RebuildCells()
                }
            }
            if .tool == "eraser" {
                if .px[i] != .white {
                    .PushUndo()
                    .SetPx(i, .white)
                    .RebuildCells()
                }
            }
            if .tool == "fill" {
                .Fill(i)
            }
            if .tool == "picker" {
                .cur = .px[i]
                .cur_rev = .cur_rev + 1
                .RebuildChip()
            }
        }

        // ---- 历史栈 ----
        .PushUndo -> {
            .undo_stack.push(.px.join("|"))
            if .undo_stack.len() > 20 {
                var kept = []
                var k int = 1
                while k < .undo_stack.len() {
                    kept.push(.undo_stack[k])
                    k = k + 1
                }
                .undo_stack = kept
            }
            .redo_stack = []
            .saved = "0"
        }

        // ---- 泛洪（迭代 BFS；邻接 h%16 / h>=16 / h<240 边界式）----
        .Fill(i) -> {
            var target = .px[i]
            if target != .cur {
                .PushUndo()
                var queue = []
                queue.push(i)
                var seen = []
                var k int = 0
                while k < 256 {
                    seen.push(0)
                    k = k + 1
                }
                seen[i] = 1
                var qi int = 0
                while qi < queue.len() {
                    var h int = queue[qi]
                    qi = qi + 1
                    if h >= 16 {
                        var up int = h - 16
                        if seen[up] == 0 {
                            if .px[up] == target {
                                seen[up] = 1
                                queue.push(up)
                            }
                        }
                    }
                    if h < 240 {
                        var dn int = h + 16
                        if seen[dn] == 0 {
                            if .px[dn] == target {
                                seen[dn] = 1
                                queue.push(dn)
                            }
                        }
                    }
                    if h % 16 != 0 {
                        var lf int = h - 1
                        if seen[lf] == 0 {
                            if .px[lf] == target {
                                seen[lf] = 1
                                queue.push(lf)
                            }
                        }
                    }
                    if h % 16 != 15 {
                        var rt int = h + 1
                        if seen[rt] == 0 {
                            if .px[rt] == target {
                                seen[rt] = 1
                                queue.push(rt)
                            }
                        }
                    }
                }
                var np = []
                var k2 int = 0
                while k2 < 256 {
                    if seen[k2] == 1 {
                        np.push(.cur)
                    } else {
                        np.push(.px[k2])
                    }
                    k2 = k2 + 1
                }
                .px = np
                .RebuildCells()
            }
        }

        // ---- 撤销/重做（快照互倒；栈丢底重建）----
        .Undo -> {
            if .undo_stack.len() > 0 {
                .redo_stack.push(.px.join("|"))
                var last int = .undo_stack.len() - 1
                var snap = .undo_stack[last]
                var kept = []
                var k int = 0
                while k < last {
                    kept.push(.undo_stack[k])
                    k = k + 1
                }
                .undo_stack = kept
                .ApplySnap(snap)
                .saved = "0"
            } else {
                .status = "nothing to undo"
            }
        }

        .Redo -> {
            if .redo_stack.len() > 0 {
                var last2 int = .redo_stack.len() - 1
                var snap2 = .redo_stack[last2]
                var kept2 = []
                var k2 int = 0
                while k2 < last2 {
                    kept2.push(.redo_stack[k2])
                    k2 = k2 + 1
                }
                var cur_snap = .px.join("|")
                .redo_stack = kept2
                .ApplySnap(snap2)
                .undo_stack.push(cur_snap)
                .saved = "0"
            } else {
                .status = "nothing to redo"
            }
        }

        // ---- 快照应用（本地构建 → 整体赋值；旧格式类串在读取路径迁移）。
        // 已知 VM 债 P553-D1：split 产物**全同串列表**整体赋值塌缩——混合
        // 内容快照不受影响；迁移路径保持同律。----
        .ApplySnap(s) -> {
            var parts = s.split("|")
            if parts.len() == 256 {
                var np = []
                var k int = 0
                while k < 256 {
                    var entry str = parts[k]
                    if entry.starts_with("#") {
                        np.push(entry)
                    } else {
                        var mig str = legacy_to_hex(entry)
                        if mig == "" {
                            np.push(.white)
                        } else {
                            np.push(mig)
                        }
                    }
                    k = k + 1
                }
                .px = np
                .RebuildCells()
            }
        }

        // ---- 清空（可撤销）/ 新建（清历史）----
        .Clear -> {
            var dirty int = 0
            var k int = 0
            while k < 256 {
                if .px[k] != .white {
                    dirty = 1
                }
                k = k + 1
            }
            if dirty == 1 {
                .PushUndo()
                var np = []
                var k2 int = 0
                while k2 < 256 {
                    np.push(.white)
                    k2 = k2 + 1
                }
                .px = np
                .RebuildCells()
                .status = ""
            }
        }

        .New -> {
            var np = []
            var k int = 0
            while k < 256 {
                np.push(.white)
                k = k + 1
            }
            .px = np
            .undo_stack = []
            .redo_stack = []
            .saved = "0"
            .RebuildCells()
            .status = "new canvas"
        }

        // ---- storage 存取（null 防御在 lowering 层）----
        .Save -> {
            storage.set("paint.canvas.v1", .px.join("|"))
            .saved = "1"
            .status = "saved"
        }

        .Load -> {
            var snap = storage.get("paint.canvas.v1")
            if snap != "" {
                var parts = snap.split("|")
                if parts.len() == 256 {
                    .PushUndo()
                    .ApplySnap(snap)
                    .saved = "1"
                    .status = "loaded"
                } else {
                    .status = "bad save data"
                }
            } else {
                .status = "no saved canvas"
            }
        }
    }
}
