// app.at — App shell. Routes + top nav + outlet. Nav adapts to login state
// (.store.me.id != 0 = logged in). Cf. 018 app.at routes{...} + outlet.
use auth_store: AuthStore
use article_store: ArticleStore

// PLAN-637 B5 Phase B 映射（灰阶分层口径）：gray-800/700/600→foreground；gray-500/400→
// muted-foreground；border-gray-N→border-border；bg-white→bg-card；bg-gray-100→bg-muted；
// bg-red-50/text-red-500→destructive 族。text-white ×5 为 brand-green 品牌按钮配对字
// （品牌绿=本 demo 自定义语义色，整体豁免保留）。表单输入框 ×13 消费 stylekit
// input_field（D1 家族源 demo）。
//
// PLAN-037 T-04：接入官方主题包（原无主题接线、无显式默认 → 官方 Auto/light
// 独立默认）。family 经 theme_name + design 绑定于 App 根——七个路由页共享
// 同一选择，跨路由/换肤保持登录与编辑草稿。
use themes.themes: Auto, Solarized

widget App {
    routes {
        "/" -> use home
        "/login" -> use login
        "/register" -> use register
        "/article/:slug" -> use article_detail
        "/settings" -> use settings
        "/editor/:slug" -> use editor
        "/profile/:username" -> use profile
    }

    msg { Init, Logout, GoProfile(str) }

    model {
        // PLAN-037：主题族/模式选择态（主题选择，非业务状态）
        var theme_name str = "Auto"
        var dark_mode bool = false
    }

    // 主题/模式选择器（C-14：数据绑定，同帧校验发布；PLAN-037）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        col {
            style: "min-h-screen font-serif text-foreground"
            // Top nav
            row {
                style: "w-full border-b border-border px-4 py-3 max-w-3xl mx-auto items-center gap-4"
                link (to: "/") {
                    text "conduit" { style: "text-brand-green text-xl font-bold no-underline" }
                }
                row {
                    style: "ml-auto gap-4 text-sm"
                    link (to: "/") { text "Home" { style: "text-foreground" } }
                    if .store.me != nil {
                        if .store.me.id != 0 {
                            link (to: "/editor/new") { text "New Post" { style: "text-foreground" } }
                            link (to: "/settings") { text "Settings" { style: "text-foreground" } }
                            text .store.me.username {
                                onclick: .GoProfile(.store.me.username)
                                style: "text-foreground cursor-pointer"
                            }
                        } else {
                            link (to: "/login") { text "Sign in" { style: "text-foreground" } }
                            link (to: "/register") { text "Sign up" { style: "text-foreground" } }
                        }
                    } else {
                        link (to: "/login") { text "Sign in" { style: "text-foreground" } }
                        link (to: "/register") { text "Sign up" { style: "text-foreground" } }
                    }
                }
            }
            // Route outlet
            col {
                outlet
            }
        }
    }

    on {
        // PLAN-037 T-04（有界修定，基础反例=冻结基线 plan-446 A1 fatal）：
        // App 同时持有 AuthStore/ArticleStore，裸 `store.Init()` 命中两店
        // 同名 Init → VM 轨引导 fatal（Vue 轨 codegen 恰好按双店展开故未
        // 暴露）。按 A1 处方限定店名，语义=会话恢复 + feed 加载，双轨一致。
        .Init -> {
            AuthStore.Init()
            ArticleStore.Init()
        }
        .Logout -> { store.Logout() }
        .GoProfile(username str) -> { router.push("/profile/" + username) }
    }
}
