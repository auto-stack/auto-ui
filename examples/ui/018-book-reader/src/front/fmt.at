// fmt.at — 显示用数字格式化。进度百分比取整（原 Plan-399 原门口径 "33%"/"100%"）。
// Book.progress 运行时可能是 float（如 100/3=33.333…），直接插值会长尾。
// PLAN-047 T-02 漂移修定：PLAN-684 曾改保留 1 位小数（"33.0%"），原门
// smoke T2/T7 断言 '33%'/'100%' 因此双红（格式漂移，业务回写链路由
// PLAN-047 ts_adapter from_value 修复另闭）。取整同样消解长尾，恢复原门
// 可观察面；进度数值本身（int 0-100）不受影响。

/// 整数百分比（截断）：33.333… → "33"；33 → "33"；100 → "100"
fn pct(x float) str {
    let whole int = x as int
    return whole.to_string()
}

/// 百分比文案：33.333… → "33%"
fn pct_label(x float) str {
    return pct(x) + "%"
}
