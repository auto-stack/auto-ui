# Allow the playwright test manifest (repo-root `*.json` ignores it; 017-chat
# relies on pnpm-lock.yaml, but committing package.json makes `npm/pnpm install`
# work without regeneration).
!tests/package.json

# Generated / runtime artifacts (still ignored).
gen/
.auto/
dist/
build/
examples/
.am/
rust-workspace/target/
tests/node_modules/
tests/test-results/
tests/playwright-report/
