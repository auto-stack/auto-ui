// settings.at — Settings popup panel component.
// Supports dual-backend Dark/Light mode toggle and 5-color accent palette.

widget SettingsPanel(dark_mode: bool, accent_color: str, on_close: msg, on_toggle_dark: msg, on_set_pink: msg, on_set_indigo: msg, on_set_ocean: msg, on_set_sage: msg, on_set_amber: msg) {
    msg {
        Close,
        // PLAN-045 修复（VM 双发）：子 msg 名与回调 prop 名折叠同键（ToggleDark
        // vs on_toggle_dark → ontoggledark）会让声明式+体内式双路径同时回送父
        // handler——ToggleDarkMode 翻转两次回原值。改名为 SwitchTheme 错开折叠键；
        // Vue emit 名由 prop 名（on_toggle_dark → ToggleDark）决定，双端行为不变。
        SwitchTheme,
        SetPink,
        SetIndigo,
        SetOcean,
        SetSage,
        SetAmber
    }

    view {
        col {
            style: if .dark_mode {
                "p-4 bg-card border border-border rounded-2xl gap-3.5 shadow-2xl w-full"
            } else {
                "p-4 bg-card border border-border rounded-2xl gap-3.5 shadow-2xl w-full"
            }

            // Header
            row {
                style: "items-center justify-between"
                row {
                    style: "items-center gap-1.5"
                    text "⚙" { style: "text-sm" }
                    text "Settings" {
                        style: if .dark_mode {
                            "text-xs font-bold text-foreground uppercase tracking-wider"
                        } else {
                            "text-xs font-bold text-foreground uppercase tracking-wider"
                        }
                    }
                }
                button "✕" {
                    onclick: .Close
                    style: if .dark_mode {
                        "text-xs text-muted-foreground hover:text-foreground w-6 h-6 flex items-center justify-center rounded-lg bg-transparent hover:bg-muted transition-colors cursor-pointer"
                    } else {
                        "text-xs text-muted-foreground hover:text-foreground w-6 h-6 flex items-center justify-center rounded-lg bg-transparent hover:bg-muted transition-colors cursor-pointer"
                    }
                }
            }

            // Theme section
            col {
                style: "gap-1.5"
                text "Theme" {
                    style: if .dark_mode {
                        "text-xs font-medium text-muted-foreground"
                    } else {
                        "text-xs font-medium text-muted-foreground"
                    }
                }
                row {
                    style: "gap-1.5 p-0.5 bg-muted/40 rounded-lg"
                    if .dark_mode {
                        button "🌙 Dark" {
                            onclick: .SwitchTheme
                            style: "flex-1 py-1.5 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground shadow-sm transition-colors cursor-pointer"
                        }
                        button "☀ Light" {
                            onclick: .SwitchTheme
                            style: "flex-1 py-1.5 px-2 text-xs font-medium rounded-md text-muted-foreground hover:text-foreground bg-transparent transition-colors cursor-pointer"
                        }
                    } else {
                        button "🌙 Dark" {
                            onclick: .SwitchTheme
                            style: "flex-1 py-1.5 px-2 text-xs font-medium rounded-md text-muted-foreground hover:text-foreground bg-transparent transition-colors cursor-pointer"
                        }
                        button "☀ Light" {
                            onclick: .SwitchTheme
                            style: "flex-1 py-1.5 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground shadow-sm transition-colors cursor-pointer"
                        }
                    }
                }
            }

            // Accent color section
            col {
                style: "gap-1.5"
                text "Accent Color" {
                    style: if .dark_mode {
                        "text-xs font-medium text-muted-foreground"
                    } else {
                        "text-xs font-medium text-muted-foreground"
                    }
                }
                row {
                    style: "items-center gap-2.5 py-1"
                    button "" {
                        onclick: .SetPink
                        style: if .accent_color == "pink" {
                            "w-6 h-6 p-0 rounded-full bg-pink-500 ring-2 ring-offset-2 ring-offset-card ring-pink-500 cursor-pointer shadow-sm"
                        } else {
                            "w-6 h-6 p-0 rounded-full bg-pink-500 hover:scale-110 transition-transform cursor-pointer"
                        }
                    }
                    button "" {
                        onclick: .SetIndigo
                        style: if .accent_color == "indigo" {
                            "w-6 h-6 p-0 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-indigo-500 cursor-pointer shadow-sm"
                        } else {
                            "w-6 h-6 p-0 rounded-full bg-indigo-500 hover:scale-110 transition-transform cursor-pointer"
                        }
                    }
                    button "" {
                        onclick: .SetOcean
                        style: if .accent_color == "ocean" {
                            "w-6 h-6 p-0 rounded-full bg-sky-500 ring-2 ring-offset-2 ring-offset-card ring-sky-500 cursor-pointer shadow-sm"
                        } else {
                            "w-6 h-6 p-0 rounded-full bg-sky-500 hover:scale-110 transition-transform cursor-pointer"
                        }
                    }
                    button "" {
                        onclick: .SetSage
                        style: if .accent_color == "sage" {
                            "w-6 h-6 p-0 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-emerald-500 cursor-pointer shadow-sm"
                        } else {
                            "w-6 h-6 p-0 rounded-full bg-emerald-500 hover:scale-110 transition-transform cursor-pointer"
                        }
                    }
                    button "" {
                        onclick: .SetAmber
                        style: if .accent_color == "amber" {
                            "w-6 h-6 p-0 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-amber-500 cursor-pointer shadow-sm"
                        } else {
                            "w-6 h-6 p-0 rounded-full bg-amber-500 hover:scale-110 transition-transform cursor-pointer"
                        }
                    }
                }
            }
        }
    }

    on {
        .Close -> { on_close() }
        .SwitchTheme -> { on_toggle_dark() }
        .SetPink -> { on_set_pink() }
        .SetIndigo -> { on_set_indigo() }
        .SetOcean -> { on_set_ocean() }
        .SetSage -> { on_set_sage() }
        .SetAmber -> { on_set_amber() }
    }
}
