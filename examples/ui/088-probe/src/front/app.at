                .pal_nodes.push(pit)
                pi = pi + 1
            }
            // ── 光标 ──
            .surf_edges = []
            var e1 str = pp_cursor_edge_h(.s, .v)
            var e2 str = pp_cursor_edge_v(.s, .v)
            .surf_edges.push(e1)
            .surf_edges.push(e2)
        }
        .SurfDown(x, y) -> {
