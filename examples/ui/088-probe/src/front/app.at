// ───────────── 探针引擎 fn（单返回值；形参带 p 前缀避开 widget state 同名
// —— vue 生成器对同名标识符误加 .value，087 同款债务，规格 §3 在案） ─────────────

/// 正整数 half-up 舍入除法 pa/pb（精确整除形，双轨一致）。
fn pp_half_up(pa int, pb int) int {
    var n int = pa * 2 + pb
    var d int = pb * 2
    return (n - n % d) / d
}

/// 0..15 → 一位大写 HEX。
fn pp_hex1(pd int) str {
    var hex str = "0123456789ABCDEF"
    return hex.substr(pd, 1)
}

/// 0..255 → 两位大写 HEX。
fn pp_hex2(pv int) str {
    var hi int = (pv - pv % 16) / 16
    var lo int = pv % 16
    return pp_hex1(hi) + pp_hex1(lo)
}

/// HSV → "#RRGGBB"（half-up；360→0 由调用方规范化）。
fn pp_hsv_hex(ph int, psc int, pv int) str {
    var hh int = ph
    if hh >= 360 { hh = hh - 360 }
    var vv int = pp_half_up(pv * 255, 100)
    var sector int = (hh - hh % 60) / 60
    var f int = hh % 60
    var t int = pp_half_up(vv * (6000 - psc * 60 + psc * f), 6000)
    var q int = pp_half_up(vv * (6000 - psc * f), 6000)
    var p int = pp_half_up(vv * (100 - psc), 100)
    var r int = vv
    var g int = vv
    var b int = vv
    if sector == 0 {
        g = t
        b = p
    }
    if sector == 1 {
        r = q
        b = p
    }
    if sector == 2 {
        r = p
        b = t
    }
    if sector == 3 {
        r = p
        g = q
    }
    if sector == 4 {
        r = t
        g = p
    }
    if sector == 5 {
        g = p
        b = q
    }
    return "#" + pp_hex2(r) + pp_hex2(g) + pp_hex2(b)
}

/// 十进制串整数部（pen 坐标量化；值域 [0..360)+0.001 双轨短表示）。
fn pp_ip(pdec str) int {
    var n int = pdec.len()
    var end int = n
    for i in 0..n {
        if pdec.substr(i, 1) == "." {
            end = i
        }
    }
    var vi int = 0
    for i in 0..end {
        var d int = 0 - 1
        var ch str = pdec.substr(i, 1)
        if ch == "0" { d = 0 }
        if ch == "1" { d = 1 }
        if ch == "2" { d = 2 }
        if ch == "3" { d = 3 }
        if ch == "4" { d = 4 }
        if ch == "5" { d = 5 }
        if ch == "6" { d = 6 }
        if ch == "7" { d = 7 }
        if ch == "8" { d = 8 }
        if ch == "9" { d = 9 }
        if d < 0 { return 0 }
        vi = vi * 10 + d
    }
    return vi
}

/// 夹取。
fn pp_clamp(pxx int, plo int, phi int) int {
    if pxx < plo { return plo }
    if pxx > phi { return phi }
    return pxx
}

/// 整数部 + 夹取（量化主路径）。
fn pp_floor_clamp(pdec str, plo int, phi int) int {
    var vi int = pp_ip(pdec)
    if vi < plo { return plo }
    if vi > phi { return phi }
    return vi
}

/// SV 面列 i 节点（hue 色 alpha=s_i；8px 列，中心 x=i*8+4）。
fn pp_col_item(phue int, pi int) str {
    var huehex str = pp_hsv_hex(phue, 100, 100)
    var x int = pi * 8 + 4
    var si int = pp_half_up(x * 100, 192)
    var aj int = pp_half_up(si * 255, 100)
    var a2 str = pp_hex2(aj)
    return f"c${pi},${x},96,rect,${huehex}${a2},8,192"
}

/// SV 面行 j 节点（黑 alpha=1-v_j；8px 行，中心 y=j*8+4）。
fn pp_row_item(pj int) str {
    var y int = pj * 8 + 4
    var vj int = 100 - pp_half_up(y * 100, 192)
    var aj int = 255 - pp_half_up(vj * 255, 100)
    var b2 str = pp_hex2(aj)
    return f"r${pj},96,${y},rect,#000000${b2},192,8"
}

/// hue 条段 i 节点。
fn pp_hue_item(pi int) str {
    var x int = pi * 8 + 4
    var hi int = pp_half_up(x * 360, 192)
    var col str = pp_hsv_hex(hi, 100, 100)
    return f"h${pi},${x},6,rect,${col},8,12"
}

/// alpha 条段 i 节点（当前 rgb6 + 段代表 alpha）。
fn pp_alpha_item(prgb6 str, pi int) str {
    var x int = pi * 8 + 4
    var ai int = pp_half_up(x * 255, 192)
    var a2 str = pp_hex2(ai)
    return f"a${pi},${x},6,rect,${prgb6}${a2},8,12"
}

/// 棋盘格 (pr,pc) 节点（格 pcw×pch；(pr+pc) 奇偶异色）。
fn pp_checker_item(pr int, pc int, pcw int, pch int) str {
    var x int = pc * pcw + pp_half_up(pcw, 2)
    var y int = pr * pch + pp_half_up(pch, 2)
    var tone str = "#ffffff"
    var m int = (pr + pc) % 2
    if m == 1 { tone = "#c8c8c8" }
    return f"c${pr}_${pc},${x},${y},rect,${tone},${pcw},${pch}"
}

/// 预览覆盖节点（整块 color8）。
fn pp_sw_overlay_item(phex8 str) str {
    return f"ov,48,24,rect,${phex8},96,48"
}

/// 色板 chip i 节点（id p<i> 供 onhit）。
fn pp_pal_item(pcolors List, pi int) str {
    var x int = pi * 24 + 12
    var col str = pcolors[pi]
    return f"p${pi},${x},14,rect,${col},24,28"
}

/// 光标水平 edge（ps,pv → 逻辑坐标）。
fn pp_cursor_edge_h(ps int, pv int) str {
    var x int = pp_half_up(ps * 192, 100)
    var y int = pp_half_up((100 - pv) * 192, 100)
    var y0 int = y - 5
    var y1 int = y + 5
    var xs str = f"${x}"
    var ys0 str = f"${y0}"
    var ys1 str = f"${y1}"
    return f"${xs},${ys0},${xs},${ys1},#ffffff,1"
}

/// 光标垂直 edge。
fn pp_cursor_edge_v(ps int, pv int) str {
    var x int = pp_half_up(ps * 192, 100)
    var y int = pp_half_up((100 - pv) * 192, 100)
    var x0 int = x - 5
    var x1 int = x + 5
    var ys str = f"${y}"
    var xs0 str = f"${x0}"
    var xs1 str = f"${x1}"
    return f"${xs0},${ys},${xs1},${ys},#ffffff,1"
}
