use auto.json

// PLAN-088 T-04 引擎隔离探针：包模块引擎 fn 在 VM 上的已知值核对（不走
// canvas/pen）。
widget App {
    msg { Init, Tick, Quit2 }
    model {
        var interval int = 1000
        var row1 str = "-"
        var row2 str = "-"
        var row3 str = "-"
        var row4 str = "-"
        var row5 str = "-"
    }
    use { package: color_picker from "../../../../../packages/color-picker" }
    view {
        col (style: "w-full h-full bg-background text-foreground gap-2 p-4") {
            text .row1 { style: "text-sm" }
            text .row2 { style: "text-sm" }
            text .row3 { style: "text-sm" }
            text .row4 { style: "text-sm" }
            text .row5 { style: "text-sm" }
            button "退出" { onclick: .Quit2, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
        }
    }
    on {
        .Init -> {
            .row1 = f"hsv(217,50,50,204) = ${cp_hsv_hex(217, 50, 50, 204)} 期望 #405980CC"
            .row2 = f"rgb(57,116,230,204) = ${cp_rgb_hex8(57, 116, 230, 204)} 期望 #3974E6CC"
            .row3 = f"hsv(217,76,90,204) = ${cp_hsv_hex(217, 76, 90, 204)} 期望 #377AE6CC"
            var hsv int = cp_hsv_of("#3974E6CC")
            .row4 = f"hsv_of(#3974E6CC) = ${hsv} 期望 21975090"
            var norm str = cp_hex_norm("#3974e6cc")
            .row5 = f"norm(#3974e6cc) = ${norm} 期望 #3974E6CC"
        }
        .Tick -> {}
        .Quit2 -> {
            ui.close()
        }
    }
}
