name: "music-player"
version: "2.0.0"
description: "AutoMusic Player - Modern Local & Stream Music Player (QQ Music / NetEase / Spotify / Soda Music style)"

scene: "ui"
render: "vue"
api: "rust"
front_port: 3020
back_port: 8320
media_root: "E:\\Music\\"
icon: "music"
title: "AutoMusic Player"
title_zh: "极光音乐播放器"
category: "media"
desktop: "true"
theme: "dark"
accent: "emerald"

dep stylekit {
    path: "../stylekit"
}

# PLAN-045 T-03：接入官方主题包（C-13）。pac 显式 theme/accent 键保留
# （020 既有默认 dark/emerald；emerald 属应用自定义 accent 面，官方表外回退
# indigo），族/模式选择经根 widget theme_name + design 数据绑定。
dep themes {
    path: "../../../packages/themes"
}
