// api.at — 030-video-player backend API.
// Control-plane API for 030-video-player.
// Media indexing and streaming are served automatically via /api/media/scan and /api/media/stream/:id.

pub type PlayerInfo = {
    status: str
    version: str
}

/// GET /api/player/status — check player backend service status.
#[api(method = "GET", path = "/api/player/status")]
pub fn status() []PlayerInfo {
    return []
}
