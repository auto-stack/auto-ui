// pac.at - Charts 图表工坊（App 轨道填洞 ①·Plan 445）
//
// 编辑数据/切换类型/观察渲染的交互式图表 demo——AutoOS 系统监视器与
// 图表应用的孵化形态。M1 vue 先行；M3 补 vm 实机（038 双后端惯例）。

name: "charts"
version: "0.1.0"
description: "Charts playground - edit series, switch chart type, watch geometry recompute (vue/vm)"

scene: "ui"
render: "vue"
title: "Charts"
title_zh: "图表"
front_port: 4024
desktop: "true"

dep stylekit {
    path: "../stylekit"
}

# PLAN-047 T-03：接入官方主题包（C-13）。024 无主题接线、无显式默认 →
# 官方 Auto/light 独立默认（B2 同律）。series 身份色（#2563eb/#16a34a/
# #d97706/#dc2626，图例点与四类图组件默认 colors）为数据内容色豁免——
# 换肤不改 series→颜色映射与几何数据。
dep themes {
    path: "../../../packages/themes"
}
