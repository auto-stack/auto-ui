use minesweeper_store: MinesweeperStore

// PLAN-037 T-05：接入官方主题包（原无主题接线、无显式默认 → 官方 Auto/light
// 独立默认）。雷盘壳面已逐字段映射公共 role；数字/雷/旗/LCD 身份色维持
// 字面豁免——换肤不改雷盘数据/计时/难度，确定性首击(4,4)展开不变。
use themes.themes: Auto, Solarized

widget App {
    msg {
        Reveal(int, int),
        Flag(int, int),
        SetDifficulty(str),
        Reset,
        Tick,
        Init,
    }

    model {
        var interval int = 1000
        var mounted int = 0
        // PLAN-037：主题族/模式选择态（主题选择，非业务状态）
        var theme_name str = "Auto"
        var dark_mode bool = false
    }

    // 主题/模式选择器（C-14：数据绑定，同帧校验发布；PLAN-037）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    // Plan 506 & Plan 017: 外壳"内容即页面"，配合 pac `window: "fit"` 窗口随内容收缩。
    // PLAN-017 UI/UX 现代化重构：深色现代仪表板 + 表情状态机 + 分段难度控件 + 无缝网格。
    view {
        col {
            // —— 顶栏信息与 LCD 仪表板 ——
            row {
                // 剩余雷数 LCD 盒
                row {
                    text .store.mines_label {
                        style: "text-base font-bold font-mono text-rose-400"
                    }
                    style: "bg-background border border-border px-3 py-1.5 rounded-xl items-center shadow-inner"
                }

                // 表情重开按钮
                button .store.face_icon {
                    onclick: .Reset,
                    style: "text-2xl px-3.5 py-1 bg-muted hover:bg-secondary active:scale-95 rounded-xl border border-input shadow-md"
                }

                // 计时器 LCD 盒
                row {
                    text .store.timer_label {
                        style: "text-base font-bold font-mono text-amber-400"
                    }
                    style: "bg-background border border-border px-3 py-1.5 rounded-xl items-center shadow-inner"
                }
                style: "w-full items-center justify-between"
            }

            // —— 难度分段选择器 ——
            row {
                button "初级 9×9" {
                    onclick: .SetDifficulty("beginner"),
                    class: .store.beginner_class
                }
                button "中级 16×16" {
                    onclick: .SetDifficulty("intermediate"),
                    class: .store.intermediate_class
                }
                button "高级 30×16" {
                    onclick: .SetDifficulty("expert"),
                    class: .store.expert_class
                }
                style: "bg-card border border-border p-1 rounded-xl gap-1 items-center"
            }

            // —— 棋盘网格 ——
            div {
                grid {
                    for cell in .store.board {
                        button {
                            text cell.display {
                                style: cell.number_class
                            }
                            onclick: .Reveal(cell.x, cell.y),
                            oncontextmenu.prevent: .Flag(cell.x, cell.y),
                            class: cell.cell_class
                        }
                    }
                    cols: .store.cols
                    gap: 0
                }
                style: "p-1.5 bg-background/80 border border-border rounded-xl shadow-2xl items-center"
            }

            // —— 游戏状态提示 ——
            if .store.game_state == "won" {
                text "🎉 胜利! 所有地雷已排除" {
                    style: "text-lg font-bold text-emerald-400 mt-1"
                }
            }
            if .store.game_state == "lost" {
                text "💥 踩雷了! 点表情重开" {
                    style: "text-lg font-bold text-rose-500 mt-1"
                }
            }

            style: "max-w-fit p-4 items-center gap-3.5 bg-card/40 rounded-2xl border border-border/60"
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .Reset -> {
            store.Reset()
        }

        .SetDifficulty(d) -> {
            store.SetDifficulty(d)
        }

        .Reveal(x, y) -> {
            store.Reveal(x, y)
        }

        .Flag(x, y) -> {
            store.Flag(x, y)
        }

        .Tick -> {
            store.Tick()
        }
    }
}
