// pac.at — 028-launcher（Plan 464）。
//
// 桌面 launcher：palette（搜索 + 模糊过滤 + 键盘流）/ grid 两形态的真注册表
// 启动器。desktop 模式下由桌面 shell 以 overlay 槽召唤（463 SummonLauncher），
// 独立模式（`auto run`，vue 调试）自管开关 + 内嵌 mock 清单（I3 配置差异）。
//
// front_port: 4028 沿用 Plan 441 预订；icon 由 463 T7 注册表消费（缺省回退
// app-window）。render 声明 "vue"（开发目标端）；vm 兼容性由 T3/T4 实机验收
// 兜底（注册表扫描不过滤 render——463 T7 定案，声明的 render 是前端目标）。

name: "launcher"
version: "0.1.0"
description: "Desktop launcher - palette/grid app search & launch (vue/vm)"

scene: "ui"
render: "vue"
front_port: 4028
icon: "search"
title: "Launcher"
title_zh: "启动器"

# PLAN-037 T-05：官方主题单源包（不复制配色表进本 app，C-13）。
# 本例原无主题接线、无显式默认——独立默认官方 Auto/light；palette/grid
# 公共表面随族，品牌色 hex（宿主注入/mock 数据）维持内容色字面豁免。
dep themes {
    path: "../../../packages/themes"
}
category: "system"
desktop: "true"
