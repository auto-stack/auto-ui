// app.at — 028-launcher 根组件（Plan 464）。
//
// 形态：palette（搜索 + 模糊过滤 + 选中高亮 + 键盘流）与 grid（图标网格，
// T2）两形态的 overlay，由 `visible` 状态变量门控。desktop 模式下宿主经
// 463 接缝注入：SummonLauncher → visible="1"、应用清单 → `apps`、
// `__wm_*` 同型的状态注入（I3：数据来源差异，非代码分叉）；独立模式
// （`auto run`）内嵌 mock 清单 + 页面按钮自管开关。
//
// 单组件约束（025-dashboard 形态，双端转译实测结论，464 T1 盘点）：
//   - 模块级 fn 不进 vue SFC（024 先例 + 本计划探针复证）→ 模糊排序写成
//     状态法 handler（.ApplyFilter：读 q/apps/recent，写 ranked，纯状态变换，
//     规则钉死在 SPEC.md）；
//   - store 子组件的 vue TS 生成损坏（013/038 实测）→ 全部状态内聚 App；
//   - 模板文本插值里不能调 .len()（vue TS 编译错）→ 计数在 handler 算成
//     字符串/数值状态（.gcount）。
// 字符串比较一律针对预小写字段（ln/lt，mock 字面量给出、宿主注入时由宿主
// 预小写）：排序权重全整数，规避浮点/字符宽度双端差（SPEC §排序）。

// PLAN-037 T-05：接入官方主题包（原无主题接线、无显式默认 → 官方
// Auto/light 独立默认）。family 经 theme_name + design 绑定；键盘流/
// recent 存储/宿主接缝零改动——换肤不丢查询/选中/recent。
use auto.json
use themes.themes: Auto, Solarized

widget App {
    use { package: command_palette from "../../../../../packages/command-palette" }

    msg {
        Init, SetQ(str), ApplyFilter, MoveUp, MoveDown, MoveLeft, MoveRight,
        Pick, Escape, SwitchMode, ShowGrid, Open, Close, Launch(str), PickCat(str),
        PaletteQuery(str), PaletteInvoke(str), PaletteClose(str)
    }

    model {
        // PLAN-037：主题族/模式选择态（主题选择，非业务状态）
        var theme_name str = "Auto"
        var dark_mode bool = false
        // ---- 接缝状态（desktop 宿主注入；独立模式恒默认值）----
        var visible str = "0"       // overlay 门控：宿主 SummonLauncher 置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"：隐藏独立模式的开门按钮
        var __desktop_cmd str = ""  // 上行命令总线（DesktopBus v1 记录形）
        var __focus_input str = "0" // 聚焦请求：置 "1" → 宿主聚焦 palette 输入框（消费即清零）

        // ---- 形态 ----
        var mode str = "palette"    // palette | grid

        // ---- Plan 503 分类胶囊 ----
        var cat str = "all"         // 当前分类（"all" = 全部）
        var cats = ["all", "tool", "task", "life", "notes", "social", "reading", "media", "data", "system", "game", "editor"]
        // PLAN-013 W2：零结果分类隐藏——ApplyFilter 期按注册表计数过滤。
        var cats_visible = ["all"]

        // ---- 查询与结果 ----
        var q str = ""
        var ranked = []             // {i,name,title,icon,category,mg,sub,chip,tchip}
        var palette_items List = []
        var palette_ids List<str> = []
        var palette_instance str = ""
        var palette_session int = 0
        var palette_query_seq int = 0
        var palette_query str = ""
        var palette_revision int = 0
        var palette_response str = ""

        // ---- 网格形态（P5，对标 Activities/Launchpad）----
        var gridrows = []           // {gi,name,title,mg,category,chip,tchip} 注册表序全量
        var gsel int = 0            // 网格焦点索引（由应用持有）
        var gcount str = ""

        // ---- 注册表（独立模式 mock；desktop 模式宿主覆盖同名列表）----
        // 注入/存储形态 = 平行字符串列表（Obj 数组的 VM handler 字段读失效
        // ——B12 同族，464 探针钉死；字符串列表下标读保真）。
        // ln/lt = name/title 的预小写副本（匹配用，见文件头注）。
        // colors = 品牌色 6 位 hex（Plan 503；宿主注入同型——图标底块
        // bg-[<color>21]（13% alpha）/字形 text-[<color>] 双端同源）。
        var apps_names = [
            "011-calculator", "012-stopwatch", "013-todo", "014-weather",
            "015-notes", "017-chat", "018-book-reader", "020-music-player",
            "024-charts", "025-sys-monitor", "038-minesweeper", "041-auto-edit"
        ]
        var apps_titles = [
            "Calculator", "Stopwatch", "Todo", "Weather",
            "Notes", "Chat", "Books", "Music",
            "Charts", "系统监视器", "Minesweeper", "Auto Edit"
        ]
        var apps_icons = [
            "calculator", "timer", "check-square", "cloud-sun",
            "notebook-pen", "message-circle", "book-open", "music",
            "bar-chart-3", "activity", "bomb", "file-code"
        ]
        var apps_cats = [
            "tool", "tool", "task", "life",
            "notes", "social", "reading", "media",
            "data", "system", "game", "editor"
        ]
        var apps_colors = [
            "#7c9a6d", "#b88c61", "#6a8bad", "#7d9ec4",
            "#c9a77e", "#8d7ab5", "#a47551", "#c4706a",
            "#6fa3a7", "#9a8fb8", "#8a9b6e", "#5f8d78"
        ]
        var apps_lns = [
            "011-calculator", "012-stopwatch", "013-todo", "014-weather",
            "015-notes", "017-chat", "018-book-reader", "020-music-player",
            "024-charts", "025-sys-monitor", "038-minesweeper", "041-auto-edit"
        ]
        var apps_lts = [
            "calculator", "stopwatch", "todo", "weather",
            "notes", "chat", "books", "music",
            "charts", "sys-monitor", "minesweeper", "auto edit"
        ]
        var recent = []             // 启动名记录，最近在前，上限 5（storage 持久化）
        var last str = ""           // 最近一次启动（演示/断言锚）
    }

    // 主题/模式选择器（C-14：数据绑定，同帧校验发布；PLAN-037）
    design {
        theme: .theme_name
        mode: if .dark_mode { "dark" } else { "light" }
    }

    view {
        if .visible == "1" {
            if .mode == "palette" {
                CommandPalette (open: true, title: "Launcher", placeholder: "Search apps…",
                    commands: .palette_items, filterMode: "provided", query: .q, wrapNavigation: true,
                    revision: .palette_revision, resultsSession: .palette_session,
                    resultsQuerySeq: .palette_query_seq, resultsQuery: .palette_query,
                    response: .palette_response, onqueryChanged: .PaletteQuery,
                    oninvokeRequested: .PaletteInvoke, oncloseRequested: .PaletteClose) {
                    row (style: "w-full flex-wrap items-center gap-1") {
                        for category in .cats_visible key: category {
                            button (text: category, onclick: .PickCat(category),
                                style: if category == .cat { "h-8 rounded-md px-2 bg-accent" } else { "h-8 rounded-md px-2 bg-transparent" }) {}
                        }
                        button "Grid view" { onclick: .ShowGrid, style: "h-8 rounded-md" }
                    }
                }
            } else {
                // ---- grid 形态（P5）：图标网格（注册表序全量）+ 方向键焦点
                //（Plan 503：语义 scrim + 卡片三件套 + 品牌色瓦片）----
                // PLAN-010 N6d：外点关闭（同 palette 形态）。
                mouse-area (onclick: .Close) {
                col {
                    style: "w-full h-full bg-background/60 flex flex-col items-center"
                    spacer { style: "h-24 w-full" }
                    // PLAN-010 N6d：卡片守卫（同 palette 形态）。
                    mouse-area (onclick: .ApplyFilter, style: "w-full max-w-2xl") {
                    col {
                        style: "w-full bg-card/80 border rounded-2xl shadow-2xl p-6"
                        // PLAN-013 W2：grid 形态保留 search 行（与 palette
                        // 同一 input 绑定，Tab 切换后持焦不丢）。
                        row {
                            style: "flex items-center gap-2 px-4 py-3 border-b"
                            text "🔍" { style: "text-lg" }
                            input {
                                value: .q
                                oninput: .SetQ
                                onenter: .Pick
                                placeholder: "Search apps…"
                                style: "flex-1 text-lg text-foreground bg-background/50 rounded-lg px-2"
                            }
                        }
                        row {
                            style: "flex items-center mb-4"
                            text "All apps" { style: "text-foreground text-sm" }
                            text .gcount { style: "ml-auto text-xs text-muted-foreground" }
                        }
                        // 2026-09-15 用户裁定：5 列（原 4 列横向过疏）+ 网格
                        // 区限高滚动——卡片总高不得超过任务栏，超出出滚动条
                        //（max-h + overflow-y-auto，palette 结果列同款机制）。
                        col {
                            style: "w-full max-h-[440px] overflow-y-auto"
                        grid {
                            cols: 5
                            gap: 3
                            for g in .gridrows {
                                if .gsel == g.gi {
                                    col {
                                        onclick: .Launch(g.name)
                                        style: "flex flex-col items-center gap-2 p-3 rounded-xl bg-primary/15 cursor-pointer"
                                        // 用户裁定（2026-09-15，沿桌面 PLAN-018-FU2
                                        // 「保留原图圆角板、外框不要」）：iconfile
                                        // 位图自带圆角板——满幅渲染不再套 chip 外框
                                        //（原 h-7 位图居中在 48px chip 里显小）；
                                        // 裸 lucide 字标保持品牌色 chip + glyph。
                                        if g.full == "1" {
                                            icon (name: g.icon) { style: "h-12 w-12" }
                                        } else {
                                            col {
                                                style: "h-12 w-12 rounded-xl flex items-center justify-center ${g.chip}"
                                                icon (name: g.icon) { style: "h-7 w-7" }
                                            }
                                        }
                                        text g.title { style: "text-primary text-xs text-center" }
                                    }
                                } else {
                                    col {
                                        onclick: .Launch(g.name)
                                        // PLAN-002 B：布局件 hover 类消费（此前 col
                                        // 的 hover: 静默丢弃——526 Q9① 实测网格态
                                        // 无高亮；VM 轨现与 Vue 原生 :hover 同效）。
                                        style: "flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-primary/10 cursor-pointer"
                                        // 满幅/chip 分流（同上聚焦格）。
                                        if g.full == "1" {
                                            icon (name: g.icon) { style: "h-12 w-12" }
                                        } else {
                                            col {
                                                style: "h-12 w-12 rounded-xl flex items-center justify-center ${g.chip}"
                                                icon (name: g.icon) { style: "h-7 w-7" }
                                            }
                                        }
                                        text g.title { style: "text-foreground text-xs text-center" }
                                    }
                                }
                            }
                        }
                        }
                        row {
                            style: "flex items-center gap-4 mt-4 pt-3 border-t"
                            text "↑↓←→ move" { style: "text-xs text-muted-foreground" }
                            text "Enter launch" { style: "text-xs text-muted-foreground" }
                            text "Tab palette" { style: "text-xs text-muted-foreground" }
                        }
                    }
                    }
                    spacer { style: "h-24 w-full" }
                }
                }
            }
        } else {
            // ---- 隐藏态：透明空层（desktop 不挡桌面点击；独立模式给开门按钮
            //（Plan 503：语义 token 化））----
            col {
                style: "w-full h-full"
                if .hosted == "0" {
                    row {
                        style: "w-full h-full flex flex-col items-center justify-center bg-background gap-4"
                        button "🔍 Open launcher (Ctrl+Space · IME 机 Ctrl+Alt+Space)" {
                            onclick: .Open
                            style: "px-4 py-2 bg-primary text-primary-foreground rounded-xl shadow"
                        }
                        if .last != "" {
                            text f"Last launched: ${.last}" { style: "text-sm text-muted-foreground" }
                        }
                    }
                }
            }
        }
    }

    bind {
        "ArrowUp" -> .MoveUp
        "ArrowDown" -> .MoveDown
        "ArrowLeft" -> .MoveLeft
        "ArrowRight" -> .MoveRight
        "Enter" -> .Pick
        "Escape" -> .Escape
        "Tab" -> .SwitchMode
        "Ctrl+ " -> .Open
    }

    on {
        .Init -> {
            .q = ""
            .gsel = 0
            .mode = "palette"
            .visible = "0"
            .cat = "all"
            // recent 持久化恢复（018/025 storage 先例）。定长 5 槽键：
            // storage.get → localStorage.getItem 产出 string|null，vue 生成码
            // 不带 ?? ''，对结果调方法会 TS18047 —— 槽值只做 != "" 比较（实测）。
            var r0 = storage.get("launcher.recent_apps.0")
            if r0 != "" { .recent.push(r0) }
            var r1 = storage.get("launcher.recent_apps.1")
            if r1 != "" { .recent.push(r1) }
            var r2 = storage.get("launcher.recent_apps.2")
            if r2 != "" { .recent.push(r2) }
            var r3 = storage.get("launcher.recent_apps.3")
            if r3 != "" { .recent.push(r3) }
            var r4 = storage.get("launcher.recent_apps.4")
            if r4 != "" { .recent.push(r4) }
            .ApplyFilter()
        }

        .Open -> {
            .visible = "1"
            .mode = "palette"
            .__focus_input = "1"
            .ApplyFilter()
        }

        .Close -> {
            .visible = "0"
            .palette_instance = ""
        }

        .SetQ(t) -> {
            .q = t
            .ApplyFilter()
        }

        // Plan 503 分类胶囊：切分类 → 焦点复位重排。
        .PickCat(c) -> {
            .cat = c
            .ApplyFilter()
        }

        // 模糊排序（纯状态变换；规则 = SPEC.md「排序」节的唯一实现）：
        // 空查询 → recent 置顶分组 + 注册表序全量；非空 → 打分
        // exact(0) > prefix(1) > 词首(2) > 子序列(3)，同分按注册表序，
        // recent 在同档内前移（折扣 5..1，不足以跨档）。
        //
        // 实现注记（464 T4）：注册表注入/存储形态为平行字符串列表
        // （apps_names/titles/icons/cats/lns/lts）——Obj 数组的 VM handler
        // 字段读失效（B12 同族，探针测试钉死），字符串列表下标读保真；
        // ranked/gridrows 行对象为 handler 自建（view 侧读取已证可用）。
        .ApplyFilter -> {
            // PLAN-013 W2：零结果分类隐藏（注册表计数过滤）。
            .RebuildCats()
            .ranked = []
            var ql str = .q.lower()
            var napps int = .apps_names.len()

            if ql == "" {
                // —— 空查询：recent 分组（存在的才列，Plan 503 过分类门）+ 其余注册表序 ——
                var ri int = 0
                while ri < .recent.len() {
                    var ai int = 0
                    while ai < napps {
                        if .apps_names[ai] == .recent[ri] {
                            if .cat == "all" || .apps_cats[ai] == .cat {
                                // full = iconfile 位图旗标（view 满幅渲染、免 chip 外框）
                                var ic1 str = .apps_icons[ai]
                                var f1 str = ""
                                if ic1.len() >= 9 {
                                    if ic1.slice(0, 9) == "iconfile:" {
                                        f1 = "1"
                                    }
                                }
                                var row = { i: .ranked.len(), name: .apps_names[ai], title: .apps_titles[ai], icon: ic1, category: .apps_cats[ai], mg: .apps_titles[ai].slice(0, 1), sub: "recent", chip: "bg-[" + .apps_colors[ai] + "21]", tchip: "text-[" + .apps_colors[ai] + "]", full: f1 }
                                .ranked.push(row)
                            }
                        }
                        ai = ai + 1
                    }
                    ri = ri + 1
                }
                var ak int = 0
                while ak < napps {
                    var seen int = 0
                    var rj int = 0
                    while rj < .recent.len() {
                        if .recent[rj] == .apps_names[ak] {
                            seen = 1
                        }
                        rj = rj + 1
                    }
                    if seen == 0 {
                        if .cat == "all" || .apps_cats[ak] == .cat {
                            var ic2 str = .apps_icons[ak]
                            var f2 str = ""
                            if ic2.len() >= 9 {
                                if ic2.slice(0, 9) == "iconfile:" {
                                    f2 = "1"
                                }
                            }
                            var row2 = { i: .ranked.len(), name: .apps_names[ak], title: .apps_titles[ak], icon: ic2, category: .apps_cats[ak], mg: .apps_titles[ak].slice(0, 1), sub: .apps_cats[ak], chip: "bg-[" + .apps_colors[ak] + "21]", tchip: "text-[" + .apps_colors[ak] + "]", full: f2 }
                            .ranked.push(row2)
                        }
                    }
                    ak = ak + 1
                }
            } else {
                // —— 打分：score = tier*100 + 注册表序 - recent 折扣 ——
                var scored = []
                var si int = 0
                while si < napps {
                    var ln str = .apps_lns[si]
                    var lt str = .apps_lts[si]
                    var tier int = 99

                    if ln == ql || lt == ql {
                        tier = 0
                    }
                    if tier == 99 {
                        // 前缀
                        if lt.len() >= ql.len() {
                            if lt.slice(0, ql.len()) == ql {
                                tier = 1
                            }
                        }
                    }
                    if tier == 99 {
                        // 前缀（id 同档——PLAN-015 回归修复：展示名转中文
                        // （title_zh locale 链）后 lt 失去拉丁形态，"term"
                        // 等 id 子串查询仅剩整 id 精确匹配可命中；ln=id
                        // 预小写键宿主恒注入（renderer 464 接缝），补入
                        // 三档模糊。)
                        if ln.len() >= ql.len() {
                            if ln.slice(0, ql.len()) == ql {
                                tier = 1
                            }
                        }
                    }
                    if tier == 99 {
                        // 词首（位置 0 或 空格/-/_ 之后）
                        var p int = 0
                        while p < lt.len() {
                            var hit int = 0
                            if p == 0 {
                                hit = 1
                            } else {
                                var pc str = lt.slice(p - 1, p)
                                if pc == " " || pc == "-" || pc == "_" {
                                    hit = 1
                                }
                            }
                            if hit == 1 {
                                if lt.len() - p >= ql.len() {
                                    if lt.slice(p, p + ql.len()) == ql {
                                        tier = 2
                                    }
                                }
                            }
                            p = p + 1
                        }
                    }
                    if tier == 99 {
                        // 词首（id 同档——"term" 命中 "auto-term" 的 '-' 后词首）
                        var p2 int = 0
                        while p2 < ln.len() {
                            var hit2 int = 0
                            if p2 == 0 {
                                hit2 = 1
                            } else {
                                var pc2 str = ln.slice(p2 - 1, p2)
                                if pc2 == " " || pc2 == "-" || pc2 == "_" {
                                    hit2 = 1
                                }
                            }
                            if hit2 == 1 {
                                if ln.len() - p2 >= ql.len() {
                                    if ln.slice(p2, p2 + ql.len()) == ql {
                                        tier = 2
                                    }
                                }
                            }
                            p2 = p2 + 1
                        }
                    }
                    if tier == 99 {
                        // 子序列（双指针）
                        var qi int = 0
                        var sj int = 0
                        while sj < lt.len() {
                            if qi < ql.len() {
                                if lt.slice(sj, sj + 1) == ql.slice(qi, qi + 1) {
                                    qi = qi + 1
                                }
                            }
                            sj = sj + 1
                        }
                        if qi == ql.len() {
                            tier = 3
                        }
                    }
                    if tier == 99 {
                        // 子序列（id 同档）
                        var qi2 int = 0
                        var sj2 int = 0
                        while sj2 < ln.len() {
                            if qi2 < ql.len() {
                                if ln.slice(sj2, sj2 + 1) == ql.slice(qi2, qi2 + 1) {
                                    qi2 = qi2 + 1
                                }
                            }
                            sj2 = sj2 + 1
                        }
                        if qi2 == ql.len() {
                            tier = 3
                        }
                    }

                    var score int = tier * 100 + si
                    if tier < 99 {
                        // recent 折扣：最近者折扣最大（5..1），仅同档内重排
                        var rk int = 0
                        while rk < .recent.len() {
                            if .recent[rk] == ln {
                                var disc int = 5 - rk
                                if disc < 1 {
                                    disc = 1
                                }
                                score = score - disc
                            }
                            rk = rk + 1
                        }
                    }
                    var srow = { name: .apps_names[si], title: .apps_titles[si], icon: .apps_icons[si], category: .apps_cats[si], score: score, color: .apps_colors[si] }
                    scored.push(srow)
                    si = si + 1
                }

                // 选择排序输出（score 升序；9900 = 不匹配不输出；
                // 同分先到先得 = 注册表序稳定）。下标访问只碰 scored/used
                // （handler 自建，T3 实证可用）。
                var n int = scored.len()
                var used = []
                var u int = 0
                while u < n {
                    used.push(0)
                    u = u + 1
                }
                var placed int = 0
                while placed < n {
                    var best int = -1
                    var bestScore int = 0
                    var bi int = 0
                    while bi < n {
                        if used[bi] == 0 {
                            var sc int = scored[bi].score
                            if sc < 9900 {
                                if best == -1 {
                                    best = bi
                                    bestScore = sc
                                } else {
                                    if sc < bestScore {
                                        best = bi
                                        bestScore = sc
                                    }
                                }
                            }
                        }
                        bi = bi + 1
                    }
                    if best == -1 {
                        placed = n
                    } else {
                        // Plan 503：非选中分类不出列（分数序保持稳定）。
                        if .cat == "all" || scored[best].category == .cat {
                            var ic3 str = scored[best].icon
                            var f3 str = ""
                            if ic3.len() >= 9 {
                                if ic3.slice(0, 9) == "iconfile:" {
                                    f3 = "1"
                                }
                            }
                            var row3 = { i: .ranked.len(), name: scored[best].name, title: scored[best].title, icon: ic3, category: scored[best].category, mg: scored[best].title.slice(0, 1), sub: scored[best].category, chip: "bg-[" + scored[best].color + "21]", tchip: "text-[" + scored[best].color + "]", full: f3 }
                            .ranked.push(row3)
                        }
                        used[best] = 1
                        placed = placed + 1
                    }
                }
            }

            // Project the existing ranking in place. The palette owns selection.
            var command_results List = []
            var ranked_ids List<str> = []
            for item in .ranked {
                let group = if item.sub == "recent" { "recent" } else { item.category }
                let label = if group == "recent" { "Recent" } else { group }
                command_results.push({id: item.name, label: item.title, groupId: group, groupLabel: label,
                    keywords: [], shortcut: "", disabled: false, icon: item.icon})
                ranked_ids.push(item.name)
            }
            .palette_items = command_results
            .palette_ids = ranked_ids
            .palette_revision = .palette_revision + 1

            // 网格行（注册表序全量，与查询无关）；gsel 夹取 + 计数
            .gridrows = []
            var gi2 int = 0
            while gi2 < napps {
                var ic4 str = .apps_icons[gi2]
                var f4 str = ""
                if ic4.len() >= 9 {
                    if ic4.slice(0, 9) == "iconfile:" {
                        f4 = "1"
                    }
                }
                var row4 = { gi: .gridrows.len(), name: .apps_names[gi2], title: .apps_titles[gi2], icon: ic4, mg: .apps_titles[gi2].slice(0, 1), category: .apps_cats[gi2], chip: "bg-[" + .apps_colors[gi2] + "21]", tchip: "text-[" + .apps_colors[gi2] + "]", full: f4 }
                .gridrows.push(row4)
                gi2 = gi2 + 1
            }
            if .gridrows.len() > 0 {
                if .gsel >= .gridrows.len() {
                    .gsel = .gridrows.len() - 1
                }
                var gi3 int = .gsel + 1
                .gcount = f"${gi3} / ${.gridrows.len()} apps"
            } else {
                .gcount = "0 apps"
            }
        }

        .MoveUp -> {
            if .visible == "1" && .mode == "grid" {
                // Grid moves by one row (four columns), wrapping within the column.
                var n int = .gridrows.len()
                if n > 0 {
                    var g int = .gsel
                    if g < 4 { g = g - 4 + n } else { g = g - 4 }
                    .gsel = g
                    .ApplyFilter()
                }
            }
        }

        .MoveDown -> {
            if .visible == "1" && .mode == "grid" {
                var n int = .gridrows.len()
                if n > 0 {
                    var g int = .gsel + 4
                    if g >= n { g = g - n }
                    .gsel = g
                    .ApplyFilter()
                }
            }
        }

        .MoveLeft -> {
            if .visible == "1" {
            if .mode == "grid" {
                var n4 int = .gridrows.len()
                if n4 > 0 {
                    var g3 int = .gsel
                    if g3 == 0 {
                        g3 = n4 - 1
                    } else {
                        g3 = g3 - 1
                    }
                    .gsel = g3
                    .ApplyFilter()
                }
            }
            }
        }

        .MoveRight -> {
            if .visible == "1" {
            if .mode == "grid" {
                var n5 int = .gridrows.len()
                if n5 > 0 {
                    var g4 int = .gsel + 1
                    if g4 >= n5 {
                        g4 = 0
                    }
                    .gsel = g4
                    .ApplyFilter()
                }
            }
            }
        }

        .Pick -> {
            if .visible == "1" && .mode == "grid" && .gsel < .gridrows.len() {
                .Launch(.gridrows[.gsel].name)
            }
        }

        .Escape -> {
            if .visible == "1" && .mode == "grid" {
                if .q != "" {
                    .q = ""
                    .ApplyFilter()
                } else {
                    .mode = "palette"
                }
            }
        }

        .PaletteQuery(payload) -> {
            let request = json.parse(payload)
            if .visible == "1" && .mode == "palette" {
                .palette_instance = request.instanceToken
                .palette_session = request.session
                .palette_query_seq = request.querySeq
                .palette_query = request.query
                .q = request.query
                .palette_response = ""
                .ApplyFilter()
            }
        }

        .PaletteInvoke(payload) -> {
            let request = json.parse(payload)
            if .visible != "1" || .mode != "palette" ||
                request.instanceToken != .palette_instance || request.session != .palette_session ||
                request.querySeq != .palette_query_seq || request.query != .palette_query ||
                request.baseRevision != .palette_revision { return }
            let name str = request.commandId
            var available bool = false
            var i int = 0
            while i < .apps_names.len() {
                if .apps_names[i] == name && (.cat == "all" || .apps_cats[i] == .cat) {
                    available = true
                }
                i = i + 1
            }
            if !available { return }
            var offered bool = false
            for id in .palette_ids {
                if id == name { offered = true }
            }
            if !offered { return }
            if .hosted == "1" {
                .Launch(name)
            } else {
                .palette_response = json.stringify({instanceToken: request.instanceToken, session: request.session,
                    seq: request.seq, commandId: name, status: "rejected", message: "App launching requires the AutoOS desktop."})
            }
        }

        .PaletteClose(payload) -> {
            let request = json.parse(payload)
            if .visible == "1" && request.instanceToken == .palette_instance && request.session == .palette_session {
                .Close()
            }
        }

        // Tab：palette ↔ grid
        // PLAN-013 W2：可见分类重建——注册表计数 >0 的分类才出 tag。
        .RebuildCats -> {
            .cats_visible = ["all"]
            var ci int = 0
            while ci < .cats.len() {
                var c = .cats[ci]
                if c != "all" {
                    var cnt int = 0
                    var ai int = 0
                    while ai < .apps_names.len() {
                        if .apps_cats[ai] == c {
                            cnt = cnt + 1
                        }
                        ai = ai + 1
                    }
                    if cnt > 0 {
                        .cats_visible.push(c)
                    }
                }
                ci = ci + 1
            }
        }

        .SwitchMode -> {
            if .visible == "1" && .mode == "grid" {
                .mode = "palette"
                .__focus_input = "1"
            }
        }

        .ShowGrid -> {
            if .visible == "1" && .mode == "palette" {
                .mode = "grid"
                .__focus_input = "1"
            }
        }

        // 启动（R11）：写上行总线 + recent + 隐匿。
        // desktop 模式宿主排空 `__desktop_cmd` 执行 LaunchApp；独立模式
        // 总线无人消费，仅演示（441 fallback 边界）。
        .Launch(name) -> {
            .last = name
            // recent：去重置顶，上限 5 + storage 持久化（逗号串序列化）
            var nr = []
            nr.push(name)
            var oi int = 0
            while oi < .recent.len() {
                if nr.len() < 5 {
                    if .recent[oi] != name {
                        nr.push(.recent[oi])
                    }
                }
                oi = oi + 1
            }
            .recent = nr
            // 定长 5 槽持久化（与 Init 恢复对称）
            if nr.len() > 0 { storage.set("launcher.recent_apps.0", nr[0]) } else { storage.set("launcher.recent_apps.0", "") }
            if nr.len() > 1 { storage.set("launcher.recent_apps.1", nr[1]) } else { storage.set("launcher.recent_apps.1", "") }
            if nr.len() > 2 { storage.set("launcher.recent_apps.2", nr[2]) } else { storage.set("launcher.recent_apps.2", "") }
            if nr.len() > 3 { storage.set("launcher.recent_apps.3", nr[3]) } else { storage.set("launcher.recent_apps.3", "") }
            if nr.len() > 4 { storage.set("launcher.recent_apps.4", nr[4]) } else { storage.set("launcher.recent_apps.4", "") }
            .__desktop_cmd = "launch\t" + name
            .visible = "0"
            .q = ""
            .ApplyFilter()
        }
    }
}
