use auto.file
use auto.json

widget selector {
    msg { Init, Open, OpenSingle, Accepted(str), Cancelled, Background, Quit, Error(str) }
    model {
        var pickerOpen bool = false
        var initialDirectory str = ""
        var backgroundCount int = 0
        var result str = ""
        var cancelCount int = 0
        var acceptedCount int = 0
        var selectionMode str = "multipleFiles"
        var lastError str = ""
    }
    view {
        col (style: "p-6 gap-4 w-full h-full bg-background text-foreground") {
            button "选择文件" { onclick: .Open }
            button "单选文件" { onclick: .OpenSingle }
            button "底层计数" { onclick: .Background }
            button "退出夹具" { onclick: .Quit }
            text f"底层次数 ${.backgroundCount}"
            text f"选择结果 ${.result}"
            text f"取消次数 ${.cancelCount}"
            text f"确认次数 ${.acceptedCount}"
            text f"错误事件 ${.lastError}"
            FileDialog (open: .pickerOpen, selectionMode: .selectionMode, initialDirectory: .initialDirectory, filters: [{id: "books", label: "书籍", extensions: ["txt", "md", "markdown", "epub"]}, {id: "images", label: "图片", extensions: ["png", "jpg", "jpeg", "webp"]}], onaccepted: .Accepted($event), oncancelled: .Cancelled, onerror: .Error($event)) {}
        }
    }
    on {
        .Init -> { .initialDirectory = Env.get("FILE_DIALOG_INITIAL_DIRECTORY") }
        .Background -> { .backgroundCount = .backgroundCount + 1 }
        .Open -> { .selectionMode = "multipleFiles"; .pickerOpen = true }
        .OpenSingle -> { .selectionMode = "singleFile"; .pickerOpen = true }
        .Quit -> { Process.exit(0) }
        .Error(value str) -> { .lastError = value }
        .Accepted(files str) -> {
            .acceptedCount = .acceptedCount + 1
            .result = json.parse(files).files[0].path
            .pickerOpen = false
            let output str = Env.get("FILE_DIALOG_RESULT_PATH")
            if output != "" { file.write_text(output, files) }
        }
        .Cancelled -> { .cancelCount = .cancelCount + 1; .pickerOpen = false }
    }
}
