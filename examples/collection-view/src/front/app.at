use auto.json

widget App {
    use { package: collection_view from "../../../../packages/collection-view" }
    msg { Init, ChangeView(str), Select(str), Act(str), Sort(str), Replace, Quit }
    model {
        var items List = []
        var columns List = []
        var mode str = "grid"
        var selected str = ""
        var scope str = "demo"
        var revision int = 1
        var collection_token str = ""
        var sort_key str = ""
        var sort_direction str = ""
        var result str = "尚未选择"
        var action_result str = ""
    }
    view {
        col (style: "w-full h-full min-h-0 bg-background text-foreground p-3") {
            row (style: "items-center justify-between gap-2") {
                text "资源视图演示" { style: "text-base font-semibold" }
                row (style: "items-center gap-2") {
                    button (text: "替换条目", onclick: .Replace, style: "h-8 px-2 border border-border rounded-md") {}
                    button (text: "退出演示", onclick: .Quit, style: "h-8 px-2 border border-border rounded-md") {}
                }
            }
            text .result { style: "text-sm" }
            if .action_result != "" {
                text .action_result { style: "text-sm" }
            }
            col (style: "flex-1 min-h-0") {
                CollectionView (
                    items: .items, columns: .columns, viewMode: .mode, selectedId: .selected,
                    scopeId: .scope, revision: .revision, sortKey: .sort_key, sortDirection: .sort_direction,
                    onviewModeRequested: .ChangeView($event), onselectionRequested: .Select($event),
                    onitemActionRequested: .Act($event), onsortRequested: .Sort($event)
                ) {}
            }
        }
    }
    on {
        .Init -> {
            let open = [{id: "open", label: "打开", enabled: true}]
            .columns = [
                {key: "name", label: "名称", align: "left", sortable: true},
                {key: "kind", label: "类型", align: "left", sortable: false}
            ]
            .items = [
                {id: "a", itemRevision: "1", label: "同名条目", kind: "folder", icon: "folder", thumbnailUri: "", thumbnailState: "missing", disabled: false, cells: [{key: "kind", text: "文件夹"}], actions: open, defaultActionId: "open"},
                {id: "b", itemRevision: "1", label: "同名条目", kind: "file", icon: "file-text", thumbnailUri: "", thumbnailState: "missing", disabled: false, cells: [{key: "kind", text: "文档"}], actions: open, defaultActionId: "open"},
                {id: "c", itemRevision: "1", label: "不可用条目", kind: "image", icon: "image", thumbnailUri: "", thumbnailState: "loading", disabled: true, cells: [{key: "kind", text: "图片"}], actions: open, defaultActionId: "open"}
            ]
        }
        .ChangeView(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    .collection_token = request.instanceToken
                    .mode = request.viewMode
                }
            } catch {}
        }
        .Select(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    var i int = 0
                    while i < .items.len() {
                        let item = .items[i]
                        if item.id == request.id && item.itemRevision == request.itemRevision && !item.disabled {
                            .collection_token = request.instanceToken
                            .selected = item.id
                            .result = "已选择 " + item.id
                        }
                        i = i + 1
                    }
                }
            } catch {}
        }
        .Act(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    var i int = 0
                    while i < .items.len() {
                        let item = .items[i]
                        if item.id == request.id && item.itemRevision == request.itemRevision && !item.disabled && request.actionId == "open" {
                            .collection_token = request.instanceToken
                            .action_result = "已打开 " + item.id
                        }
                        i = i + 1
                    }
                }
            } catch {}
        }
        .Sort(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) && request.sortKey == "name" {
                    .collection_token = request.instanceToken
                    let a = .items[0]
                    let b = .items[1]
                    let c = .items[2]
                    .items = [b, a, c]
                    .sort_key = "name"
                    .sort_direction = if .sort_direction == "asc" { "desc" } else { "asc" }
                    .revision = .revision + 1
                }
            } catch {}
        }
        .Replace -> {
            let b = .items[1]
            let c = .items[2]
            let a = {id: "a", itemRevision: "2", label: "同名条目", kind: "folder", icon: "folder", thumbnailUri: "", thumbnailState: "missing", disabled: false, cells: [{key: "kind", text: "文件夹"}], actions: [{id: "open", label: "打开", enabled: true}], defaultActionId: "open"}
            .items = [b, c, a]
            .revision = .revision + 1
        }
        .Quit -> { Process.exit(0) }
    }
}
