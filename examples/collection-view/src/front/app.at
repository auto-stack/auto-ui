use auto.json
use collection_view.collection_schema: CollectionAction, CollectionCell, CollectionColumn, CollectionItem

fn demo_item(id str, item_revision str, label str, kind str, icon str, state str, display_kind str, disabled bool) CollectionItem {
    let cells List<CollectionCell> = [CollectionCell { key: "kind", text: display_kind }]
    let actions List<CollectionAction> = [CollectionAction { id: "open", label: "打开", enabled: true }]
    return CollectionItem {
        id: id, itemRevision: item_revision, label: label, kind: kind, icon: icon,
        thumbnailUri: "", thumbnailState: state, cells: cells, actions: actions,
        defaultActionId: "open", disabled: disabled
    }
}

widget App {
    use { package: collection_view from "../../../../packages/collection-view" }
    msg { Init, ChangeView(str), Select(str), Act(str), Sort(str), Replace, Remove, Quit }
    model {
        var items List<CollectionItem> = []
        var columns List<CollectionColumn> = []
        var mode str = "grid"
        var selected str = ""
        var scope str = "demo"
        var revision int = 1
        var collection_token str = ""
        var sort_key str = ""
        var sort_direction str = ""
        var result str = "尚未选择"
        var action_result str = ""
    }
    view {
        col (style: "w-full h-full min-h-0 bg-background text-foreground p-3") {
            row (style: "items-center justify-between gap-2") {
                text "资源视图演示" { style: "text-base font-semibold" }
                row (style: "items-center gap-2") {
                    button (text: "替换条目", onclick: .Replace, style: "h-8 px-2 border border-border rounded-md") {}
                    button (text: "移除所选", onclick: .Remove, disabled: .selected == "", style: "h-8 px-2 border border-border rounded-md") {}
                    button (text: "退出演示", onclick: .Quit, style: "h-8 px-2 border border-border rounded-md") {}
                }
            }
            text .result { style: "text-sm" }
            if .action_result != "" {
                text .action_result { style: "text-sm" }
            }
            col (style: "flex-1 min-h-0") {
                CollectionView (
                    items: .items, columns: .columns, viewMode: .mode, selectedId: .selected,
                    scopeId: .scope, revision: .revision, sortKey: .sort_key, sortDirection: .sort_direction,
                    onviewModeRequested: .ChangeView($event), onselectionRequested: .Select($event),
                    onitemActionRequested: .Act($event), onsortRequested: .Sort($event)
                ) {}
            }
        }
    }
    on {
        .Init -> {
            .columns = [
                CollectionColumn { key: "name", label: "名称", align: "left", sortable: true },
                CollectionColumn { key: "kind", label: "类型", align: "left", sortable: false }
            ]
            .items = [
                demo_item("a", "1", "同名条目", "folder", "folder", "missing", "文件夹", false),
                demo_item("b", "1", "同名条目", "file", "file-text", "missing", "文档", false),
                demo_item("c", "1", "不可用条目", "image", "image", "loading", "图片", true)
            ]
        }
        .ChangeView(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    .collection_token = request.instanceToken
                    .mode = request.viewMode
                }
            } catch {}
        }
        .Select(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    var i int = 0
                    while i < .items.len() {
                        let item = .items[i]
                        if item.id == request.id && item.itemRevision == request.itemRevision && !item.disabled {
                            .collection_token = request.instanceToken
                            .selected = item.id
                            .result = "已选择 " + item.id
                        }
                        i = i + 1
                    }
                }
            } catch {}
        }
        .Act(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) {
                    var i int = 0
                    while i < .items.len() {
                        let item = .items[i]
                        if item.id == request.id && item.itemRevision == request.itemRevision && !item.disabled && request.actionId == "open" {
                            .collection_token = request.instanceToken
                            .action_result = "已打开 " + item.id
                        }
                        i = i + 1
                    }
                }
            } catch {}
        }
        .Sort(payload str) -> {
            try {
                let request = json.parse(payload)
                if request.scopeId == .scope && request.baseRevision == .revision && request.instanceToken != "" && (.collection_token == "" || request.instanceToken == .collection_token) && request.sortKey == "name" {
                    .collection_token = request.instanceToken
                    let a = .items[0]
                    let b = .items[1]
                    let c = .items[2]
                    .items = [b, a, c]
                    .sort_key = "name"
                    .sort_direction = if .sort_direction == "asc" { "desc" } else { "asc" }
                    .revision = .revision + 1
                }
            } catch {}
        }
        .Replace -> {
            let a = demo_item("a", "2", "同名条目", "folder", "folder", "missing", "文件夹", false)
            var remaining List<CollectionItem> = []
            for item in .items {
                if item.id != "a" { remaining.push(item) }
            }
            remaining.push(a)
            .items = remaining
            .revision = .revision + 1
        }
        .Remove -> {
            var remaining List<CollectionItem> = []
            for item in .items {
                if item.id != .selected { remaining.push(item) }
            }
            .items = remaining
            .revision = .revision + 1
        }
        .Quit -> { Process.exit(0) }
    }
}
