name: "tree-view-demo"
version: "0.1.0"
scene: "ui"
render: "vue"
title: "TreeView demo"
title_zh: "树形演示"
# PLAN-085：TreeView 受控演示——展开/选择/禁用/加载中/加载失败+重试
# 四态可驱动，外加同页双实例与结构错误例。产品门 verify_tree_view.py
# 以本示例为夹具（隔离目录运行）。
window: "900x700"
# vue 轨专用前端端口（避免默认 3000 与并行门冲突）。
front_port: 4291
# PLAN-085：官方 TreeView 包 dep 根（vue 轨 Phase-1c 扫描发出 TreeView.vue；
# native 轨由 widget 级 use 的 VM sweep 传递装载）。
dep tree_view {
    path: "../../packages/tree-view"
}
