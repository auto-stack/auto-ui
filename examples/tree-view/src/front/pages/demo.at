// PLAN-085 TreeView 演示页 — 受控回路可驱动：
//   展开/折叠 → on_toggle → 应用改 expanded → 行重派生
//   点击行 → on_select → 应用改 selected → 选中态重派生
//   重试 → on_retry → 应用清 errorIds → 行回正常态
// 另含同页双实例（A/B 各自独立 expanded/selected）与禁用/加载中/失败三态。
//
// 行数/选中/事件计数是消费方内容摘要（视觉指南 §3.2），不是组件自带文本。
use auto.json

widget demo {
    msg {
        Init,
        AToggle(str), ASelect(str), ARetry(str),
        BToggle(str), BSelect(str), BRetry(str),
        LoadA, FailA, ClearA, LoadB,
        Quit
    }
    model {
        // A 树：正常四态 + 禁用
        var aNodes List = []
        var aExpanded List = []
        var aSelected str = ""
        var aDisabled List = []
        var aLoading List = []
        var aErrors List = []
        var aLog str = ""

        var aSummary str = "A 树 sel= exp=0 "

        // B 树：同 ID 不同内容（验证不串扰）
        var bNodes List = []
        var bExpanded List = []
        var bSelected str = ""
        var bLog str = ""

        var bSummary str = "B 树 sel= exp=0 "
    }
    use { package: tree_view from "../../../../../packages/tree-view" }
    view {
        col (style: "w-full h-full bg-background text-foreground gap-3 p-4") {
            text "TreeView 受控演示" { style: "text-sm font-medium" }
            row (style: "items-center gap-1.5 flex-wrap") {
                button "A 加载中" { onclick: .LoadA, style: "px-2 py-1 text-xs rounded-md border border-border" }
                button "A 加载失败" { onclick: .FailA, style: "px-2 py-1 text-xs rounded-md border border-border" }
                button "A 清空" { onclick: .ClearA, style: "px-2 py-1 text-xs rounded-md border border-border" }
                button "B 加载中" { onclick: .LoadB, style: "px-2 py-1 text-xs rounded-md border border-border" }
                button "退出夹具" { onclick: .Quit, style: "px-2 py-1 text-xs rounded-md border border-border" }
            }
            row (style: "items-start gap-3 flex-1 min-h-0") {
                col (style: "w-72 border border-border rounded-md p-2") {
                    text .aSummary { style: "text-xs text-muted-foreground" }
                    TreeView (nodes: .aNodes, expanded: .aExpanded, selected: .aSelected, disabledIds: .aDisabled, loadingIds: .aLoading, errorIds: .aErrors, on_toggle: .AToggle($event), on_select: .ASelect($event), on_retry: .ARetry($event), directory: true) {}
                }
                col (style: "w-72 border border-border rounded-md p-2") {
                    text .bSummary { style: "text-xs text-muted-foreground" }
                    TreeView (nodes: .bNodes, expanded: .bExpanded, selected: .bSelected, on_toggle: .BToggle($event), on_select: .BSelect($event), on_retry: .BRetry($event), directory: true) {}
                }
            }
        }
    }
    on {
        .Init -> {
            // A：chapter-01(展开) > section-1.1；images(加载中)；chapter-02(禁用+失败)
            var sec List = []
            sec.push({ id: "section-1.1", label: "Section 1.1", children: [], kind: "file", icon: "", is_leaf: true, badge: "" })
            var a List = []
            a.push({ id: "chapter-01", label: "Chapter 01", children: sec, kind: "dir", icon: "", is_leaf: false, badge: "" })
            a.push({ id: "images", label: "Images", children: [], kind: "dir", icon: "", is_leaf: false, badge: "2" })
            a.push({ id: "chapter-02", label: "Chapter 02", children: [], kind: "dir", icon: "", is_leaf: false, badge: "" })
            a.push({ id: "notes", label: "Notes", children: [], kind: "file", icon: "", is_leaf: true, badge: "" })
            .aNodes = a
            .aExpanded = ["chapter-01"]
            .aDisabled = ["notes"]
            .aLoading = ["images"]
            .aErrors = ["images"]

            .aSummary = f"A 树 sel= exp=${.aExpanded.len()} "
            // B：同名 chapter-01 但内容是 B 树
            var b List = []
            b.push({ id: "chapter-01", label: "Chapter 01 (B)", children: [], kind: "dir", icon: "", is_leaf: true, badge: "B" })
            b.push({ id: "notes", label: "Notes (B)", children: [], kind: "file", icon: "", is_leaf: true, badge: "B" })
            .bNodes = b
            .bExpanded = []

            .bSummary = f"B 树 sel= exp=${.bExpanded.len()} "
        }
        .AToggle(id str) -> {
            .aLog = f"toggle:${id}"
            .aExpanded = toggle_id_list(.aExpanded, id)
        }
        .ASelect(id str) -> {
            .aSelected = id
            .aLog = f"select:${id}"
            .aSummary = f"A 树 sel=${id} exp=${.aExpanded.len()} ${.aLog}"
        }
        .ARetry(id str) -> {
            .aLog = f"retry:${id}"
            .aErrors = remove_id_list(.aErrors, id)
        }
        .BToggle(id str) -> {
            .bLog = f"toggle:${id}"
            .bExpanded = toggle_id_list(.bExpanded, id)
        }
        .BSelect(id str) -> {
            .bSelected = id
            .bLog = f"select:${id}"
            .bSummary = f"B 树 sel=${id} exp=${.bExpanded.len()} ${.bLog}"
        }
        .BRetry(id str) -> {
            .bLog = f"retry:${id}"
        }
        .LoadA -> {
            .aLoading = ["images"]
            .aLog = "loading:images"
        }
        .FailA -> {
            .aErrors = ["images"]

            .aSummary = f"A 树 sel= exp=${.aExpanded.len()} "
            .aLog = "error:chapter-02"
        }
        .ClearA -> {
            .aNodes = []
            .aSelected = ""
            .aLog = "cleared"
        }
        .LoadB -> {
            .bLog = "B loading"
        }
        .Quit -> { Process.exit(0) }
    }
}

fn toggle_id_list(list List, id str) List {
    var out List = []
    var found bool = false
    var i int = 0
    while i < list.len() {
        if list[i] == id {
            found = true
        } else {
            out.push(list[i])
        }
        i = i + 1
    }
    if !found {
        out.push(id)
    }
    return out
}

fn remove_id_list(list List, id str) List {
    var out List = []
    var i int = 0
    while i < list.len() {
        if list[i] != id {
            out.push(list[i])
        }
        i = i + 1
    }
    return out
}
