use auto.json

// PLAN-092 T-04 — 普通设置消费示例「阅读与外观」外壳。
// 两个设置页各持一个独立 PropertyInspector 实例（不同 targetId、同 label）：
// T-01/B-6 实证同页双实例在 native 的面板重投影不稳定（VM runtime 债家族），
// 因此实例按路由分离（单实例挂载，双实例语义经页面导航呈现）。
// 明暗切换走 runtime 惯例 dark_mode 字段（087 演示同型）。
widget App {
    routes {
        "/" -> use settings
        "/advanced" -> use advanced
    }
    msg { ToggleTheme, NavHome, NavAdvanced }
    model { var dark_mode bool = false }
    view {
        col (style: "w-full h-full bg-background text-foreground") {
            row (style: "items-center gap-2 px-3 py-1.5 border-b border-border shrink-0") {
                text "阅读与外观" { style: "text-sm font-medium" }
                row (style: "flex-1") {}
                button "基础设置" { onclick: .NavHome, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
                button "高级/边界" { onclick: .NavAdvanced, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
                button "切换明暗" { onclick: .ToggleTheme, style: "px-2 py-0.5 text-xs rounded-md border border-border" }
            }
            outlet
        }
    }
    on {
        .ToggleTheme -> {
            .dark_mode = !.dark_mode
        }
        .NavHome -> {
            router.push("/")
        }
        .NavAdvanced -> {
            router.push("/advanced")
        }
    }
}
