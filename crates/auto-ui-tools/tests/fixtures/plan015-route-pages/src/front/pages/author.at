use fields: route_field
use route_store: RouteStore

widget Author {
    msg { Init, Tick }
    model {
        var ready bool = false
        var ticks int = 0
        var entries = ["first", "second"]
    }
    timer { Tick (every_ms: 3000) }
    view {
        col {
            text "Route author loaded"
            input { style: route_field }
            if .ready { text "Route Init complete" }
            if .store.marked { text "Route store Init complete" }
            if .ticks == 0 { text "Timer ready" }
            for entry in .entries { text f"entry ${entry}" }
        }
    }
    on {
        .Init -> { .store.MarkReady(); .ready = true }
        .Tick -> { .ticks = .ticks + 1 }
    }
}
