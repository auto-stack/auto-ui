widget P068Accessibility {
    msg { ToggleB, FlipChecked, EditNote(str) }
    model {
        var show_b bool = true
        var checked bool = true
        var note_value str = "First line\nSecond line"
    }
    view {
        col {
            style: "p-6 gap-4 w-full h-full bg-background"
            text "Native accessibility integration"
            button (onclick: .ToggleB) { text "Toggle second instance" }
            Probe (key: "a", label: "First") { }
            if .show_b { Probe (key: "b", label: "Second") { } }
            checkbox (text: "Selected fixture", checked: .checked, onclick: .FlipChecked) { }
            textarea (placeholder: "Multiline fixture", value: .note_value, oninput: .EditNote, height: 48) { }
            button (disabled: true, onclick: .ToggleB) { text "Disabled action" }
        }
    }
    on {
        .ToggleB -> { .show_b = !.show_b }
        .FlipChecked -> { .checked = !.checked }
        .EditNote(value) -> { .note_value = value }
    }
}
widget Probe (label: str = "") {
    msg { Inc, Edit(str) }
    model {
        var count int = 0
        var text_value str = "initial"
    }
    view {
        col {
            style: "gap-2"
            text .label
            button (onclick: .Inc) { text "Increment" }
            text .count
            input (placeholder: .label, value: .text_value, oninput: .Edit)
            text .text_value
        }
    }
    on {
        .Inc -> { .count = .count + 1 }
        .Edit(value) -> { .text_value = value }
    }
}
