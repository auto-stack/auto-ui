widget DetailPage {
    msg { Init, Add, Back }
    model {
        var book_id int = 0
        var total int = 0
    }
    view {
        col {
            text "Book detail page"
            button "Read again" { onclick: .Add }
            button "Back" { onclick: .Back }
        }
    }
    on {
        .Init -> { .book_id = router.param("id") }
        .Add -> { .total = .total + router.param("id") }
        .Back -> { router.back() }
    }
}
