widget LayoutApp {
    view {
        row {
            style: "w-full h-full min-h-screen bg-background text-foreground"
            col {
                style: "w-60 shrink-0 h-full"
                text "Sidebar"
            }
            col {
                style: "flex-1 min-w-0 h-full flex flex-col"
                ResultLayout { }
            }
        }
    }
}
widget ResultLayout {
    msg { Fill }
    model { var result str = "" }
    view {
        col {
            style: "w-full h-full p-6 gap-5"
            button (onclick: .Fill) { text "Fill result" }
            text "Library"
            if .result != "" {
                col {
                    style: "p-3 rounded-lg bg-muted text-sm text-foreground max-h-32 overflow-y-auto shrink-0"
                    text .result { style: "whitespace-pre-wrap" }
                }
            }
            text "Next controls"
        }
    }
    on {
        .Fill -> {
            .result = "w03-cover.epub：书库中已存在"
            .result = .result + "\n笔记10.md：书库中已存在"
            .result = .result + "\n坏书.epub：导入失败：缺少 META-INF/container.xml（不是合法 EPUB 容器）"
            .result = .result + "\n中文 书2.txt：书库中已存在"
        }
    }
}
