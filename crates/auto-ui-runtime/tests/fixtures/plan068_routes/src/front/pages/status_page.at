widget StatusPage {
    msg { Load, Push, PushSync, CpuPush }
    model {
        var result str = ""
    }
    view {
        col {
            button (onclick: .Load) { text "Load results" }
            button (onclick: .Push) { text "Navigate after request" }
            text .result
            if .result != "" {
                text "Result summary"
                text .result
            }
        }
    }
    on {
        .Load -> {
            let response = Http.get_json("__P068_URL__/reply")
            .result = "success\nfailure\ncancelled"
        }
        .Push -> {
            let response = Http.get_json("__P068_URL__/reply")
            router.push("/done/42")
        }
        .PushSync -> {
            router.push("/done/42")
        }
        .CpuPush -> {
            var count = 0
            while count < 2000 { count = count + 1 }
            router.push("/done/42")
        }
    }
}
