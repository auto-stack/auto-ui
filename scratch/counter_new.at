// No need to use auto.ui:*, they're preluded

// A message is an enum
msg CounterMsg {
    Inc
    Dec
}

// A widget has four sub blocks: `model`, `view`, `on` and `style`
widget Counter {
    model {
        count int
    }

    view {
        col {
            // inline mode for node, this line is same as `h1 { content: "Hello CodeSanbox" }`
            button + { onclick: CounterMsg.Inc}
            h2 > Current Count: ${count}
            button - { onclick: CounterMsg.Dec}
        }
    }

    on {
        CounterMsg.Inc => {
            .count += 1
        }
        CounterMsg.Dec => {
            .count -= 1
        }
    }

    style {
        // tailwind css
        px-8 py-8
    }
}

// An App is a window showing widgets
app CounterApp {
    center {
        Counter(count: 0)
    }
}
