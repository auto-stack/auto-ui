// packages/pagination/pagination_control.at — PaginationControl（PLAN-086）
//
// 统一受控分页组件：公共 1-based 页码；页数/边界/页容量/单页隐藏由单一
// 受控算法派生，组件不持有第二份 page、不切片数据、不发业务请求。宿主
// 数据变化后由消费方更新受控值，组件只投影。
//
// 派生架构（PLAN-086 T-03，PLAN-536 T3 约束下的实证定案）：
// - Init 收敛为挂载语义（每实例一次，不随脏重建重放），只做静态配置派生
//   （容量候选去重；pageSizes 是消费者静态配置）。
// - 响应式派生全部走 computed（props 每帧重播种，computed 随视图重建
//   重估，vue 轨同语义）——受控 page/total 变化即时反映到页码/边界/隐藏。
// - computed 间引用沿 state-miss → computed 回退链（eval.rs PLAN-051 C3）；
//   handler 体内 computed 引用经 handler_codegen 改写为隐藏 fn 调用。
//
// 事件契约（PLAN-086 T-01 冻结，探针实证）：
// - `."changed"(json字符串)` 是唯一上行通道，载荷 `{"page":N,"pageSize":M}`；
//   msg 变体必须带引号声明，vue 轨 emit 重写只识别引号变体。
// - 一个用户操作最多一条 changed；边界/重复/disabled 零事件。
// - 非法配置（pageSize<=0、total<0、页容量候选含非正数）＝具名配置错误：
//   导航整组隐藏、错误文本可见可读（MCP snapshot/state），不刷回调。
//   注：错误走渲染文本而非 error 事件——native 轨子件 Init 内 emit 不派发
//   （P-probe 实证 probe:no-err），可见文本是双端一致的具名可观察面。
// - hideWhenSingle=true 且 pageCount<=1 时整组（含容量按钮）不入树；
//   需要空/单页仍改容量的消费者显式传 false。
// - 页容量切换：pageSizes 去重保序渲染为标准按钮（026 现形一致，MCP press
//   可驱动）；选新值发一次 {page:1,pageSize:N}，当前值按钮禁用。
//   当前 pageSize 不在候选时挂载期补入尾部（§5：当前值仍明确显示）；
//   pageSizes/pageSize 的动态换出非候选值需重挂载（key 变更），已文档化。
//
// 页码语义：total 为条目数（非页数），total=0 是正常空结果（pageCount=1）；
// 受控 page 越界只投影 clamp 值，不自发 changed、不改宿主状态。
widget PaginationControl (page: int = 1, pageSize: int = 10, total: int = 0, hideWhenSingle: bool = true, compact: bool = false, disabled: bool = false, showPageSize: bool = false, pageSizes: List = [10, 25, 50]) {
    msg { Init, First, Prev, Next, Last, SetSize(int), "changed"(str) }
    model {
        var size_candidates List<int> = []
        var sizes_error bool = false
    }
    computed {
        // 派生为无相互引用的平铺 computed（computed 体求值走
        // resolve_expr_to_value，无 computed 兜底——链式引用会静默置 None，
        // P3 探针实证全组消失；页数表达式在各界内联展开）。
        // page_count = ceil(total/pageSize)，下限 1。防溢出 + 双端整除一致
        // 形态：(total - total%pageSize)/pageSize + 余数进位——native int
        // 除与 JS float 除在该形态下同得整数（P3 vue 11.03 实录定案）。
        page_count => if .total <= 0 { 1 } else if .pageSize <= 0 { 1 } else if .total % .pageSize > 0 { (.total - .total % .pageSize) / .pageSize + 1 } else { .total / .pageSize }
        current => if .page < 1 { 1 } else if .pageSize <= 0 { 1 } else if .total <= 0 { 1 } else if .total % .pageSize > 0 && .page > (.total - .total % .pageSize) / .pageSize + 1 { (.total - .total % .pageSize) / .pageSize + 1 } else if .total % .pageSize == 0 && .page > .total / .pageSize { .total / .pageSize } else { .page }
        // can_prev = current > 1 ⟺ page > 1 且 pageCount > 1；pageCount>1
        // ⟺ total > pageSize（total>0、pageSize>0 时 ceil≥2 当且仅当此）。
        can_prev => if .pageSize <= 0 { false } else if .total <= 0 { false } else { .page > 1 && .total > .pageSize }
        // can_next = current < pageCount ⟺ page < pageCount。
        can_next => if .pageSize <= 0 { false } else if .total <= 0 { false } else if .total % .pageSize > 0 { .page < (.total - .total % .pageSize) / .pageSize + 1 } else { .page < .total / .pageSize }
        // group_visible = pageCount > 1 || !hideWhenSingle；统一臂：
        // total>pageSize ⟺ ceil ≥ 2（total>0、pageSize>0 时）。
        group_visible => if .pageSize <= 0 { !.hideWhenSingle } else if .total <= 0 { !.hideWhenSingle } else { .total > .pageSize || !.hideWhenSingle }
        config_error => if .pageSize <= 0 { "pagination: pageSize must be > 0" } else if .total < 0 { "pagination: total must be >= 0" } else if .sizes_error { "pagination: pageSizes entries must be > 0" } else { "" }
    }
    view {
        col (style: "items-center gap-1 min-w-0") {
            if .config_error != "" {
                text .config_error { style: "text-xs text-destructive whitespace-nowrap" }
            } else {
                if .group_visible {
                    row (style: "items-center gap-1 shrink-0 text-xs") {
                        if !.compact {
                            button (icon: "chevrons-left", title: "首页", onclick: .First, disabled: !.can_prev || .disabled) {}
                        }
                        button (icon: "chevron-left", title: "上一页", onclick: .Prev, disabled: !.can_prev || .disabled) {}
                        text f"第 ${.current} / ${.page_count} 页" { style: "whitespace-nowrap text-muted-foreground px-1" }
                        button (icon: "chevron-right", title: "下一页", onclick: .Next, disabled: !.can_next || .disabled) {}
                        if !.compact {
                            button (icon: "chevrons-right", title: "末页", onclick: .Last, disabled: !.can_next || .disabled) {}
                        }
                        if .showPageSize {
                            row (style: "items-center gap-0.5 ml-1") {
                                for size in .size_candidates {
                                    button f"${size}" { onclick: .SetSize(size), disabled: .disabled || size == .pageSize, style: "px-2 py-0.5 text-xs rounded-md" }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    on {
        .Init -> {
            // 静态配置派生：容量候选去重保序 + 非正数具名错误标记 +
            // 当前 pageSize 补尾。pageSizes 为消费者静态配置（挂载期语义）。
            .sizes_error = false
            .size_candidates = []
            for size in .pageSizes {
                if size <= 0 {
                    .sizes_error = true
                }
                var dup bool = false
                for s in .size_candidates {
                    if s == size {
                        dup = true
                    }
                }
                if !dup && size > 0 {
                    .size_candidates.push(size)
                }
            }
            if .showPageSize && .pageSize > 0 {
                var has_current bool = false
                for s in .size_candidates {
                    if s == .pageSize {
                        has_current = true
                    }
                }
                if !has_current {
                    .size_candidates.push(.pageSize)
                }
            }
        }
        .First -> {
            if .can_prev && !.disabled {
                try {
                    ."changed"(json.stringify({page: 1, pageSize: .pageSize}))
                } catch {
                }
            }
        }
        .Prev -> {
            if .can_prev && !.disabled {
                try {
                    ."changed"(json.stringify({page: .current - 1, pageSize: .pageSize}))
                } catch {
                }
            }
        }
        .Next -> {
            if .can_next && !.disabled {
                try {
                    ."changed"(json.stringify({page: .current + 1, pageSize: .pageSize}))
                } catch {
                }
            }
        }
        .Last -> {
            if .can_next && !.disabled {
                try {
                    ."changed"(json.stringify({page: .page_count, pageSize: .pageSize}))
                } catch {
                }
            }
        }
        .SetSize(n int) -> {
            if !.disabled && n > 0 && n != .pageSize {
                try {
                    ."changed"(json.stringify({page: 1, pageSize: n}))
                } catch {
                }
            }
        }
    }
}
