use auto.math
use std.json: json_object_text, json_str
use thumbnail: Thumbnail
use collection_schema: CollectionColumn, CollectionItem
use collection_view_util: cv_sortable, cv_invalid, cv_enabled, cv_bound_index, cv_header, cv_rows, cv_move, cv_last
use collection_request: cv_view_request, cv_sort_request, cv_item_request
use collection_layout: cv_scoped_focus, cv_focus_step

widget CollectionView (items: List<CollectionItem> = [], columns: List<CollectionColumn> = [], viewMode: str = "grid", selectedId: str = "", scopeId: str = "", revision: int = 0, disabled: bool = false, status: str = "ready", emptyLabel: str = "没有条目", errorMessage: str = "", sortKey: str = "", sortDirection: str = "") {
    msg {
        Init, WidgetContext(str, int), Move(str), FocusItem(str), BlurItem(str), RestoreFocus, FocusCurrent, Keyboard(str, str),
        ItemInput(str, str, str), ViewInput(str, str, int, str), SortInput(str, str, int, str),
        "viewModeRequested"(str), "selectionRequested"(str),
        "itemActionRequested"(str), "sortRequested"(str)
    }
    bind {
        "widget:context" -> .WidgetContext
    }
    model {
        var instance_token str = ""
        var window_width int = 0
        var seq int = 0
        var focus_id str = ""
        var focus_scope str = ""
        var focus_active bool = false
        var focus_requested bool = false
    }
    computed {
        config_error => cv_invalid(.items, .columns, .viewMode)
        header => cv_header(.columns)
        rows => cv_rows(.items, .columns, .selectedId, cv_scoped_focus(.focus_scope, .scopeId, .focus_id), .scopeId, .revision, .instance_token)
    }
    view {
        col (id: "cv-" + .instance_token, tabindex: -1,
             class: "w-full h-full min-h-0 min-w-0 overflow-hidden flex flex-col text-foreground") {
            row (style: "w-full h-9 gap-1 px-2 items-center border-b border-border") {
                button (text: "网格", title: "网格视图", disabled: .disabled,
                        onclick: .ViewInput("grid", .scopeId, .revision, .instance_token),
                        style: if .viewMode == "grid" { "h-7 px-2 bg-card text-foreground border border-primary rounded" } else { "h-7 px-2 rounded" }) {}
                button (text: "列表", title: "列表视图", disabled: .disabled,
                        onclick: .ViewInput("list", .scopeId, .revision, .instance_token),
                        style: if .viewMode == "list" { "h-7 px-2 bg-card text-foreground border border-primary rounded" } else { "h-7 px-2 rounded" }) {}
            }
            if .config_error != "" {
                text .config_error { style: "p-3 text-sm text-destructive" }
            } else if .status == "error" {
                if .errorMessage != "" {
                    text .errorMessage { style: "p-3 text-sm text-destructive" }
                } else {
                    text "条目加载失败" { style: "p-3 text-sm text-destructive" }
                }
            } else if .status == "loading" {
                text "条目加载中" { style: "p-3 text-sm text-muted-foreground" }
            } else {
                row (style: if .viewMode == "list" { "w-full h-8 px-2 items-center gap-1 border-b border-border" } else { "w-full h-0 overflow-hidden" }) {
                    if .viewMode == "list" {
                        for column in .header {
                            row (style: if column.key == "name" { "flex-1 min-w-0 items-center gap-1" } else { "w-24 items-center gap-1" }) {
                                if column.sortable {
                                    button (text: column.label, disabled: .disabled,
                                            onclick: .SortInput(column.key, .scopeId, .revision, .instance_token), style: "h-7 px-2 text-xs truncate") {}
                                } else {
                                    text column.label { style: "text-xs text-muted-foreground truncate" }
                                }
                                if .sortKey == column.key {
                                    if .sortDirection == "asc" {
                                        icon (name: "arrow-up", size: 12) {}
                                    } else if .sortDirection == "desc" {
                                        icon (name: "arrow-down", size: 12) {}
                                    }
                                }
                            }
                        }
                    }
                }
                col (class: "flex-1 min-h-0 min-w-0 w-full overflow-auto") {
                    grid (style: if .viewMode == "list" { "grid grid-cols-1 gap-1 w-full p-2" } else { "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1 w-full p-2" }) {
                        for item in .rows {
                            col (key: item.id, class: item.rowStyle.clone()) {
                                row (style: if .viewMode == "list" { "w-full items-center gap-1 px-1" } else { "w-full flex-col gap-1 p-1" }) {
                                    mouse-area (ondblclick: .ItemInput(item.binding, "default", ""),
                                                oncontextmenu.prevent: .ItemInput(item.binding, "action", "menu"),
                                                style: "flex-1 min-w-0") {
                                        button (id: item.focusKey.clone(), title: item.id.clone(), disabled: .disabled || item.disabled,
                                                onclick: .ItemInput(item.binding, "selection", ""),
                                                onfocus: .FocusItem(item.binding),
                                                onblur: .BlurItem(item.id),
                                                onkeydown.left.self.prevent: .Keyboard(item.binding, "left"),
                                                onkeydown.right.self.prevent: .Keyboard(item.binding, "right"),
                                                onkeydown.up.self.prevent: .Keyboard(item.binding, "up"),
                                                onkeydown.down.self.prevent: .Keyboard(item.binding, "down"),
                                                onkeydown.home.self.prevent: .Keyboard(item.binding, "home"),
                                                onkeydown.end.self.prevent: .Keyboard(item.binding, "end"),
                                                onkeydown.space.self.prevent: .Keyboard(item.binding, "space"),
                                                onkeydown.enter.self.prevent: .Keyboard(item.binding, "enter"),
                                                style: if .viewMode == "list" { "w-full min-w-0 justify-start gap-2 px-1 h-10" } else { "w-full min-w-0 h-auto flex-col items-stretch p-0 gap-1 text-left" }) {
                                            col (style: if .viewMode == "list" { "w-7 h-7 shrink-0" } else { "w-full h-24 overflow-hidden" }) {
                                                Thumbnail (key: item.id, src: item.src, kind: item.kind, icon: item.icon,
                                                           state: item.imageState, resourceId: item.id, resourceRevision: item.itemRevision) {}
                                            }
                                            text item.label { style: "text-sm truncate" }
                                        }
                                    }
                                    if .viewMode == "list" {
                                        for cell in item.cells {
                                            text cell.text { style: if cell.align == "right" { "w-24 text-right text-xs truncate" } else { "w-24 text-xs truncate" } }
                                        }
                                    }
                                    row (style: "items-center gap-1") {
                                        for action in item.actions {
                                            button (text: action.label, disabled: .disabled || item.disabled || !action.enabled,
                                                    onclick: .ItemInput(item.binding, "action", action.id),
                                                    onkeydown.enter.self.stop.prevent: .ItemInput(item.binding, "action", action.id),
                                                    onkeydown.space.self.stop.prevent: .ItemInput(item.binding, "action", action.id),
                                                    style: "h-7 px-1 text-xs shrink-0") {}
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if .items.len() == 0 && .emptyLabel != "" {
                        text .emptyLabel { style: "p-3 text-sm text-muted-foreground" }
                    }
                }
            }
        }
    }
    watch {
        .items, .viewMode, .scopeId, .status, .disabled -> {
            if .focus_active || .focus_requested { .RestoreFocus() }
            .focus_requested = false
        }
    }
    on {
        .Init -> {
            if Env.track() == "vm" || Env.track() == "vue" {
                // The compatibility Vue component can replay Init when props change.
                if .instance_token == "" {
                    .instance_token = "" + Time.now_ms() + "/" + math.random()
                }
            }
        }
        .WidgetContext(token str, width int) -> {
            .instance_token = token
            .window_width = width
        }
        .ViewInput(mode str, scope str, base int, token str) -> {
            if !.disabled && token != "" && token == .instance_token && scope == .scopeId && base == .revision {
                if cv_invalid(.items, .columns, .viewMode) == "" && mode != .viewMode {
                    .focus_requested = .focus_id != "" && .focus_scope == .scopeId
                    .seq = .seq + 1
                    .viewModeRequested(cv_view_request(.seq, token, scope, base, mode))
                    if Env.track() == "vm" {
                        if .focus_requested { .RestoreFocus() }
                    }
                }
            }
        }
        .SortInput(key str, scope str, base int, token str) -> {
            if !.disabled && .status == "ready" && token != "" && token == .instance_token && scope == .scopeId && base == .revision {
                if cv_invalid(.items, .columns, .viewMode) == "" && cv_sortable(.columns, key) {
                    .focus_requested = .focus_id != "" && .focus_scope == .scopeId
                    .seq = .seq + 1
                    .sortRequested(cv_sort_request(.seq, token, scope, base, key))
                    if Env.track() == "vm" {
                        if .focus_requested { .RestoreFocus() }
                    }
                }
            }
        }
        .ItemInput(binding str, kind str, action_id str) -> {
            if !.disabled && .status == "ready" && .instance_token != "" && cv_invalid(.items, .columns, .viewMode) == "" {
                let index = cv_bound_index(.items, binding, .instance_token, .scopeId, .revision)
                if index >= 0 {
                    let item = .items[index]
                    var action Str = action_id.to(Str)
                    if kind == "default" { action = item.defaultActionId.to(str).to(Str) }
                    if kind == "selection" {
                        .focus_id = item.id
                        .focus_scope = .scopeId
                        .seq = .seq + 1
                        .selectionRequested(cv_item_request(.seq, .instance_token, .scopeId, .revision, item.id, item.itemRevision, ""))
                    } else if cv_enabled(.items, index, action.to(str)) {
                        .seq = .seq + 1
                        .itemActionRequested(cv_item_request(.seq, .instance_token, .scopeId, .revision, item.id, item.itemRevision, action.to(str)))
                    }
                }
            }
        }
        .FocusItem(binding str) -> {
            if !.disabled && .status == "ready" && cv_invalid(.items, .columns, .viewMode) == "" {
                let index = cv_bound_index(.items, binding, .instance_token, .scopeId, .revision)
                if index >= 0 {
                    .focus_id = .items[index].id
                    .focus_scope = .scopeId
                    .focus_active = true
                }
            }
        }
        .BlurItem(id str) -> {
            if .focus_id == id { .focus_active = false }
        }
        .RestoreFocus -> {
            var id Str = ""
            if !.disabled && .status == "ready" && cv_invalid(.items, .columns, .viewMode) == "" {
                let target = cv_move(.items, cv_scoped_focus(.focus_scope, .scopeId, .focus_id), 0)
                if target >= 0 { id = .items[target].id.clone() }
            }
            .focus_scope = .scopeId
            .focus_id = id
            .FocusCurrent()
        }
        .FocusCurrent -> {
            var selector Str = "[id='cv-" + .instance_token
            if .focus_id != "" { selector = selector + "-" + .focus_id }
            ui.focus(selector + "']")
        }
        .Keyboard(binding str, key str) -> {
            if !.disabled && .status == "ready" && cv_invalid(.items, .columns, .viewMode) == "" {
                let index = cv_bound_index(.items, binding, .instance_token, .scopeId, .revision)
                if index >= 0 {
                    let item = .items[index]
                    .focus_id = item.id
                    .focus_scope = .scopeId
                    if key == "enter" && item.defaultActionId != "" {
                        .ItemInput(binding, "default", "")
                    } else if key == "space" || key == "enter" {
                        .ItemInput(binding, "selection", "")
                    } else {
                        .Move(key)
                    }
                }
            }
        }
        .Move(direction str) -> {
            if !.disabled && .status == "ready" && cv_invalid(.items, .columns, .viewMode) == "" {
                if .focus_scope != .scopeId {
                    .focus_scope = .scopeId
                    .focus_id = ""
                }
                var target int = -1
                if direction == "home" {
                    target = cv_move(.items, "", 1)
                } else if direction == "end" {
                    target = cv_last(.items)
                } else {
                    var width int = .window_width
                    if Env.track() == "vm" || Env.track() == "vue" {
                        if .viewMode == "grid" { width = storage.get("vm.window_inner_width").to_int() }
                    }
                    let step = cv_focus_step(direction, .viewMode, width)
                    if step != 0 { target = cv_move(.items, .focus_id, step) }
                }
                if target >= 0 {
                    .focus_id = .items[target].id
                    .FocusCurrent()
                }
            }
        }
    }
}
