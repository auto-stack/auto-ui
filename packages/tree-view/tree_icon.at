// packages/tree-view/tree_icon.at — TreeIcon 有界图标调色板（PLAN-085 T-02）。
//
// 独立文件原因（PLAN-614 实证）：auto run 增量路径对多-widget .at 会把同一份
// 代码写到每个 widget 名下，故单文件单 widget。
//
// Vue 轨 `icon` 只发射**字面量名**（动态名落 Circle 占位，P601-T11 同族），
// 因此按 name 分支发射真 lucide 组件；VM 轨 lucide 表同名覆盖。调色板外名字
// 渲染为空（契约记录于此）。
//
// 调色板 = 目录族（folder/folder-open/file/file-text/image）+ 通用导航
// （home/wrench/layout-grid/terminal/settings/eye/book-open）+ 数据对象
// （table/zap/database）+ PLAN-085 新增（file-code/package/git-branch/hash）。
// 取四示例 palette 的并集（026 为超集），再补三个正式包新增名。
widget TreeIcon (name: str = "") {
    view {
        if .name == "folder" {
            icon (name: "folder", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
        } else {
            if .name == "folder-open" {
                icon (name: "folder-open", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
            } else {
                if .name == "file" {
                    icon (name: "file", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                } else {
                    if .name == "file-text" {
                        icon (name: "file-text", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                    } else {
                        if .name == "file-code" {
                            icon (name: "file-code", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                        } else {
                            if .name == "image" {
                                icon (name: "image", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                            } else {
                                if .name == "home" {
                                    icon (name: "home", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                } else {
                                    if .name == "wrench" {
                                        icon (name: "wrench", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                    } else {
                                        if .name == "layout-grid" {
                                            icon (name: "layout-grid", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                        } else {
                                            if .name == "terminal" {
                                                icon (name: "terminal", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                            } else {
                                                if .name == "settings" {
                                                    icon (name: "settings", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                } else {
                                                    if .name == "eye" {
                                                        icon (name: "eye", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                    } else {
                                                        if .name == "book-open" {
                                                            icon (name: "book-open", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                        } else {
                                                            if .name == "table" {
                                                                icon (name: "table", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                            } else {
                                                                if .name == "zap" {
                                                                    icon (name: "zap", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                                } else {
                                                                    if .name == "database" {
                                                                        icon (name: "database", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                                    } else {
                                                                        if .name == "package" {
                                                                            icon (name: "package", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                                        } else {
                                                                            if .name == "git-branch" {
                                                                                icon (name: "git-branch", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                                            } else {
                                                                                if .name == "hash" {
                                                                                    icon (name: "hash", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
