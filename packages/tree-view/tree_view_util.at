// packages/tree-view/tree_view_util.at — TreeView UI 交互投影（PLAN-085 T-02）。
//
// 与语言 blueprint `bps.navigation.filetree.tree_util`（通用树工具 canonical
// owner，L1 零副本）的分工：blueprint 持通用遍历/过滤形状；本模块只持 **UI
// 交互投影**——禁用可达序、焦点 ordinal、行状态旗标。两者不重复实现同一算法，
// 消费者要通用树工具仍从 blueprint 取。
//
// ⚠ VM 轨遍历纪律（PLAN-614 实证，本包沿用）：`for-in` 对函数参数列表迭代
// 零次，因此所有列表遍历一律 `while` + 索引；嵌套 children 同式。递归可用，
// 但本模块保持显式栈（64 层嵌套样本不依赖调用栈深度）。
//
// ⚠ 包内模块文件不自动导入（PLAN-085 T-01 实证）：使用本模块的 widget 文件
// 必须显式 `use tree_view_util: <fn…>`；漏写时 `computed => fn(...)` 会静默
// 产出空列表且无诊断。
//
// 节点 schema（与四示例既有 nested record 同形，字段全键书写——VM Obj 字面量
// 为形状锁定类型，缺键字段访问是硬错）：
// { id: str, label: str, children: List, kind: str, icon: str, is_leaf: bool,
//   badge: str }

/// 线性成员测试（while + 索引）。
pub fn tv_member(list List, id str) bool {
    var i int = 0
    while i < list.len() {
        if list[i] == id {
            return true
        }
        i = i + 1
    }
    return false
}

/// 整棵树的总节点数（含所有层级的 children）。
/// 用于按**真实规模**给每帧校验设界：`nodes.len()` 只是根节点数，一棵"单根 +
/// 1000 个子节点"的树根数是 1，若拿根数当规模就会每帧扫 1001 个节点，重新制造
/// O(n^2) 的预算耗尽（实测 16.7s 且渲染 0 行）。
///
/// 注意：本函数只数总节点数，**不做**重复检测；`tv_duplicate_id` 才是那个。
pub fn tv_total_nodes(nodes List) int {
    var n int = 0
    var stack List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        stack.push(nodes[i])
    }
    while stack.len() > 0 {
        var top int = stack.len() - 1
        var nd = stack[top]
        stack.pop()
        n = n + 1
        var kids List = nd.children
        var k int = kids.len()
        while k > 0 {
            k = k - 1
            stack.push(kids[k])
        }
    }
    return n
}

/// 首个重复节点 ID（空串 = 无重复）。深度优先，遇到即返回，用于具名结构错误。
///
/// 用**拼接字符串 + 子串包含**实现，而不是 `tv_member` 的逐元素线性扫描：
/// `seen` 累积 `|id|` 片段，每结点一次 `contains`。成员检测走**原生**字符串搜索
/// 而非 VM 字节码迭代，因此 1000 节点也在毫秒级；旧的 `tv_member(seen, id)` 每结点
/// 要跑 len(seen) 次 VM 迭代（实测 1000 节点约 14s，耗尽预算并渲染 0 行）。
/// id 两端包 `|`，避免 `ab` 误命中 `b` 之类的子串误报。
pub fn tv_duplicate_id(nodes List) str {
    var seen str = "|"
    // Ids that contain the `|` delimiter would forge tokens ("a|b" -> "|a|b|"
    // spuriously matches "|b|"), so they are collected here and compared exactly.
    var seenIds List = []
    var stack List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        stack.push(nodes[i])
    }
    while stack.len() > 0 {
        var top int = stack.len() - 1
        var nd = stack[top]
        stack.pop()
        if nd.id.contains("|") {
            var e int = 0
            while e < seenIds.len() {
                if seenIds[e] == nd.id {
                    return nd.id
                }
                e = e + 1
            }
            seenIds.push(nd.id)
        } else {
            var token str = "|" + nd.id + "|"
            if seen.contains(token) {
                return nd.id
            }
            seen = seen + token
        }
        var kids List = nd.children
        var k int = kids.len()
        while k > 0 {
            k = k - 1
            stack.push(kids[k])
        }
    }
    return ""
}

/// 键盘可达行数（展开可见且未被禁用）。空树 = 0。
pub fn tv_count_rows(nodes List, expanded List, disabled List) int {
    var n int = 0
    var stack List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        stack.push(nodes[i])
    }
    while stack.len() > 0 {
        var top int = stack.len() - 1
        var nd = stack[top]
        stack.pop()
        if !tv_member(disabled, nd.id) {
            n = n + 1
        }
        if tv_member(expanded, nd.id) {
            var kids List = nd.children
            var j int = kids.len()
            while j > 0 {
                j = j - 1
                stack.push(kids[j])
            }
        }
    }
    return n
}

/// 文件名 → 图标名（lucide 名）。纯展示映射：不探测文件系统、不判断真实
/// 文件类型，只看显示文本后缀——与四示例既有 `ext_icon` 语义一致。
pub fn tv_ext_icon(name str) str {
    var ic str = "file"
    if name.ends_with(".png") || name.ends_with(".jpg") || name.ends_with(".jpeg") || name.ends_with(".gif") || name.ends_with(".webp") || name.ends_with(".svg") {
        ic = "image"
    } else {
        if name.ends_with(".at") || name.ends_with(".rs") || name.ends_with(".ts") || name.ends_with(".vue") || name.ends_with(".py") || name.ends_with(".js") {
            ic = "file-code"
        } else {
            if name.ends_with(".md") || name.ends_with(".txt") || name.ends_with(".json") || name.ends_with(".toml") || name.ends_with(".css") || name.ends_with(".yaml") || name.ends_with(".yml") || name.ends_with(".log") {
                ic = "file-text"
            }
        }
    }
    return ic
}

/// 行图标：`icon` 显式指定优先；`directory` 模式下按目录/文件派生
/// （目录按展开态取 folder-open/folder，文件按后缀取 file 族）；
/// 非 directory 模式且未显式指定 = 无图标。
pub fn tv_row_icon(nd_icon str, label str, kind str, has_kids bool, open bool, directory bool) str {
    if nd_icon != "" {
        return nd_icon
    }
    if !directory {
        return ""
    }
    var is_dir bool = kind == "dir" || has_kids
    if is_dir {
        if open {
            return "folder-open"
        }
        return "folder"
    }
    return tv_ext_icon(label)
}

/// 可见行派生。只展开 `expanded` 中的节点；`disabled` 行仍显示（供读屏/MCP
/// 观察其存在）但 `focused` 恒 false 且不占键盘序号。
/// 行记录 = {id, label, has_kids, open, disabled, selected, focused,
/// loading, error, leaf, icon, badge, depth}。
pub fn tv_derive_rows(nodes List, expanded List, selected str, disabled List, loading List, error List, focus int, directory bool, dupGuard bool) List {
    var out List = []
    var reachable int = 0
    // Depth travels WITH each pending node — a parallel index array desynchronises
    // as soon as children are pushed mid-walk (silently producing depth 0 for every
    // row, review F-01). Each stack entry is a [node, depth] pair, which cannot drift.
    //
    var dup bool = dupGuard
    // Unconditionally revalidate on every render. This is affordable now because
    // tv_duplicate_id uses native string search (concatenated `|id|` tokens +
    // `contains`) rather than a per-element VM loop: measured 1000 nodes in
    // ~2.1s per suite run, versus ~14s+ for the old tv_member scan which
    // exhausted the instruction budget and rendered 0 rows. The previous
    // node-count bound existed only to hide that cost, and it left post-Init
    // duplicates undetected above the threshold (review N-02).
    if !dup {
        if tv_duplicate_id(nodes) != "" {
            dup = true
        }
    }
    var seed List = []
    var si int = nodes.len()
    while si > 0 {
        si = si - 1
        var root_nd = nodes[si]
        var pair List = []
        pair.push(root_nd)
        pair.push(0)
        seed.push(pair)
    }
    while seed.len() > 0 {
        var stop int = seed.len() - 1
        var entry = seed[stop]
        seed.pop()
        var nd = entry[0]
        var lvl int = entry[1]
        var kids List = nd.children
        var leaf bool = nd.is_leaf == true
        // A directory with no children loaded YET is still expandable: it is
        // not a leaf, so the app must be able to request expansion (lazy
        // children arrive afterwards). Gating on kids.len() alone treated a
        // not-yet-loaded directory as a leaf, which made `images` in the demo
        // (kind "dir", children [], is_leaf false) un-expandable — Plan §5
        // requires those to raise a request rather than be treated as leaves.
        var is_dir_node bool = nd.kind == "dir"
        var has_kids bool = !leaf && (kids.len() > 0 || is_dir_node)
        var dis bool = tv_member(disabled, nd.id)
        var op bool = false
        if has_kids {
            if tv_member(expanded, nd.id) {
                op = true
            }
        }
        var ord int = reachable
        if !dis {
            reachable = reachable + 1
        }
        // `focus` is a ROW index (what tv_focus_id / tv_step_reachable use), not
        // a reachable-code ordinal: comparing it against `reachable` silently
        // disagreed whenever a disabled row preceded the focused one, so the
        // focus ring landed on the wrong row. Track the row index itself.
        var row_ix int = out.len()
        var sel bool = false
        if selected != "" {
            if selected == nd.id {
                sel = true
            }
        }
        var ic str = tv_row_icon(nd.icon, nd.label, nd.kind, has_kids, op, directory)
        // With a duplicate id present the tree is structurally invalid: emit the
        // row as non-actionable metadata instead of publishing a second
        // ambiguous target for the same id. The named error is raised
        // separately; this keeps "report, do not publish ambiguous rows" true
        // (review F-04, Plan §5).
        var dis_row bool = dis
        if dup {
            dis_row = true
        }
        out.push({ id: nd.id, label: nd.label, has_kids: has_kids, open: op, disabled: dis_row, selected: sel, focused: row_ix == focus, loading: tv_member(loading, nd.id), error: tv_member(error, nd.id), leaf: !has_kids, icon: ic, badge: nd.badge, depth: lvl })
        if op {
            var j int = kids.len()
            while j > 0 {
                j = j - 1
                var kid = kids[j]
                var kid_pair List = []
                kid_pair.push(kid)
                kid_pair.push(lvl + 1)
                seed.push(kid_pair)
            }
        }
    }
    // PLAN-085 T-05: an empty tree emits ONE sentinel row instead of relying on
    // a separate `is_empty` computed. On the VM track a computed over `.nodes`
    // (is_empty => tv_count_rows(...) == 0) stays stale after the app mutates
    // nodes — it never flips true even though `rows` re-derives correctly every
    // frame (measured: rows 2→0→2→0 while the empty branch never rendered).
    // Emitting the sentinel from the same function that produces `rows` keeps
    // the empty state on the one derivation path that is proven live.
    if out.len() == 0 {
        out.push({ id: "", label: "空树无可操作行", has_kids: false, open: false, disabled: true, selected: false, focused: false, loading: false, error: false, leaf: true, icon: "", badge: "", empty: true })
    }
    return out
}

/// 焦点序 → 节点 ID（越界/无行返回空串，调用方不得据此发空 ID 回调）。
pub fn tv_focus_id(rows List, index int) str {
    if index < 0 {
        return ""
    }
    if index >= rows.len() {
        return ""
    }
    return rows[index].id
}

/// 展开状态下当前焦点节点的可见父节点 ID（无父/父不可见返回空串）。
/// 左键折叠或上移到父行由调用方按自己语义选择，这里只给可见祖先。
pub fn tv_visible_parent(nodes List, expanded List, target str) str {
    var parent str = ""
    var found bool = false
    var stack List = []
    var parents List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        stack.push(nodes[i])
        parents.push("")
    }
    while stack.len() > 0 {
        var top int = stack.len() - 1
        var nd = stack[top]
        var par str = parents[top]
        stack.pop()
        parents.pop()
        if nd.id == target {
            parent = par
            found = true
        }
        if tv_member(expanded, nd.id) {
            var kids List = nd.children
            var j int = kids.len()
            while j > 0 {
                j = j - 1
                stack.push(kids[j])
                parents.push(nd.id)
            }
        }
    }
    if !found {
        return ""
    }
    return parent
}


/// 结构父节点 ID（无论父节点当前是否展开）。
///
/// 与 `tv_visible_parent` 的区别：后者只沿**已展开**分支下钻，用于「左键回到
/// 可见祖先」；本函数无条件下钻整棵树，用于**焦点修复**——父节点折叠后，被聚焦
/// 的子节点已不在 expanded 集合里，若仍走可见祖先就会找不到 target 并返回空串，
/// 使修复静默失效（re-review F-05 实测）。
pub fn tv_struct_parent(nodes List, target str) str {
    var parent str = ""
    var found bool = false
    var stack List = []
    var parents List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        stack.push(nodes[i])
        parents.push("")
    }
    while stack.len() > 0 {
        var top int = stack.len() - 1
        var nd = stack[top]
        var par str = parents[top]
        stack.pop()
        parents.pop()
        if nd.id == target {
            parent = par
            found = true
        }
        var kids List = nd.children
        var j int = kids.len()
        while j > 0 {
            j = j - 1
            stack.push(kids[j])
            parents.push(nd.id)
        }
    }
    if !found {
        return ""
    }
    return parent
}
/// 焦点修复：当前焦点 ID 仍可见则保留其序号；否则回落到最近可用可见祖先，
/// 再否则首个可用行；无可用行返回 0。绝不改业务 `selected`。
pub fn tv_repair_focus(rows List, nodes List, expanded List, focus_id str, fallback int) int {
    // Resolve by ID first: an index captured on an earlier frame is stale after
    // any insertion, removal or collapse. This is what makes focus survive
    // data updates instead of silently pointing at a different row.
    var i int = 0
    while i < rows.len() {
        var r = rows[i]
        if !r.disabled {
            if r.id == focus_id {
                return i
            }
        }
        i = i + 1
    }
    // The focused node is gone (removed, filtered out, or its subtree collapsed):
    // fall back to the nearest still-visible ancestor so focus does not jump to
    // an unrelated row.
    // Structural parent, NOT `tv_visible_parent`: after a collapse the focused
    // child is gone from `expanded`, so the visibility-filtered walk cannot find
    // it and the repair would silently do nothing (re-review F-05).
    var anc str = tv_struct_parent(nodes, focus_id)
    if anc != "" {
        var j int = 0
        while j < rows.len() {
            var rj = rows[j]
            if !rj.disabled {
                if rj.id == anc {
                    return j
                }
            }
            j = j + 1
        }
    }
    // Otherwise the previous index if it still exists, else the first reachable
    // row, else 0 (no reachable row at all).
    if fallback >= 0 {
        if fallback < rows.len() {
            var rf = rows[fallback]
            if !rf.disabled {
                return fallback
            }
        }
    }
    var k int = 0
    while k < rows.len() {
        var rk = rows[k]
        if !rk.disabled {
            return k
        }
        k = k + 1
    }
    return 0
}

/// 首/末可用行的键盘序号（无可用行返回 -1）。
pub fn tv_first_reachable(rows List) int {
    var i int = 0
    while i < rows.len() {
        if !rows[i].disabled {
            return i
        }
        i = i + 1
    }
    return -1
}

pub fn tv_last_reachable(rows List) int {
    var i int = rows.len() - 1
    while i >= 0 {
        if !rows[i].disabled {
            return i
        }
        i = i - 1
    }
    return -1
}

/// 下一个可用行序号（方向 +1/-1，到边界返回原序号 = 不动）。
pub fn tv_step_reachable(rows List, from int, forward bool) int {
    var n int = rows.len()
    if n == 0 {
        return 0
    }
    var i int = from
    if forward {
        i = i + 1
        while i < n {
            if !rows[i].disabled {
                return i
            }
            i = i + 1
        }
        return from
    }
    i = i - 1
    while i >= 0 {
        if !rows[i].disabled {
            return i
        }
        i = i - 1
    }
    return from
}