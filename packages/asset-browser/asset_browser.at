// packages/asset-browser/asset_browser.at — AssetBrowser 正式组件（PLAN-091）。
//
// 应用内授权资源库的浏览面：分类（TreeView/085 薄适配）、搜索、类型过滤、
// 分页（PaginationControl/086）、grid/list 视图、单选、预览请求。组件不持
// 第二份数据、不切片、不发业务请求：records/total/query 全部由应用受控发布，
// 组件只投影并发上行请求（r2 冻结合同）。
//
// 事件契约（r2，带引号 msg 变体；消费方 onqueryRequested: .X($event) 接法）：
// - "queryRequested"(str)：`{"seq":N,"baseRevision":R,"query":{folderId,text,
//   kind,page,pageSize}}`。seq 为本实例递增；应用接受请求后发布新 query
//   （含调用方分配的 id）并回灌 querySeq=seq；完成时发布 resultQueryId=
//   query.id 与 records/total、loading=false。
// - "selectionRequested"(str)：`{"queryId":…,"id":…,"revision":…,"label":…}`
//   或明确清空 `{"queryId":…,"clear":true}`。组件不持业务选择。
// - "previewRequested"(str)：`{"id":…,"revision":…,"label":…,"kind":…,
//   "src":…}`（src 为既有授权媒体 URI；组件不持字节、不做文件 IO）。
//
// 数据可信（可确认）条件：resultQueryId == query.id 且最后请求已反馈
// （querySeq == last_emitted_seq）且无 errorMessage 且记录结构合法。请求失败
// 保留上一有效结果但显式标过期，不伪装空库（r2）。locked（AssetPicker 确认
// pending）时禁用查询/选择变更——功能性拦截在 handler 内 + 容器弱化/状态行
// 文字；普通按钮走 disabled。
//
// 结果区由 CollectionView 渲染。查询、旧公开载荷和预览留在本组件，
// CollectionView 的条目请求须先按当前 query / revision 验证。
use auto.json
use asset_browser_util: ab_check_records, ab_adapt_folders, ab_top_ids, ab_find_index, ab_collection_items

widget AssetBrowser (records: List = [], folders: List = [], query: str = "", querySeq: int = 0, resultQueryId: str = "", total: int = 0, selection: str = "", revision: int = 0, loading: bool = false, errorMessage: str = "", viewMode: str = "grid", locked: bool = false) {
    use { package: tree_view from "../tree-view" }
    use { package: pagination from "../pagination" }
    use { package: image_viewer from "../image-viewer" }
    use { package: collection_view from "../collection-view" }
    msg {
        Init, Tick,
        SearchInput(str), DoSearch, SetKind(str), CollectionMode(str),
        FoldToggle(str), FoldSelect(str), PageChanged(str),
        CollectionSelect(str), CollectionAction(str), CardSelect(str), CardPreview(str),
        "queryRequested"(str), "selectionRequested"(str), "previewRequested"(str)
    }
    model {
        var interval int = 500
        // ---- query 镜像（Tick 按原串快照增量重解析）----
        var q_raw str = ""
        var q_id str = ""
        var q_folder str = ""
        var q_text str = ""
        var q_kind str = ""
        var q_page int = 1
        var q_pageSize int = 50
        var q_error str = ""
        // ---- 搜索草稿（Enter/按钮提交，无隐藏 debounce）----
        var search_draft str = ""
        // ---- 分类树局部展开（呈现态；分类选择仍走应用受控 query）----
        var fold_expanded = []
        // ---- 视图形态镜像（受控 prop + 本地切换投影）----
        var vm str = "grid"
        var view_prop str = "grid"
        // ---- 请求代次（本实例递增；baseRevision 取受控 revision）----
        var last_emitted_seq int = 0
        // ---- selection 镜像 ----
        var sel_id str = ""
        var sel_label str = ""
        var sel_rev str = ""
        var rec_error_state str = ""
        var pv_open bool = false
        var pv_src str = ""
        var pv_id str = ""
        var pv_rev str = ""
        var pv_label str = ""
        var pv_events int = 0
    }
    computed {
        // 平铺无互引（PLAN-536 T3 / PLAN-086 实证纪律）。
        folder_nodes => ab_adapt_folders(.folders)
        collection_items => ab_collection_items(.records)
        provider_error => if .errorMessage != "" { true } else { false }
        // 数据可信：结果 id 匹配当前 query 且最后请求已反馈且无错误。
        data_current => if .q_error != "" { false } else if .q_id == "" { false } else if .resultQueryId != .q_id { false } else if .querySeq != .last_emitted_seq { false } else if .errorMessage != "" { false } else { true }
        // 结果过期：已有结果属于旧 query（区别于首次加载的空白）。
        result_stale => if .q_error != "" { false } else if .q_id == "" { false } else if .resultQueryId == "" { false } else if .resultQueryId != .q_id { true } else { false }
        // 请求待反馈：已发出但应用尚未回灌 querySeq。
        request_pending => if .last_emitted_seq == 0 { false } else if .querySeq != .last_emitted_seq { true } else { false }
        has_filter => if .q_text != "" { true } else if .q_kind != "" { true } else if .q_folder != "" { true } else { false }
        empty_label => if .loading { "加载中…" } else { if .q_text != "" { "无匹配资源" } else { if .q_kind != "" { "无匹配资源" } else { if .q_folder != "" { "无匹配资源" } else { "资源库为空" } } } }
        empty_hint => if .loading { "" } else { if .q_text != "" { "试着调整搜索关键字或过滤条件" } else { "该分类下暂无可用资源" } }
    }
    view {
        col (class: "w-full h-full min-h-0 overflow-hidden flex flex-col bg-background text-foreground", onkeydown.escape: .KEscape) {
            // ---- 工具行：搜索 / 类型过滤 / 视图切换 ----
            row (style: "h-12 shrink-0 items-center gap-2 px-3 border-b border-border") {
                input {
                    value: .search_draft
                    oninput: .SearchInput
                    onchange: .SearchInput
                    onenter: .DoSearch
                    placeholder: "搜索资源…"
                    disabled: .locked
                    style: "w-44 h-8 text-xs px-2 bg-background border border-border rounded-md outline-none placeholder:text-muted-foreground focus:border-primary"
                }
                button (text: "搜索", title: "执行搜索", onclick: .DoSearch, disabled: .locked, style: "h-8 px-2 text-xs rounded-md border border-border hover:bg-muted disabled:opacity-40") {}
                row (style: "items-center gap-1 ml-2") {
                    if .q_kind == "" {
                        button (text: "全部", title: "全部类型", onclick: .SetKind(""), disabled: .locked, style: "h-7 px-2 text-xs rounded-md bg-background text-foreground font-semibold border border-border shadow-sm") {}
                    } else {
                        button (text: "全部", title: "全部类型", onclick: .SetKind(""), disabled: .locked, style: "h-7 px-2 text-xs rounded-md text-muted-foreground hover:text-foreground") {}
                    }
                    if .q_kind == "image" {
                        button (text: "图片", title: "图片类型", onclick: .SetKind("image"), disabled: .locked, style: "h-7 px-2 text-xs rounded-md bg-background text-foreground font-semibold border border-border shadow-sm") {}
                    } else {
                        button (text: "图片", title: "图片类型", onclick: .SetKind("image"), disabled: .locked, style: "h-7 px-2 text-xs rounded-md text-muted-foreground hover:text-foreground") {}
                    }
                    if .q_kind == "file" {
                        button (text: "文件", title: "文件类型", onclick: .SetKind("file"), disabled: .locked, style: "h-7 px-2 text-xs rounded-md bg-background text-foreground font-semibold border border-border shadow-sm") {}
                    } else {
                        button (text: "文件", title: "文件类型", onclick: .SetKind("file"), disabled: .locked, style: "h-7 px-2 text-xs rounded-md text-muted-foreground hover:text-foreground") {}
                    }
                }
            }
            // ---- 主体：预览面板或（分类侧栏 + 结果区）----
            if .pv_open {
                col (style: "flex-1 min-h-0 w-full flex flex-col") {
                    row (style: "h-10 shrink-0 items-center justify-between px-3 border-b border-border") {
                        text .pv_label { style: "text-xs font-medium truncate" }
                        button (text: "关闭预览", title: "关闭预览", onclick: .ClosePreview, style: "h-7 px-2 text-xs rounded-md border border-border text-muted-foreground hover:text-foreground") {}
                    }
                    col (style: "flex-1 min-h-0 p-2") {
                        ImageViewport (
                            src: .pv_src,
                            alt: .pv_label,
                            resourceId: .pv_id,
                            resourceRevision: .pv_rev,
                            onloaded: .PvEvent($event),
                            onerror: .PvEvent($event)
                        ) {}
                    }
                }
            } else {
            row (style: "flex-1 min-h-0 w-full") {
                col (style: "w-40 shrink-0 h-full border-r border-border overflow-y-auto p-2") {
                    TreeView (nodes: .folder_nodes, expanded: .fold_expanded, selected: .q_folder, on_toggle: .FoldToggle($event), on_select: .FoldSelect($event)) {}
                }
                col (style: "flex-1 min-w-0 min-h-0 h-full flex flex-col") {
                    // ---- 状态行：计数 / loading / 待反馈 / 过期 / 错误 / 选择摘要 ----
                    row (style: "h-8 shrink-0 items-center gap-3 px-3 border-b border-border/60 text-xs") {
                        if .total <= 0 {
                            text "0 项" { style: "text-muted-foreground whitespace-nowrap" }
                        } else {
                            text f"共 ${.total} 项" { style: "text-muted-foreground whitespace-nowrap" }
                        }
                        if .loading {
                            text "加载中…" { style: "text-muted-foreground whitespace-nowrap" }
                        }
                        if .request_pending {
                            if !.loading {
                                text "请求处理中…" { style: "text-muted-foreground whitespace-nowrap" }
                            }
                        }
                        if .result_stale {
                            text "结果已过期" { style: "text-amber-600 whitespace-nowrap" }
                        }
                        if .provider_error {
                            text .errorMessage { style: "text-destructive break-all" }
                        }
                        if .locked {
                            text "选择已锁定（确认处理中）" { style: "text-muted-foreground whitespace-nowrap" }
                        }
                        if .sel_id != "" {
                            text f"已选: ${.sel_label} (${.sel_id} @ ${.sel_rev})" { style: "ml-auto text-foreground truncate max-w-60" }
                        } else {
                            text "未选择" { style: "ml-auto text-muted-foreground" }
                        }
                    }
                    col (style: "flex-1 min-h-0 min-w-0 overflow-hidden") {
                        if .rec_error_state != "" {
                            if .rec_error_state == "<empty-id>" {
                                text "asset-browser: 记录结构非法（存在空 id）" { style: "text-xs text-destructive" }
                            } else if .rec_error_state == "<no-revision>" {
                                text "asset-browser: 记录结构非法（存在空 revision）" { style: "text-xs text-destructive" }
                            } else {
                                text f"asset-browser: 重复记录 ID ${.rec_error_state}" { style: "text-xs text-destructive" }
                            }
                        } else if .q_error != "" {
                            text .q_error { style: "text-xs text-destructive" }
                        } else {
                            CollectionView (
                                items: .collection_items, viewMode: .vm, selectedId: .sel_id,
                                scopeId: .q_id, revision: .revision,
                                disabled: .locked || !.data_current || .loading,
                                emptyLabel: .empty_label,
                                onviewModeRequested: .CollectionMode($event),
                                onselectionRequested: .CollectionSelect($event),
                                onitemActionRequested: .CollectionAction($event)
                            ) {}
                            if .records.len() == 0 && !.loading {
                                text .empty_hint { style: "px-3 pb-2 text-xs text-muted-foreground" }
                            }
                        }
                    }
                    // ---- 分页 ----
                    row (style: "h-10 shrink-0 items-center justify-center border-t border-border/60") {
                        PaginationControl (page: .q_page, pageSize: .q_pageSize, total: .total, showPageSize: true, hideWhenSingle: false, disabled: .locked, onchanged: .PageChanged($event)) {}
                    }
                }
            }
            }
        }
    }
    on {
        .Init -> {
            .fold_expanded = ab_top_ids(.folders)
            .q_raw = .query
            try {
                let q = json.parse(.query)
                .q_id = q.id ?? ""
                .q_folder = q.folderId ?? ""
                .q_text = q.text ?? ""
                .q_kind = q.kind ?? ""
                .q_page = q.page ?? 1
                .q_pageSize = q.pageSize ?? 50
                .q_error = ""
                .search_draft = q.text ?? ""
            } catch {
                .q_error = "asset-browser: query 解析失败（invalid_query）"
            }
            .vm = .viewMode
            .view_prop = .viewMode
            .rec_error_state = ab_check_records(.records)
        }
        .Tick -> {
            .rec_error_state = ab_check_records(.records)
            if .q_raw != .query {
                .q_raw = .query
                try {
                    let q = json.parse(.query)
                    .q_id = q.id ?? ""
                    .q_folder = q.folderId ?? ""
                    .q_text = q.text ?? ""
                    .q_kind = q.kind ?? ""
                    .q_page = q.page ?? 1
                    .q_pageSize = q.pageSize ?? 50
                    .q_error = ""
                    .search_draft = q.text ?? ""
                } catch {
                    .q_error = "asset-browser: query 解析失败（invalid_query）"
                }
            }
            if .view_prop != .viewMode {
                .view_prop = .viewMode
                .vm = .viewMode
            }
            if .selection == "" {
                .sel_id = ""
                .sel_label = ""
                .sel_rev = ""
            } else {
                try {
                    let s = json.parse(.selection)
                    .sel_id = s.id ?? ""
                    .sel_label = s.label ?? ""
                    .sel_rev = s.revision ?? ""
                } catch {
                    .sel_id = ""
                    .sel_label = ""
                    .sel_rev = ""
                }
            }
        }
        // ---- 搜索：Enter/按钮提交；类型/分类/分页立即发（无隐藏 debounce）----
        .SearchInput(v str) -> {
            .search_draft = v
        }
        .DoSearch -> {
            if !.locked {
                .last_emitted_seq = .last_emitted_seq + 1
                try {
                    ."queryRequested"(json.stringify({seq: .last_emitted_seq, baseRevision: .revision, query: {folderId: .q_folder, text: .search_draft, kind: .q_kind, page: 1, pageSize: .q_pageSize}}))
                } catch {
                }
            }
        }
        .SetKind(k str) -> {
            if !.locked {
                if k != .q_kind {
                    .last_emitted_seq = .last_emitted_seq + 1
                    try {
                        ."queryRequested"(json.stringify({seq: .last_emitted_seq, baseRevision: .revision, query: {folderId: .q_folder, text: .q_text, kind: k, page: 1, pageSize: .q_pageSize}}))
                    } catch {
                    }
                }
            }
        }
        .FoldSelect(id str) -> {
            if !.locked {
                if id != .q_folder {
                    .last_emitted_seq = .last_emitted_seq + 1
                    try {
                        ."queryRequested"(json.stringify({seq: .last_emitted_seq, baseRevision: .revision, query: {folderId: id, text: .q_text, kind: .q_kind, page: 1, pageSize: .q_pageSize}}))
                    } catch {
                    }
                }
            }
        }
        .PageChanged(ev str) -> {
            if !.locked {
                try {
                    let p = json.parse(ev)
                    .last_emitted_seq = .last_emitted_seq + 1
                    ."queryRequested"(json.stringify({seq: .last_emitted_seq, baseRevision: .revision, query: {folderId: .q_folder, text: .q_text, kind: .q_kind, page: p.page, pageSize: p.pageSize}}))
                } catch {
                }
            }
        }
        .FoldToggle(id str) -> {
            // 局部展开/折叠（呈现态）：重建列表（.at 无按下标写）。
            var next List = []
            var had bool = false
            var i int = 0
            while i < .fold_expanded.len() {
                if .fold_expanded[i] == id {
                    had = true
                } else {
                    next.push(.fold_expanded[i])
                }
                i = i + 1
            }
            if !had {
                next.push(id)
            }
            .fold_expanded = next
        }
        .CollectionMode(payload str) -> {
            try {
                let request = json.parse(payload)
                if !.locked && request.instanceToken != "" && request.scopeId == .q_id && request.baseRevision == .revision {
                    if request.viewMode == "grid" || request.viewMode == "list" { .vm = request.viewMode }
                }
            } catch {}
        }
        .CollectionSelect(payload str) -> {
            try {
                let request = json.parse(payload)
                if !.locked && !.loading && .q_id != "" && .q_id == .resultQueryId && .querySeq == .last_emitted_seq && .errorMessage == "" && request.scopeId == .q_id && request.baseRevision == .revision && request.instanceToken != "" && ab_check_records(.records) == "" {
                    let index = ab_find_index(.records, request.id)
                    if index >= 0 && .records[index].revision == request.itemRevision {
                        .CardSelect(request.id)
                    }
                }
            } catch {}
        }
        .CollectionAction(payload str) -> {
            try {
                let request = json.parse(payload)
                if !.locked && !.loading && .q_id != "" && .q_id == .resultQueryId && .querySeq == .last_emitted_seq && .errorMessage == "" && request.scopeId == .q_id && request.baseRevision == .revision && request.instanceToken != "" && ab_check_records(.records) == "" {
                    let index = ab_find_index(.records, request.id)
                    if index >= 0 && .records[index].revision == request.itemRevision && request.actionId == "preview" {
                        .CardPreview(request.id)
                    }
                }
            } catch {}
        }

        // 继续使用 091 的选择和预览载荷。
        .CardSelect(id str) -> {
            var idx int = ab_find_index(.records, id)
            if !.locked {
                if idx >= 0 {
                    if id != .sel_id {
                        try {
                            let r = .records[idx]
                            ."selectionRequested"(json.stringify({queryId: .q_id, id: r.id, revision: r.revision, label: r.label}))
                        } catch {
                        }
                    }
                }
            }
        }
        .CardPreview(id str) -> {
            if !.locked {
                var idx int = ab_find_index(.records, id)
                if idx >= 0 {
                    let r = .records[idx]
                    if r.kind == "image" {
                        if r.thumbnailUri != "" {
                            .pv_src = r.thumbnailUri
                            .pv_id = r.id
                            .pv_rev = r.revision
                            .pv_label = r.label
                            .pv_open = true
                            try {
                                ."previewRequested"(json.stringify({id: r.id, revision: r.revision, label: r.label, kind: r.kind, src: r.thumbnailUri}))
                            } catch {
                            }
                        }
                    }
                }
            }
        }
        .ClosePreview -> {
            .pv_open = false
        }
        .PvEvent(ev str) -> {
            .pv_events = .pv_events + 1
        }
        .KEscape -> {
            if .pv_open {
                .pv_open = false
            }
        }
    }
}
