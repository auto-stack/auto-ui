// packages/asset-browser/asset_kind_icon.at — KindIcon 有界图标调色板
// （PLAN-091）。单文件单 widget（PLAN-614：auto run 增量路径对多-widget .at
// 会把同一份代码写到每个 widget 名下）。
//
// Vue 轨 `icon` 只发射**字面量名**（动态名落 Circle 占位，PLAN-085 同款），
// 因此按 name 分支发射真 lucide 组件；VM 轨按名渲染。调色板外名字渲染为空。
// image / folder / file-text 均在 085 TreeIcon 已验证调色板内。
widget KindIcon (name: str = "") {
    view {
        if .name == "image" {
            icon (name: "image", style: "w-5 h-5 shrink-0 text-muted-foreground") {}
        } else {
            if .name == "folder" {
                icon (name: "folder", style: "w-5 h-5 shrink-0 text-muted-foreground") {}
            } else {
                if .name == "file-text" {
                    icon (name: "file-text", style: "w-5 h-5 shrink-0 text-muted-foreground") {}
                } else {
                    if .name == "file" {
                        icon (name: "file", style: "w-5 h-5 shrink-0 text-muted-foreground") {}
                    } else {
                        if .name == "eye" {
                            icon (name: "eye", style: "w-4 h-4 shrink-0 text-muted-foreground") {}
                        }
                    }
                }
            }
        }
    }
}
