// packages/asset-browser/asset_browser_util.at — AssetBrowser 纯派生函数
// （PLAN-091 T-02）。
//
// ⚠ VM 轨遍历纪律（PLAN-614/PLAN-085 实证，本包沿用）：`for-in` 对函数参数
// 列表迭代零次，因此所有列表遍历一律 `while` + 索引。
//
// ⚠ 包内模块文件不会被自动导入：使用方必须显式
// `use asset_browser_util: <fn…>`；漏写时 `computed => fn(...)` 静默产出空
// 列表且无诊断（PLAN-085 T-01 实测，同族约束）。
//
// 记录 schema（r2 冻结，provider 全键提供；VM Obj 形状锁定——缺键字段访问是
// 硬错，与 085 树节点同约束）：
// { id: str, revision: str, label: str, kind: str, thumbnailUri: str,
//   resourceRef: str }
// folders schema（r2：沿 085 嵌套形状，薄适配为 TreeView 全键节点）：
// { id: str, label: str, children: List }

/// 记录结构校验："" = 合法；"<empty-id>" = 存在空 id；"<no-revision>" =
/// 存在空 revision；其余返回值 = 首个重复 id（子串 token 法，PLAN-085 同款：
/// 起始 ""、`!`→`!0` 先于 `|`→`!1` 的单射转义、空 id 不入 token 流）。
pub fn ab_check_records(records List) str {
    var seen str = ""
    var i int = 0
    while i < records.len() {
        let r = records[i]
        if r.id == "" {
            return "<empty-id>"
        }
        if r.revision == "" {
            return "<no-revision>"
        }
        var esc str = r.id.replace("!", "!0").replace("|", "!1")
        var token str = "|" + esc + "|"
        if seen.contains(token) {
            return r.id
        }
        seen = seen + token
        i = i + 1
    }
    return ""
}

/// folders（{id,label,children}）→ TreeView 全键节点薄适配。
/// kind/icon/is_leaf/badge 由适配补默认；不另造磁盘目录模型。
pub fn ab_adapt_folders(folders List) List {
    var out List = []
    var i int = 0
    while i < folders.len() {
        let nd = folders[i]
        out.push({
            id: nd.id,
            label: nd.label,
            children: ab_adapt_folders(nd.children),
            kind: "dir",
            icon: "folder",
            is_leaf: false,
            badge: ""
        })
        i = i + 1
    }
    return out
}

/// 顶层分类 id 列表（Init 默认展开用）。
pub fn ab_top_ids(folders List) List {
    var out List = []
    var i int = 0
    while i < folders.len() {
        out.push(folders[i].id)
        i = i + 1
    }
    return out
}

/// 按 id 精确查找记录下标；未命中 -1。
pub fn ab_find_index(records List, id str) int {
    var i int = 0
    while i < records.len() {
        if records[i].id == id {
            return i
        }
        i = i + 1
    }
    return -1
}

/// 类型 → 有界图标名（字面量分支消费，vue 轨动态名落占位）。
/// image → image；folder → folder；其余（普通附件）→ file-text。
pub fn ab_kind_icon(kind str) str {
    if kind == "image" {
        return "image"
    }
    if kind == "folder" {
        return "folder"
    }
    return "file-text"
}

/// 将授权记录投影成 CollectionView 条目。可预览性由 091 的授权 URI 决定，
/// 与缩略图是否成功渲染分开。
pub fn ab_collection_items(records List) List {
    var result List = []
    var i int = 0
    while i < records.len() {
        let record = records[i]
        var actions List = []
        if record.kind == "image" && record.thumbnailUri != "" {
            actions.push({id: "preview", label: "预览", enabled: true})
        }
        result.push({
            id: record.id, itemRevision: record.revision, label: record.label,
            kind: record.kind, icon: ab_kind_icon(record.kind), thumbnailUri: record.thumbnailUri,
            thumbnailState: if record.thumbnailUri != "" { "ready" } else { "missing" },
            cells: [], actions: actions, defaultActionId: "", disabled: false
        })
        i = i + 1
    }
    return result
}
