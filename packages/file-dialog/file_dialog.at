use auto.json

// T-01 executable feasibility slice. The complete public selection contract
// is implemented after the package / provider / owner callback path is proven.
widget FileDialog (open: bool = false, title: str = "选择文件", initialDirectory: str = "") {
    msg { Tick, SetPath(str), Go, Enter(str), Choose(str), Confirm, Cancel, accepted(str), cancelled }
    model {
        var interval int = 50
        var fd_active bool = false
        var fd_request int = 0
        var fd_path str = ""
        var fd_reply str = ""
        var last_reply str = ""
        var seen_open bool = false
        var pathInput str = ""
        var currentDirectory str = ""
        var entries = []
        var selectedPath str = ""
        var error str = ""
        var loading bool = false
    }
    view {
        dialog (open: .fd_active) {
            dialog-content {
                dialog-header { dialog-title .title }
                col (style: "gap-2 w-full") {
                    input (value: .pathInput, oninput: .SetPath, onenter: .Go, placeholder: "目录路径") {}
                    button "转到" { onclick: .Go }
                    text .currentDirectory
                    if .loading { text "载入中" }
                    if .error != "" { text .error }
                    col (style: "h-64 overflow-y-auto gap-1") {
                        for entry in .entries {
                            if entry.is_dir {
                                button (onclick: .Enter(entry.path)) { text f"进入 ${entry.name}" }
                            } else {
                                row (style: "gap-2 items-center") {
                                    checkbox (checked: .selectedPath == entry.path, onclick: .Choose(entry.path)) {}
                                    text entry.name
                                }
                            }
                        }
                    }
                    text .selectedPath
                }
                dialog-footer {
                    button "取消" { onclick: .Cancel }
                    button "打开" { onclick: .Confirm, disabled: .selectedPath == "" }
                }
            }
        }
    }
    on {
        .Tick -> {
            if .open && !.seen_open {
                .fd_active = true
                .fd_path = .initialDirectory
                .pathInput = .initialDirectory
                .fd_request = .fd_request + 1
                .loading = true
            }
            .seen_open = .open
            if !.open { .fd_active = false }
            if .fd_reply != "" && .fd_reply != .last_reply {
                .last_reply = .fd_reply
                let response = json.parse(.fd_reply)
                if response.generation == .fd_request && .fd_active {
                    .loading = false
                    if !response.ok {
                        .error = response.error.message
                    } else {
                        .currentDirectory = response.listing.directory
                        .pathInput = .currentDirectory
                        .entries = response.listing.entries
                        .error = ""
                        .selectedPath = ""
                    }
                }
            }
        }
        .SetPath(value str) -> { .pathInput = value }
        .Go -> {
            .fd_path = .pathInput
            .fd_request = .fd_request + 1
            .loading = true
        }
        .Enter(path str) -> {
            .fd_path = path
            .fd_request = .fd_request + 1
            .loading = true
        }
        .Choose(path str) -> { .selectedPath = path }
        .Confirm -> {
            if .selectedPath != "" && .fd_active {
                .fd_active = false
                ."accepted"(.selectedPath)
            }
        }
        .Cancel -> {
            if .fd_active {
                .fd_active = false
                ."cancelled"()
            }
        }
    }
}
