use auto.json

widget App {
    use { package: command_palette from "../../../../../../packages/command-palette" }

    msg { Init, Open, OpenInvalid, RepairConfig, ConfigError(str), Query(str), Publish(str, bool), Complete,
        Run(str), FinishRun, ApplyRun(str), Commit(str), Close(str), Exit }

    model {
        var shown bool = false
        var runtime_track str = ""
        var instance_token str = ""
        var reply str = ""
        var session int = 0
        var sequence int = 0
        var query str = ""
        var latest str = ""
        var previous str = ""
        var revision int = 0
        var broken bool = false
        var errors int = 0
        var diagnostic str = ""
        var first_a str = ""
        var waiting str = ""
        var settling bool = false
        var result_ready_at int = 0
        var running bool = false
        var stale_during_run bool = false
        var run_ready_at int = 0
        var run_request str = ""
        var invocations int = 0
        var applied int = 0
        var command str = ""
        var offered List = []
        var fixed List = [
            {id: "one", label: "First result", groupId: "a", groupLabel: "Appearance", keywords: [], disabled: false, shortcut: "", icon: ""},
            {id: "two", label: "Middle result", groupId: "b", groupLabel: "Settings", keywords: [], disabled: false, shortcut: "", icon: ""},
            {id: "three", label: "Final result", groupId: "a", groupLabel: "Appearance", keywords: [], disabled: false, shortcut: "", icon: ""}
        ]
        var stale List = [
            {id: "stale", label: "Old result", groupId: "", groupLabel: "", keywords: [], disabled: false, shortcut: "", icon: ""}
        ]
    }

    timer {
        Complete (every_ms: 80, when: .settling)
        FinishRun (every_ms: 80, when: .running)
    }

    view {
        col (style: "p-4 gap-2") {
            button "Open provided palette" { onclick: .Open }
            button "Open invalid provided palette" { onclick: .OpenInvalid }
            text f"Provided commands applied: ${.applied}"
            text f"Provided invocation requests: ${.invocations}"
            text f"Configuration notifications: ${.errors}"
            if .diagnostic != "" { text .diagnostic }
            if .stale_during_run { text "Obsolete result published" }
            text .command
            if .runtime_track == "vm" { button "Exit example" { onclick: .Exit } }
            CommandPalette (open: .shown, title: "Provided commands", filterMode: "provided", wrapNavigation: true,
                commands: .offered, revision: .revision, resultsSession: .session,
                resultsQuerySeq: .sequence, resultsQuery: .query, response: .reply,
                onqueryChanged: .Query, oninvokeRequested: .Run, oncloseRequested: .Close,
                onerror: .ConfigError) {
                button "Repair configuration" { onclick: .RepairConfig }
            }
        }
    }

    on {
        .Init -> { .runtime_track = Env.track() }
        .Open -> { .shown = true }
        .OpenInvalid -> {
            .broken = true
            .offered = [.fixed[0], .fixed[0]]
            .shown = true
        }
        .RepairConfig -> {
            if .broken {
                .broken = false
                .Publish(.latest, false)
            }
        }
        .ConfigError(payload) -> {
            let error = json.parse(payload)
            .errors = .errors + 1
            .diagnostic = error.code
        }
        .Query(payload) -> {
            let request = json.parse(payload)
            .instance_token = request.instanceToken
            .previous = .latest
            .latest = payload
            .settling = false
            if .broken { return }
            if request.query == "A" && .first_a != "" {
                .waiting = payload
                .Publish(.first_a, true)
                .result_ready_at = Time.now_ms() + 1000
                .settling = true
            } else {
                .Publish(payload, false)
                if request.query == "A" { .first_a = payload }
            }
        }
        .Publish(payload, delayed) -> {
            let request = json.parse(payload)
            .session = request.session
            .sequence = request.querySeq
            .query = request.query
            .revision = .revision + 1
            if delayed { .offered = .stale } else { .offered = .fixed }
        }
        .Complete -> {
            if .settling && Time.now_ms() >= .result_ready_at {
                .settling = false
                .Publish(.waiting, false)
            }
        }
        .Run(payload) -> {
            let request = json.parse(payload)
            .invocations = .invocations + 1
            if .running || !.shown || request.instanceToken != .instance_token || request.session != .session ||
                request.querySeq != .sequence || request.query != .query || request.baseRevision != .revision { return }
            if request.commandId == "two" {
                .run_request = payload
                .run_ready_at = Time.now_ms() + 1300
                .running = true
                if request.query == "A" && .previous != "" {
                    .Publish(.previous, true)
                    .stale_during_run = true
                    .run_ready_at = Time.now_ms() + 1950
                }
            } else {
                .ApplyRun(payload)
            }
        }
        .FinishRun -> {
            if .running && Time.now_ms() >= .run_ready_at {
                .running = false
                if .stale_during_run {
                    let request = json.parse(.run_request)
                    let current = json.parse(.latest)
                    if .shown && request.instanceToken == current.instanceToken && request.session == current.session &&
                        request.querySeq == current.querySeq && request.query == current.query { .Commit(request.commandId) }
                } else {
                    .ApplyRun(.run_request)
                }
            }
        }
        .ApplyRun(payload) -> {
            let request = json.parse(payload)
            if .shown && request.instanceToken == .instance_token && request.session == .session &&
                request.querySeq == .sequence && request.query == .query && request.baseRevision == .revision {
                .Commit(request.commandId)
            }
        }
        .Commit(name) -> {
            .applied = .applied + 1
            .command = name
            .shown = false
        }
        .Close(payload) -> {
            let request = json.parse(payload)
            if request.instanceToken == .instance_token && request.session == .session {
                .shown = false
            }
        }
        .Exit -> { if Env.track() == "vm" { Process.exit(0) } }
    }
}
